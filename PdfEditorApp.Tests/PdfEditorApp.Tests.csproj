<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfEditorApp.Viewport\PdfEditorApp.Viewport.csproj" />
    <!--
      The Skia renderer is referenced by the TESTS only. The app does not
      reference it, so no Skia binary reaches the shipping output while parity
      is still being proved.
    -->
    <ProjectReference Include="..\PdfEditorApp.Rendering.Skia\PdfEditorApp.Rendering.Skia.csproj" />
  </ItemGroup>

  <!--
    The native core and a fixture, so the FFI boundary itself can be tested.

    This is the layer that had no test at all: the Rust side is covered by
    cargo, and the pure viewport logic is covered here, but the P/Invoke
    signatures and struct layouts BETWEEN them were only ever exercised by
    running the app. A mismatch there does not throw, it reads the wrong
    memory, and the process dies with a dialog and no stack. Testing it needs
    nothing more than the DLLs sitting next to the test assembly.
  -->
  <ItemGroup>
    <Content Include="..\render_core\target\release\render_core.dll"
             Condition="Exists('..\render_core\target\release\render_core.dll')">
      <Link>render_core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\render_core\vendor\pdfium\pdfium.dll"
             Condition="Exists('..\render_core\vendor\pdfium\pdfium.dll')">
      <Link>pdfium.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\render_core\tests\fixtures\sample_20pages.pdf"
             Condition="Exists('..\render_core\tests\fixtures\sample_20pages.pdf')">
      <Link>sample_20pages.pdf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Every field kind the Forms milestone finishes, with deliberately
      awkward on-state names (/On, /Red, /Green, /Blue) and /Opt in the
      [export display] pair form, so anything that assumes /Yes or writes
      the label instead of the export value fails here.
    -->
    <!--
      Ten headings, each drawn one glyph at a time in a different face, so a
      line here really is the many-piece kind a producer emits and not the
      single-object kind our own writers make. The block line writer is proved
      against it end to end.
    -->
    <!--
      One page carrying most of the routing table at once: four justified lines
      and a mixed-style one, which the app used to paint refused and never offer
      to any writer, next to an Arabic line and a rotated line, which stay
      refused. Ordinary ragged-right paragraphs sit between them as the control.
    -->
    <Content Include="..\render_core\tests\fixtures\sample_lines.pdf"
             Condition="Exists('..\render_core\tests\fixtures\sample_lines.pdf')">
      <Link>sample_lines.pdf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\render_core\tests\fixtures\sample_font_cases.pdf"
             Condition="Exists('..\render_core\tests\fixtures\sample_font_cases.pdf')">
      <Link>sample_font_cases.pdf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\render_core\tests\fixtures\sample_form_choice.pdf"
             Condition="Exists('..\render_core\tests\fixtures\sample_form_choice.pdf')">
      <Link>sample_form_choice.pdf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\render_core\tests\fixtures\sample_form_rich.pdf"
             Condition="Exists('..\render_core\tests\fixtures\sample_form_rich.pdf')">
      <Link>sample_form_rich.pdf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      A page with a red 18pt bold heading, 10pt body under it, and a style
      change with no line break across it. Generated by render_core's own tests
      and committed like the rest, so bookmarking by style can be proved
      end to end: real document, real core, real parser.
    -->
    <Content Include="..\render_core\tests\fixtures\sample_styled.pdf"
             Condition="Exists('..\render_core\tests\fixtures\sample_styled.pdf')">
      <Link>sample_styled.pdf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- One page, no text layer: what a scanned page looks like to the scan. -->
    <Content Include="..\render_core\tests\fixtures\blank.pdf"
             Condition="Exists('..\render_core\tests\fixtures\blank.pdf')">
      <Link>blank.pdf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>