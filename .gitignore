# Build output
bin/
obj/
publish/
dist/
target/

# Rust
render_core/target/

# Vendored native binary (7MB, re-downloadable from bblanchon/pdfium-binaries)
render_core/vendor/pdfium/pdfium.dll

burn*.log
diag.log

# Disposable installs used to verify the real installer payload, never the
# live installed copy.
testrun/

# The user's own stamp images, created beside the exe at runtime. Data, not
# source, and never part of the installer payload either.
Stamps/

# Intermediate from rc.exe when rebuilding the cursor resource DLL. The DLL
# itself IS checked in; this is just the step between.
PdfEditorApp/Assets/Cursors/cursors.res

# Built by the ignored scan_cost measurement, not a fixture any test asserts
# on. 380KB of filler text, regenerated on demand by the test that wants it.
render_core/tests/fixtures/.dense_timing.pdf

# Regenerated on demand by justified_embedded_fixture(). Excluded for two
# reasons: it is 1MB, an order of magnitude larger than every other fixture,
# and it is large because it EMBEDS A COMPLETE COPY OF C:\Windows\Fonts\arial.ttf.
# Checking that in would redistribute a licensed Microsoft font. The four small
# sibling fixtures embed no font program and are checked in normally.
render_core/tests/fixtures/sample_justified_embedded.pdf

# OCR models, fetched, hash-checked and converted by tools/ocr/fetch_ocr_models.py
# (about 35 MB, all re-downloadable). The licence texts beside them are checked in.
PdfEditorApp/Assets/Ocr/tessdata/
PdfEditorApp/Assets/Ocr/*.onnx
tools/ocr/__pycache__/
