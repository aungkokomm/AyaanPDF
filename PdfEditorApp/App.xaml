<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PdfEditorApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PdfEditorApp">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!--
                The surface the pages sit on. Named rather than inline so the
                Sepia and Dark blue themes can retint it: it is the largest
                area on screen and the one that decides whether long reading is
                comfortable.

                Deliberately dark by default in BOTH light and dark themes,
                because a white page has to sit on something clearly darker
                than itself to read as a sheet rather than as the background.
            -->
            <SolidColorBrush x:Key="AyaanCanvasBackgroundBrush" Color="#3A3A3D" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
