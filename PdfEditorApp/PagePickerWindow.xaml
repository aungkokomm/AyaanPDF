<?xml version="1.0" encoding="utf-8"?>
<!--
    Choosing pages out of one PDF by looking at them: Page > Insert > From file.

    A window, not a ContentDialog, for the reason BookmarkWindow gives: a
    dialog stops at 548 wide, and a grid of pages beside a large preview does
    not fit in that.
-->
<Window
    x:Class="PdfEditorApp.PagePickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:PdfEditorApp.ViewModels"
    Title="Choose pages">

    <Grid x:Name="Root" KeyDown="Root_KeyDown"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Quick choices, the typed page list, and the thumbnail size. -->
        <Grid Padding="16,12,16,12" ColumnSpacing="8"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="All" Click="SelectAll_Click" />
                <Button Content="None" Click="SelectNone_Click" />
                <Button Content="Odd" Click="SelectOdd_Click" />
                <Button Content="Even" Click="SelectEven_Click" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                <TextBlock Text="Pages" VerticalAlignment="Center" />
                <TextBox x:Name="PagesBox" Width="200" PlaceholderText="1-4, 7, 9"
                         AutomationProperties.Name="Pages to use"
                         KeyDown="PagesBox_KeyDown" LostFocus="PagesBox_LostFocus" />
                <TextBlock x:Name="PagesError" VerticalAlignment="Center" MaxWidth="360"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE91B;" FontSize="16" VerticalAlignment="Center" />
                <Slider x:Name="ThumbnailSize" Width="120" VerticalAlignment="Center"
                        Minimum="80" Maximum="240" Value="120" StepFrequency="10"
                        AutomationProperties.Name="Thumbnail size"
                        ValueChanged="ThumbnailSize_ValueChanged" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="320" />
                <ColumnDefinition Width="2*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!--
                Extended selection: click picks one page, Shift+click a range,
                Ctrl+click adds or drops a page. Thumbnails are drawn in
                ContainerContentChanging, only for pages on screen.
            -->
            <GridView x:Name="PageGrid" Padding="12" SelectionMode="Extended"
                      AutomationProperties.Name="Pages"
                      ContainerContentChanging="PageGrid_ContainerContentChanging"
                      SelectionChanged="PageGrid_SelectionChanged">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="136" ItemHeight="190" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:PickerPage">
                        <Grid Padding="6" RowSpacing="4" AutomationProperties.Name="{x:Bind AccessibleName}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Image Source="{x:Bind Bitmap, Mode=OneWay}" Stretch="Uniform" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="{x:Bind Label}" HorizontalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Grid x:Name="PreviewHost" Grid.Column="1" Padding="16" RowSpacing="8"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image x:Name="PreviewImage" Stretch="Uniform"
                       AutomationProperties.Name="Preview of the chosen page" />
                <TextBlock x:Name="PreviewCaption" Grid.Row="1" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Grid>

        <!-- Where the pages go, how many there are, and the two answers. -->
        <Grid Grid.Row="2" Padding="16,12,16,12" ColumnSpacing="10"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="PositionPanel" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Insert" VerticalAlignment="Center" />
                <ComboBox x:Name="PositionBox" MinWidth="230"
                          AutomationProperties.Name="Where to insert"
                          SelectionChanged="PositionBox_SelectionChanged" />
                <NumberBox x:Name="AfterPageBox" Width="120" Visibility="Collapsed"
                           Minimum="1" SpinButtonPlacementMode="Compact"
                           AutomationProperties.Name="After page number" />
            </StackPanel>

            <TextBlock x:Name="SelectedCount" Grid.Column="2" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="3" Content="Cancel" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" Grid.Column="4" Content="Insert pages"
                    Style="{StaticResource AccentButtonStyle}" Click="Confirm_Click" />
        </Grid>
    </Grid>
</Window>
