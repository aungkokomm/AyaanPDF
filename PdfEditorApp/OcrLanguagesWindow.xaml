<?xml version="1.0" encoding="utf-8"?>
<!--
    Recognition languages: downloads the Tesseract languages Recognize text
    can read beyond the three it ships with, and removes them again.

    A window rather than a dialog, like Recognize text itself, which opens it:
    a ContentDialog cannot sit over another window, and a download can take
    long enough that the reader wants to get on meanwhile. The downloads
    belong to OcrLanguageStore, not to this window, so closing it does not
    stop one.
-->
<Window
    x:Class="PdfEditorApp.OcrLanguagesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Recognition languages">

    <Grid x:Name="Root" KeyDown="Root_KeyDown"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Padding="24,20,24,12" Spacing="12">
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Download a language once and Recognize text can read it from then on. Each download is checked before it is kept." />
            <TextBox x:Name="SearchBox"
                     AutomationProperties.Name="Search languages"
                     PlaceholderText="Search, for example Tamil or தமிழ்"
                     TextChanged="SearchBox_TextChanged" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="Lists" Padding="24,0,24,20" Spacing="6" />
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="16,12,16,12" ColumnSpacing="10"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="UsageText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" Content="Close" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
