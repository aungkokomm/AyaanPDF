<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PdfEditorApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PdfEditorApp"
    xmlns:controls="using:PdfEditorApp.Controls"
    xmlns:rendering="using:PdfEditorApp.Rendering"
    xmlns:viewmodels="using:PdfEditorApp.ViewModels"
    xmlns:viewport="using:PdfEditorApp.Viewport"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Canvas-first shell.

        The document canvas fills the whole window and everything else FLOATS
        over it, rather than the canvas being a panel squeezed between a menu
        bar, a button strip and a status bar. Permanently visible chrome
        competes with the page for both attention and pixels; here the tools
        live in a narrow rail and a status pill that overlay the canvas, and
        the pages panel is hidden until asked for, so the page is the app.

        The canvas background is a flat neutral deliberately darker than the
        page, so a white sheet reads as an object sitting on a surface. That
        contrast is what makes it feel like a canvas rather than a borderless
        region of the window.
    -->
    <!-- KeyboardAcceleratorPlacementMode=Hidden: WinUI otherwise advertises an
         accelerator by floating a tooltip ("Ctrl+G") over its owner. On a menu
         item that is helpful; on this Grid, whose owner is the whole editor,
         it parks a label in the middle of the canvas on top of the user's
         drawing and stays there. The menu entries still show their shortcuts. -->
    <Page.Resources>
        <!--
            The bookmark ribbon, drawn rather than looked up.

            Segoe Fluent Icons has no bookmark glyph. E8A4, which this app used
            for the Bookmarks panel, is a BULLETED LIST, near enough identical
            to the list icon on the button beside it, so the panel and the
            "make bookmarks from headings" button looked like the same thing.

            A ring rather than a solid, to sit with the line-art icons around
            it, and F0 for the even-odd fill that makes the hole. PathIcon FILLS
            its geometry: an outline has to be described as one.

            ⚠️ Two things a PathIcon will not do for you, both of which this got
            wrong first time round:

              * It does NOT scale the geometry to the Width and Height given.
                Those CLIP it. So the path starts at 0,0 and the box it is given
                is a little larger than the path's own extent, rather than the
                other way about. The first version ran to x=17 in a 15-wide box
                and lost its right-hand edge.
              * Its wall is a real distance, not a stroke that thins with size.
                1.15 against a 15-tall glyph matches what Segoe Fluent draws at
                16px, checked side by side; the first version was half again as
                heavy as its neighbours.
        -->
        <x:String x:Key="BookmarkRibbonPath">F0 M0,0 L11,0 L11,15 L5.5,11 L0,15 Z M1.15,1.15 L9.85,1.15 L9.85,12.7 L5.5,9.55 L1.15,12.7 Z</x:String>

        <!-- The same ribbon, smaller, with a plus beside it. The plus is solid
             because it is a badge rather than an object, which is how Fluent
             draws its own. -->
        <x:String x:Key="BookmarkAddPath">F0 M0,0 L9,0 L9,13 L4.5,9.5 L0,13 Z M1.1,1.1 L7.9,1.1 L7.9,10.9 L4.5,8.2 L1.1,10.9 Z M13.4,3 L14.6,3 L14.6,5.9 L17.5,5.9 L17.5,7.1 L14.6,7.1 L14.6,10 L13.4,10 L13.4,7.1 L10.5,7.1 L10.5,5.9 L13.4,5.9 Z</x:String>

        <!--
            AN OPEN BOOK, for the Reading half of the mode control.

            Drawn rather than picked, because Segoe Fluent Icons has no plain
            open book: its whole private-use range was rendered and read, and
            the nearest are a shelf of spines (E8F1, which says "library", a
            collection of documents rather than the one on screen) and an open
            book wearing a graduation cap (F7DB, which says "course"). Neither
            says "read THIS", which is the one thing this button has to say.

            Same rules as the ribbon above: the box CLIPS rather than scales,
            so the path is authored at its final size and given a slightly
            roomier box; and the wall is a real distance, 0.97 against a 14-tall
            path, which was compared at five times magnification against the
            E932 glyph on the other half so the two do not read as one heavy
            icon beside one light one.
        -->
        <!--
            Continuous scrolling, for the page layout button: the tail of one
            page above a whole one. It replaces E81E, which is Fluent's "map
            layers" and read as layers. Drawn at 10 by 14 with a wall of 1, the
            size and weight of the single-page glyph (E7C3) it alternates with.
        -->
        <x:String x:Key="ContinuousPagesPath">F0 M0,0 L0,1.5 A1.5,1.5 0 0 0 1.5,3 L8.5,3 A1.5,1.5 0 0 0 10,1.5 L10,0 L9,0 L9,1.5 A0.5,0.5 0 0 1 8.5,2 L1.5,2 A0.5,0.5 0 0 1 1,1.5 L1,0 Z M1.5,5 L8.5,5 A1.5,1.5 0 0 1 10,6.5 L10,12.5 A1.5,1.5 0 0 1 8.5,14 L1.5,14 A1.5,1.5 0 0 1 0,12.5 L0,6.5 A1.5,1.5 0 0 1 1.5,5 Z M1.5,6 L8.5,6 A0.5,0.5 0 0 1 9,6.5 L9,12.5 A0.5,0.5 0 0 1 8.5,13 L1.5,13 A0.5,0.5 0 0 1 1,12.5 L1,6.5 A0.5,0.5 0 0 1 1.5,6 Z</x:String>

        <x:String x:Key="OpenBookPath">F0 M7.56,2.46 C5.54,0.88 2.9,0 0,0 L0,11.52 C2.9,11.52 5.54,12.4 7.56,13.98 Z M6.86,3.3 C5.1,2.15 2.9,1.36 0.97,1.05 L0.97,10.73 C2.99,11.03 5.1,11.82 6.86,12.97 Z M8.44,2.46 C10.46,0.88 13.1,0 16,0 L16,11.52 C13.1,11.52 10.46,12.4 8.44,13.98 Z M9.14,3.3 C10.9,2.15 13.1,1.36 15.03,1.05 L15.03,10.73 C13.01,11.03 10.9,11.82 9.14,12.97 Z</x:String>

        <!--
            Text that sits directly on the CANVAS, not on app chrome.

            These are fixed light values rather than ThemeResource, and that is
            deliberate. The canvas is dark in every theme by design, including
            the light ones: #3A3A3D in Light, #4E3F2A in Sepia, #252528 in Dark,
            #0F1A3C in Midnight, because a white page only reads as a sheet
            against something darker than itself. ThemeResource TextFillColor
            follows the APP theme, so in Light and Sepia it resolves to near
            black and puts dark text on a dark canvas. The welcome screen
            shipped exactly that way and was unreadable.

            Anything drawn on chrome (the rail, the property bar, dialogs) must
            keep using ThemeResource. These are only for the canvas.
        -->
        <SolidColorBrush x:Key="OnCanvasStrong" Color="#F4F6FA" />
        <SolidColorBrush x:Key="OnCanvasBody" Color="#C3C9D4" />
        <SolidColorBrush x:Key="OnCanvasMuted" Color="#8B93A1" />

        <!--
            The sheet the page bitmap is painted onto.

            A brush INSTANCE that night mode mutates, not a key that gets
            swapped. StaticResource resolves once when the template expands, so
            replacing the entry in this dictionary at runtime changes nothing,
            the same trap MainWindow.xaml documents for ThemeResource. Setting
            .Color on the resolved brush does propagate, to every page card at
            once, which is what is wanted here.

            It matters because the card is visible on its own: a slot releases
            its bitmap while re-rendering, and a white rectangle where a dark
            page should be is exactly the flash night mode is meant to remove.
        -->
        <SolidColorBrush x:Key="PageSheetBrush" Color="White" />
    </Page.Resources>

    <Grid x:Name="RootGrid" IsTabStop="True" KeyDown="RootGrid_KeyDown" KeyUp="RootGrid_KeyUp"
          CharacterReceived="RootGrid_CharacterReceived"
          KeyboardAcceleratorPlacementMode="Hidden">
        <!-- Ctrl chords are NOT declared as accelerators on this Grid, and the
             accelerators on the MenuFlyoutItems below are not what makes them
             fire. Those items live in a Button's MenuFlyout, so they are not in
             the visual tree until the flyout opens, and an accelerator on an
             unrealised element is not live. They are kept only because they are
             what renders "Ctrl+G" beside the menu entry.

             Every Ctrl chord that actually works from the canvas is a case in
             RootGrid_KeyDown. That is the single registration point; add new
             ones there. -->
        <!--
            The canvas surface. A fixed neutral grey rather than a theme
            brush: theme surface colours are near-white in light mode, so a
            white page on one is invisible as an object. The page needs to sit
            on something clearly darker than itself in BOTH themes, which is
            exactly the case for not deferring to the theme here.
        -->
        <!--
            The default surface. Sepia and Dark blue retint it from code rather
            than through ThemeResource: the tint arrives as a merged dictionary
            swapped in at runtime, and a ThemeResource reference is not
            guaranteed to re-evaluate when that happens. Assigning the brush is
            certain.
        -->
        <Grid.Background>
            <SolidColorBrush Color="#3A3A3D" />
        </Grid.Background>

        <!--
            Chrome occupies real COLUMNS; the canvas gets what is left.

            This was twice attempted with the canvas overlaid and inset by a
            margin, and the page was covered both times: first because the
            inset was a hand-written number that disagreed with the panel's
            geometry, then because it was derived from ActualWidth, which is
            zero while the panel is collapsed and had not been laid out yet
            when the inset was read. Any arithmetic that reproduces what the
            layout engine already knows will eventually disagree with it.
            Giving the panel a column means overlap is not expressible.
        -->
        <!--
            Rail | panels | document | panels | rail. The rail and the side
            panels sit on the left or, dragged across, on the right, and each
            side has a column for both so they never share one.
        -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="ThumbnailColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
            The tool options bar, the document, the status bar. The canvas
            column's elements say Grid.Row="1"; the rail and the side panels
            span the first two rows so they run from the top of the page to the
            status bar. A collapsed bar leaves its Auto row empty.
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            THE MENU BAR, declared here and shown in the window's title bar.

            Declared in the PAGE because every entry calls this page's own
            handler and binds to this page's view model, and Recent files and
            Signature are filled from this page's code. The constructor takes it
            out of this grid, and the window shows the menu of whichever tab is
            in front beside the app icon, where File and Edit sit in every
            desktop app. It was a row under the tab for one build, which made
            the app's menu look like part of one document.

            MinHeight="0" and the trimmed item margins fit it to the 34-DIP
            title bar: the stock bar asks for 40, and the item buttons need 28.

            GotFocus hands the keyboard back to the page. Out here the bar is
            outside RootGrid, so a menu title left holding focus after a click
            would keep every key from RootGrid_KeyDown, typing included.

            ⚠️ THE ACCELERATORS DECLARED HERE HAVE TO MATCH KeyboardCommands,
            not just look right in the menu. Once a flyout has been opened its
            accelerators go live and fire BEFORE the page's key handler, so a
            stale one silently steals the chord: Save As kept Ctrl+S after Save
            was added and went on opening the picker. An entry whose chord lives
            in the page's key handler carries the TEXT only, because a
            MenuFlyoutItem's own accelerator is dead until its flyout has been
            opened once.
        -->
        <MenuBar x:Name="AppMenuBar" MinHeight="0" GotFocus="AppMenuBar_GotFocus"
                 AutomationProperties.Name="Menu">
            <MenuBarItem Title="File" Margin="2,3,2,3">
                <MenuFlyoutItem Text="New" Click="New_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open..." Click="OpenFile_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="RecentMenu" Text="Recent files" />
                <MenuFlyoutItem Text="Merge files..." Click="MergeFiles_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Save" Click="Save_Click"
                                IsEnabled="{x:Bind ViewModel.HasDocumentPath, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74E;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save As..." Click="SaveAs_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <!--
                    Flattening used to be what an ordinary Save did, silently. It
                    is its own command, confirmed first, because it is the one
                    save whose result cannot be undone by reopening the file.
                -->
                <MenuFlyoutItem Text="Flatten and save a copy..." Click="FlattenSaveAs_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Print..." Click="Print_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE749;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="P" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <!-- Alt+Enter, which is Properties across Windows: Ctrl+D, which
                     Acrobat uses, is Duplicate here. -->
                <MenuFlyoutItem x:Name="DocumentPropertiesItem" Text="Document properties..."
                                Click="DocumentProperties_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu" Key="Enter" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Settings..." Click="Settings_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Close document" Click="CloseDocument_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="W" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <!-- Text only. The chord itself is an accelerator on the
                     window's root grid, so it fires wherever focus is; an
                     accelerator declared here would be dead until this flyout
                     had been opened once. -->
                <MenuFlyoutItem Text="Exit" Click="Exit_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+Q" />
            </MenuBarItem>

            <MenuBarItem Title="Edit" Margin="2,3,2,3">
                <MenuFlyoutItem Text="{x:Bind ViewModel.UndoLabel, Mode=OneWay}" Click="Undo_Click"
                                IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="{x:Bind ViewModel.RedoLabel, Mode=OneWay}" Click="Redo_Click"
                                IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Y" />
                        <!-- Ctrl+Shift+Z as well: both are standard for redo on
                             Windows and users arrive expecting whichever their
                             previous editor used. -->
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="Z" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <!--
                    Text only. Ctrl+X, Ctrl+C and Ctrl+V are cases in the page's
                    key handler. An accelerator here would go live once this menu
                    had been opened and fire before the key reached whatever has
                    focus, a text field included.
                -->
                <MenuFlyoutItem Text="Cut" Click="Cut_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+X">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8C6;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Copy" Click="Copy_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+C">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Paste" Click="Paste_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+V">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE77F;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Find" Click="FindToggle_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+F">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Group" Click="Group_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="G" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Ungroup" Click="Ungroup_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="G" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="SignatureMenu" Text="Signature" />
            </MenuBarItem>

            <MenuBarItem Title="Page" Margin="2,3,2,3">
                <MenuFlyoutSubItem Text="Insert">
                    <MenuFlyoutItem Text="From file..." Click="InsertFromFile_Click" />
                    <MenuFlyoutItem Text="A blank page" Click="InsertBlankPage_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="Extract pages..." Click="ExtractPagesMenu_Click" />
                <MenuFlyoutItem Text="Recognize text..." Click="RecognizeText_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Rotate page 90" Click="RotatePage_Click" />
                <MenuFlyoutItem Text="Rotate pages..." Click="RotatePagesMenu_Click" />
                <MenuFlyoutItem Text="Delete page" Click="DeletePage_Click" />
            </MenuBarItem>

            <MenuBarItem Title="View" Margin="2,3,2,3">
                <!-- Text only: F4 and F6 are live in the page's key handler. -->
                <MenuFlyoutItem Text="Pages panel" Click="ToggleThumbnails_Click"
                                KeyboardAcceleratorTextOverride="F4" />
                <MenuFlyoutItem Text="Bookmarks panel" Click="ToggleBookmarks_Click"
                                KeyboardAcceleratorTextOverride="F6" />
                <!-- Remembered (ShowStatusBar), and applied through
                     UpdateStatusBarVisibility like everything else that decides
                     whether the bar is on screen. -->
                <ToggleMenuFlyoutItem x:Name="StatusBarToggle" Text="Status bar"
                                      IsChecked="True" Click="StatusBarToggle_Click" />
                <MenuFlyoutSeparator />
                <!--
                    Zoom. These already existed as a flyout off the status bar's
                    percentage and as toolbar buttons, which is fine once you
                    know where to look and invisible until then: the View menu
                    is where anyone goes first. The chords are Acrobat's, live in
                    the page's key handler, so the muscle memory transfers.
                -->
                <MenuFlyoutItem Text="Fit page" Click="ZoomFitPage_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+0" />
                <MenuFlyoutItem Text="Fit width" Click="ZoomFitWidth_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+2" />
                <MenuFlyoutItem Text="Actual size" Click="ZoomActualSize_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+1" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Full screen" Click="FullScreen_Click"
                                KeyboardAcceleratorTextOverride="F11" />
                <ToggleMenuFlyoutItem x:Name="NightModeToggle" Text="Night mode"
                                      Click="NightModeToggle_Click" />
                <MenuFlyoutSeparator />
                <!--
                    Turning the VIEW, which is not the same as the Rotate page
                    commands under Page: this changes nothing in the file, needs
                    no save, and is forgotten when the document closes. Worded as
                    "view" for exactly that reason. The chords are live through
                    KeyboardCommands.
                -->
                <MenuFlyoutItem Text="Rotate view clockwise" Click="RotateViewCw_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift++" />
                <MenuFlyoutItem Text="Rotate view anticlockwise" Click="RotateViewCcw_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+-" />
                <MenuFlyoutItem x:Name="ResetViewRotationItem" Text="Reset view rotation"
                                Click="ResetViewRotation_Click" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <!--
                    How many pages are on screen. A radio pair rather than a
                    toggle, because "Single page" unchecked does not say what you
                    get instead, and the two names together do.
                -->
                <RadioMenuFlyoutItem x:Name="ContinuousViewItem" Text="Continuous scrolling"
                                     GroupName="pageViewMode" IsChecked="True"
                                     Click="ContinuousView_Click" />
                <RadioMenuFlyoutItem x:Name="SinglePageViewItem" Text="Single page"
                                     GroupName="pageViewMode"
                                     Click="SinglePageView_Click" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="ShowLinksToggle" Text="Show links"
                                      Click="ShowLinksToggle_Click" />
                <ToggleMenuFlyoutItem x:Name="RulersToggle" Text="Rulers in Edit mode"
                                      IsChecked="True" Click="RulersToggle_Click">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="R" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
                <MenuFlyoutSubItem Text="Ruler units">
                    <RadioMenuFlyoutItem x:Name="UnitInches" Text="Inches"
                                         GroupName="RulerUnit" IsChecked="True"
                                         Click="RulerUnit_Click" Tag="Inches" />
                    <RadioMenuFlyoutItem x:Name="UnitCentimeters" Text="Centimeters"
                                         GroupName="RulerUnit"
                                         Click="RulerUnit_Click" Tag="Centimeters" />
                    <RadioMenuFlyoutItem x:Name="UnitMillimeters" Text="Millimeters"
                                         GroupName="RulerUnit"
                                         Click="RulerUnit_Click" Tag="Millimeters" />
                    <RadioMenuFlyoutItem x:Name="UnitPoints" Text="Points"
                                         GroupName="RulerUnit"
                                         Click="RulerUnit_Click" Tag="Points" />
                    <RadioMenuFlyoutItem x:Name="UnitPicas" Text="Picas"
                                         GroupName="RulerUnit"
                                         Click="RulerUnit_Click" Tag="Picas" />
                </MenuFlyoutSubItem>
                <!--
                    The guide commands were only on the ruler's right-click menu,
                    which nobody finds without being told and which is out of
                    reach while the rulers are hidden. Same handlers as that menu.
                    Lock guides is a second toggle for the same setting, kept in
                    step with the ruler menu's by LockGuidesToggle_Click.
                -->
                <MenuFlyoutSubItem Text="Guides">
                    <MenuFlyoutItem Text="Add guide at exact position..." Click="AddGuideAt_Click" />
                    <MenuFlyoutItem Text="Add margin guides..." Click="AddMargins_Click" />
                    <MenuFlyoutItem Text="Add column guides..." Click="AddColumns_Click" />
                    <ToggleMenuFlyoutItem x:Name="LockGuidesMenuToggle" Text="Lock guides" Click="LockGuidesToggle_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Clear guides on this page" Click="ClearGuidesPage_Click" />
                    <MenuFlyoutItem Text="Clear all guides" Click="ClearGuidesAll_Click" />
                </MenuFlyoutSubItem>
            </MenuBarItem>

            <MenuBarItem Title="Help" Margin="2,3,2,3">
                <MenuFlyoutItem Text="About Ayaan PDF" Click="About_Click" />
            </MenuBarItem>
        </MenuBar>


        <!--
            MaxZoomFactor is 8, i.e. 800%. This was briefly raised to 64 to
            match Acrobat, on the theory that tiles had removed the reason for
            the cap. They had not: the page went visibly BLURRY at 6400%, and
            the tile counts in the trace, which looked healthy, said nothing
            about it.

            The reason is the tiles' LAYOUT size. Tile position and size are in
            unzoomed slot DIPs, and the level doubles with the zoom, so a tile
            shrinks as you go in: about 12 DIP at 800%, but 1.6 DIP at 6400%.
            The ScrollView's zoom is a compositor scale over content laid out at
            that size, so past some point the tiles are rasterized far smaller
            than they are displayed and magnified back up.

            Raising this again needs a floor on how small a tile may be in slot
            DIPs, with the level chosen against that floor, NOT just a bigger
            number here.
        -->
        <!-- Rulers: PageMaker-style top and left, giving the user a visible
             coordinate frame while placing shapes. Overlaid on the viewport
             column with a Margin on the ScrollView reserving room; toggled
             from View > Rulers. Corner covers the intersection so the two
             rulers don't butt into each other visually. -->
        <Border x:Name="RulerCorner" Grid.Column="2" Grid.Row="1"
                Width="22" Height="22"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,1" Canvas.ZIndex="10" />

        <!-- Live preview line shown while dragging a guide out of a ruler.
             Positioned in viewport-DIP space via Margin, so it lands under
             the pointer even as the pointer crosses out of the ruler onto
             the page. Horizontal preview: full viewport width, 1 DIP tall,
             top of Margin = pointer Y. Vertical preview: 1 DIP wide, full
             height, left of Margin = pointer X. Collapsed until pressed. -->
        <Rectangle x:Name="GuidePreviewLine" Grid.Column="2" Grid.Row="1"
                   Fill="#FF00A0D8" Opacity="0.85"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   IsHitTestVisible="False"
                   UseLayoutRounding="False"
                   Canvas.ZIndex="9"
                   Visibility="Collapsed" />

        <!-- Coordinate readout that follows the pointer during the drag.
             Small floating chip near the cursor showing the current position
             in the active ruler unit, so precise placement is a matter of
             watching the number rather than counting ticks. Collapsed until
             a ruler drag starts. -->
        <Border x:Name="GuideReadout" Grid.Column="2" Grid.Row="1"
                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="3"
                Padding="4,1"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                IsHitTestVisible="False"
                Canvas.ZIndex="11"
                Visibility="Collapsed">
            <TextBlock x:Name="GuideReadoutText" FontSize="10"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Border>
        <controls:CursorCanvas x:Name="TopRuler" Grid.Column="2" Grid.Row="1"
                Height="22" Margin="22,0,0,0"
                HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Background="{ThemeResource LayerFillColorAltBrush}"
                Canvas.ZIndex="10"
                PointerPressed="TopRuler_PointerPressed"
                PointerMoved="Ruler_PointerMoved"
                PointerReleased="Ruler_PointerReleased"
                PointerCaptureLost="Ruler_PointerCaptureLost"
                PointerEntered="Ruler_PointerEntered"
                PointerExited="Ruler_PointerExited"
                RightTapped="Ruler_RightTapped"
                SizeChanged="Rulers_SizeChanged">
            <Canvas.ContextFlyout>
                <MenuFlyout x:Name="RulerFlyout">
                    <RadioMenuFlyoutItem Text="Inches"       GroupName="RulerUnitFly" Click="RulerUnit_Click" Tag="Inches" IsChecked="True" />
                    <RadioMenuFlyoutItem Text="Centimeters"  GroupName="RulerUnitFly" Click="RulerUnit_Click" Tag="Centimeters" />
                    <RadioMenuFlyoutItem Text="Millimeters"  GroupName="RulerUnitFly" Click="RulerUnit_Click" Tag="Millimeters" />
                    <RadioMenuFlyoutItem Text="Points"       GroupName="RulerUnitFly" Click="RulerUnit_Click" Tag="Points" />
                    <RadioMenuFlyoutItem Text="Picas"        GroupName="RulerUnitFly" Click="RulerUnit_Click" Tag="Picas" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Add guide at exact position..." Click="AddGuideAt_Click" />
                    <MenuFlyoutItem Text="Add margin guides..." Click="AddMargins_Click" />
                    <MenuFlyoutItem Text="Add column guides..." Click="AddColumns_Click" />
                    <ToggleMenuFlyoutItem x:Name="LockGuidesToggle" Text="Lock guides" Click="LockGuidesToggle_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Clear guides on this page" Click="ClearGuidesPage_Click" />
                    <MenuFlyoutItem Text="Clear all guides" Click="ClearGuidesAll_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Hide Rulers" Click="RulersHide_Click" />
                </MenuFlyout>
            </Canvas.ContextFlyout>
        </controls:CursorCanvas>
        <controls:CursorCanvas x:Name="LeftRuler" Grid.Column="2" Grid.Row="1"
                Width="22" Margin="0,22,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Background="{ThemeResource LayerFillColorAltBrush}"
                Canvas.ZIndex="10"
                PointerPressed="LeftRuler_PointerPressed"
                PointerMoved="Ruler_PointerMoved"
                PointerReleased="Ruler_PointerReleased"
                PointerCaptureLost="Ruler_PointerCaptureLost"
                PointerEntered="Ruler_PointerEntered"
                PointerExited="Ruler_PointerExited"
                RightTapped="Ruler_RightTapped"
                SizeChanged="Rulers_SizeChanged" />

        <ScrollView
            x:Name="PageScroller"
            Grid.Column="2"
            Grid.Row="1"
            Margin="22,22,0,0"
            ZoomMode="Enabled"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Enabled"
            MinZoomFactor="0.1"
            MaxZoomFactor="8"
            ViewChanged="PageScroller_ViewChanged"
            SizeChanged="PageScroller_SizeChanged">
            <!--
                Width/Height are pinned to the ViewModel's layout size in
                DIPs and the Image stretches to fill it. Sharper renders
                therefore change only pixel density, never layout, so
                ScrollView.ZoomFactor 1.0 reliably means "fits the width".
            -->
            <controls:CursorGrid
                x:Name="ViewportHost"
                Background="Transparent"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="24"
                PointerPressed="ViewportHost_PointerPressed"
                PointerMoved="ViewportHost_PointerMoved"
                PointerReleased="ViewportHost_PointerReleased"
                PointerCanceled="ViewportHost_PointerReleased"
                PointerCaptureLost="ViewportHost_PointerCaptureLost"
                DoubleTapped="ViewportHost_DoubleTapped"
                RightTapped="ViewportHost_RightTapped"
                IsDoubleTapEnabled="True"
                IsRightTapEnabled="True">

                <!--
                    Continuous page stack.

                    Each card is sized in SLOT space (unzoomed DIPs) from
                    the page's intrinsic size, fixed the moment the
                    document opens. Zoom is the ScrollView's own zoom
                    factor, which grows the scrollable extent, so a card
                    always occupies its final space and bitmaps can stream
                    in or be released without anything below shifting.

                    ItemsControl, not ItemsRepeater: the slots already
                    virtualize their PIXELS in the view model (bitmaps are
                    released outside the window while heights stay), so
                    virtualizing the containers as well would buy little
                    and would make scroll-offset-to-page mapping depend on
                    realization order.
                -->
                <!--
                    ItemsRepeater, not ItemsControl: an ItemsControl over a
                    StackPanel realises EVERY item up front. A 3352-page book
                    therefore built 3352 shadowed cards before it could show
                    one, which took 69 seconds and 1.1 GB.

                    The original objection to virtualising was that
                    scroll-offset-to-page mapping would depend on realisation
                    order. It does not: PageAt reads _layout.TopOf(i) and the
                    slot's own height, both of which are known for every page
                    the moment the layout is built, whether or not a container
                    for it exists. Nothing in the code-behind looks a page card
                    up by container either.

                    ⚠️ NOT StackLayout, which ESTIMATES where a card it has not
                    measured sits from the average of the ones it has. A book
                    whose opening pages are taller than the rest put a jump to
                    page 39175 among blank cards for pages near 36000, while the
                    right page was rendered into a card off screen.
                    PageStackLayout places every card at its exact top. Its
                    Spacing must equal the view model's page gap.
                -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.PageSlots}" HorizontalAlignment="Center">
                    <ItemsRepeater.Layout>
                        <controls:PageStackLayout x:Name="PageCardLayout" Spacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:PageSlot">
                            <!-- The page card: the sheet, a thin border, a drop shadow. -->
                            <Border Width="{x:Bind SlotWidth}" Height="{x:Bind SlotHeight}"
                                    Background="{StaticResource PageSheetBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <Border.Shadow>
                                    <ThemeShadow />
                                </Border.Shadow>
                                <!--
                                    The content box, and the one place view
                                    rotation happens.

                                    Everything below is positioned in content
                                    coordinates, so turning this Grid turns the
                                    page, its tiles, its highlights, its
                                    annotations and its selection together, in
                                    step, with no per-layer maths. The card
                                    around it has already been given the turned
                                    shape by the layout.

                                    A rotate transform is safe here where the
                                    scale transform described below was not.
                                    The objection there was that a transform
                                    runs AFTER layout, so normalized rects laid
                                    out at sub-pixel sizes and had no geometry
                                    to scale up. These children lay out at their
                                    real slot-DIP sizes first and are turned
                                    afterwards, which is exactly what the
                                    ScrollView's own zoom already does to them.

                                    Left/Top alignment, not the default stretch:
                                    a stretched child would be re-measured to
                                    the card's turned shape and squash the page.
                                -->
                                <Grid Width="{x:Bind ContentWidth}" Height="{x:Bind ContentHeight}"
                                      HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid.RenderTransform>
                                        <CompositeTransform ScaleX="{x:Bind ViewScale}"
                                                            ScaleY="{x:Bind ViewScale}"
                                                            Rotation="{x:Bind ViewRotation}"
                                                            TranslateX="{x:Bind ViewTranslateX}"
                                                            TranslateY="{x:Bind ViewTranslateY}" />
                                    </Grid.RenderTransform>
                                    <Image Source="{x:Bind Bitmap, Mode=OneWay}" Stretch="Fill" />

                                    <!--
                                        Deep-zoom tiles, laid over the stretched
                                        full-page bitmap so the page underneath
                                        shows through until each tile arrives.
                                        That is the progressive effect: the view
                                        is never blank, it just gets sharper.

                                        Positions are slot DIPs, already
                                        multiplied, so the tiles line up with
                                        the page exactly and no transform sits
                                        between layout and geometry.

                                        UseLayoutRounding MUST be False here.
                                        Tiles are a fraction of a DIP wide in
                                        slot space (12.5 at 800%, 1.6 at 6400%)
                                        and the default rounding snaps each one
                                        UP to the next whole physical pixel
                                        while leaving its position exact. At
                                        150% scale that turned a 12.5 DIP tile
                                        into 12.6667, so every tile overlapped
                                        its neighbour by a sixth of a DIP: a
                                        grid of seams magnified by the zoom into
                                        1.3 DIP of doubled content across the
                                        whole page. Deeper levels are worse, the
                                        overlap becoming a gap once a tile
                                        rounds DOWN. This is measured in
                                        diag.log by the tilegeom lines: want and
                                        got must agree.
                                    -->
                                    <ItemsControl ItemsSource="{x:Bind Tiles}" IsHitTestVisible="False"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                  UseLayoutRounding="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Grid UseLayoutRounding="False" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:PageTile">
                                                <Image Source="{x:Bind Bitmap, Mode=OneWay}" Stretch="Fill"
                                                       Width="{x:Bind Size}" Height="{x:Bind Size}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       UseLayoutRounding="False"
                                                       Margin="{x:Bind local:MainPage.Offset(Left, Top)}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--
                                        Overlay layer for this page.

                                        NO ScaleTransform. Every rect below is
                                        already multiplied into slot DIPs by
                                        the view model. A RenderTransform runs
                                        AFTER layout, so normalized rects were
                                        laid out at sub-pixel sizes (about
                                        0.3 x 0.02 DIP) and produced no
                                        geometry to scale up: selections,
                                        highlights and search hits were all
                                        computed correctly and drew nothing.
                                    -->
                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <ItemsControl ItemsSource="{x:Bind SearchMatchRects}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <!-- Fill comes from the rect, not from here: the SELECTED
                                                         match is drawn in a stronger colour than the others on
                                                         the page, which is what says which of the 431 you are
                                                         on. SearchHighlight decides both colours. -->
                                                    <Rectangle Fill="{x:Bind local:MainPage.HexBrush(ColorHex)}"
                                                               Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                            Fillable form fields, shown only in fill mode. A tinted fill
                                            plus a dashed accent border so they read as "click here to
                                            type" without hiding the field's own printed box. Display
                                            only: the click is caught by the viewport host, which hit-tests
                                            the field and opens the text editor on it.
                                        -->
                                        <ItemsControl ItemsSource="{x:Bind FormFieldOutlines}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <Rectangle Fill="#332563EB"
                                                               Stroke="#CC2563EB" StrokeThickness="1.5"
                                                               StrokeDashArray="3,2" RadiusX="1" RadiusY="1"
                                                               Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                            LINKS, when Show Links is on.

                                            The only thing that makes a link
                                            visible at all. Measured in every
                                            real file: a link annotation carries
                                            no appearance stream and a
                                            zero-width border, so the document
                                            draws nothing and a reader cannot
                                            tell what is clickable.

                                            Stroke comes from the rect, because
                                            a link whose address can be changed
                                            and one that jumps inside the
                                            document are not the same offer.

                                            Not hit-testable: the viewport host
                                            works out what was clicked from the
                                            coordinates, and letting these take
                                            the pointer would steal the press
                                            from the code that decides what a
                                            click on a link means.
                                        -->
                                        <ItemsControl ItemsSource="{x:Bind LinkOutlines}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <Rectangle Fill="#141A73E8"
                                                               Stroke="{x:Bind local:MainPage.HexBrush(ColorHex)}"
                                                               StrokeThickness="1" StrokeDashArray="3,2"
                                                               RadiusX="1" RadiusY="1"
                                                               Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{x:Bind SelectionRects}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <Rectangle Fill="#665599FF" Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Highlights arrive flattened: one entry per rectangle, carrying its colour. -->
                                        <ItemsControl ItemsSource="{x:Bind HighlightRects}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <Rectangle Fill="{x:Bind local:MainPage.HexBrush(ColorHex)}"
                                                               Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                            Marquee around the selected annotation.

                                            A hairline solid border, not a thick
                                            dashed one. The mark being selected
                                            is the thing worth looking at; the
                                            selection should point at it, not
                                            compete with it. Every serious
                                            editor draws this the same way, and
                                            a heavy dashed rectangle reads as a
                                            debug overlay rather than a tool.
                                        -->
                                        <!-- Smart alignment guides: bright orange lines that flash into
                                             existence while you drag and your edge/centre aligns with
                                             another object's edge/centre. ItemsControl over an ObservableCollection
                                             so the .Clear() at drag-end reliably disappears the lines - the
                                             earlier nullable-property approach's PropertyChanged wasn't always
                                             re-evaluating the binding. -->
                                        <ItemsControl ItemsSource="{x:Bind SmartGuideLines}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:SmartGuideLine">
                                                    <Rectangle Fill="{x:Bind local:MainPage.SmartGuideBrush, Mode=OneTime}"
                                                               Opacity="0.9" UseLayoutRounding="False"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                                               Width="{x:Bind PixelWidth}"
                                                               Height="{x:Bind PixelHeight}"
                                                               Margin="{x:Bind local:MainPage.Offset(PixelLeft, PixelTop)}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Ruler guides: horizontal/vertical lines spanning the page,
                                             drawn above the page content but below selection marquees.
                                             1 DIP thick, Acrobat-cyan. IsHitTestVisible=False for now;
                                             the pointer falls through so drawing tools still work over
                                             a guide. Move/delete will get their own pass. -->
                                        <ItemsControl ItemsSource="{x:Bind Guides}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:GuideMark">
                                                    <Rectangle Opacity="0.85"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                                               UseLayoutRounding="False"
                                                               Fill="{x:Bind local:MainPage.GuideFill(IsSelected, IsSnapActive), Mode=OneWay}"
                                                               Width="{x:Bind PixelWidth, Mode=OneWay}"
                                                               Height="{x:Bind PixelHeight, Mode=OneWay}"
                                                               Margin="{x:Bind local:MainPage.Offset(PixelLeft, PixelTop), Mode=OneWay}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Marquees for the multi-selection extras: thin accent outlines, no
                                             handles, OUTSIDE the rotate transform because each extra keeps its
                                             own upright frame. -->
                                        <ItemsControl ItemsSource="{x:Bind ExtraSelectionOutlines}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <Rectangle Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                               StrokeThickness="1" StrokeDashArray="3,2"
                                                               Fill="Transparent"
                                                               Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                            The document's OWN text, selected.

                                            A HAIRLINE, and nothing else. This
                                            is the convention every PDF editor
                                            uses for a piece of existing page
                                            content: one thin solid rule around
                                            the words, no handles, no fill.

                                            NO FILL is the part that matters
                                            most. A tint, however light, sits
                                            OVER the glyphs and discolours the
                                            document the reader came to read.
                                            The frame has to say "this one"
                                            without touching how the text looks.

                                            NO HANDLES because there is nothing
                                            to drag. Acrobat draws handles only
                                            on a clustered block it can actually
                                            resize, and puts a plain rule around
                                            each line; one Stage 1 selection is
                                            one line, so a plain rule is the
                                            honest match. Handles arrive when
                                            they do something.

                                            Outside the rotate transform, since
                                            page content is not one of our marks
                                            and never carries our rotation.
                                        -->
                                        <!--
                                            WHERE THE DOCUMENT'S OWN TEXT IS,
                                            while the reader is still deciding
                                            where to click. Drawn only in Edit
                                            mode, and only around regions that
                                            can actually be offered.

                                            Deliberately fainter and dashed:
                                            this is not a selection, and a page
                                            wearing solid rules everywhere reads
                                            as a form rather than as a page. The
                                            selection frame below is solid and
                                            draws on top of these.

                                            NOT HIT-TESTABLE, like every other
                                            overlay here: the reader's click has
                                            to reach the page.

                                            THIS IS THE LOCATION OF THE PAGE'S
                                            OWN TEXT. IT IS NOT AN EDITOR, and
                                            it must never grow into one. Editing
                                            has to feel like editing the PDF's
                                            own text where it already sits, not
                                            like typing into a separate box that
                                            appeared on top of it. When the
                                            caret arrives it goes at the real
                                            character position underneath, and
                                            the page stays visually stable. The
                                            box may say what is selected; it may
                                            not become the surface being typed
                                            into. See TextRegionModel.cs.
                                        -->
                                        <ItemsControl ItemsSource="{x:Bind TextRegionOutlines}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <Rectangle Stroke="{x:Bind local:MainPage.HexBrush(ColorHex)}"
                                                               StrokeThickness="1"
                                                               StrokeDashArray="3,3"
                                                               Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{x:Bind PageTextOutline}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <!--
                                                        Fixed blue rather than
                                                        the theme accent: a page
                                                        is white paper in both
                                                        themes, and this frame
                                                        is read against the
                                                        paper, not against the
                                                        app around it.
                                                    -->
                                                    <Rectangle Stroke="{x:Bind local:MainPage.HexBrush(ColorHex)}"
                                                               StrokeThickness="1"
                                                               Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                            The corner marks of that frame, which
                                            say it is one OBJECT and can be picked
                                            up. FILLED squares, not the white
                                            circles of SelectionGrips: those
                                            resize an annotation and these resize
                                            nothing, because the document's own
                                            text has no reflow to give it a new
                                            width with. Dragging one moves the
                                            text, exactly as dragging anywhere
                                            else inside the frame does.

                                            Not hit-testable, like the frame: the
                                            press that matters is the one that
                                            reaches the page underneath.
                                        -->
                                        <ItemsControl ItemsSource="{x:Bind PageTextHandles}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <Rectangle Fill="{x:Bind local:MainPage.HexBrush(ColorHex)}"
                                                               Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                            WHY that text cannot be edited, said
                                            beside the frame that says which text.

                                            ⚠️ IT IS HERE BECAUSE NOTHING SHOWS
                                            `Status`. The app wrote the refusal
                                            to that property and to the log, and
                                            the property is displayed nowhere: a
                                            reader clicking justified text saw a
                                            frame appear and was told nothing.

                                            NOT HIT-TESTABLE, for the same reason
                                            the frame is not. The reader's next
                                            click has to reach the page, and a
                                            label that ate it would break the
                                            gesture it is explaining.

                                            Fixed colours, like the frame: this
                                            is read against white paper in both
                                            themes.
                                        -->
                                        <ItemsControl ItemsSource="{x:Bind PageTextNotice}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:PageNotice">
                                                    <Border Background="#FFFFF8E7"
                                                            BorderBrush="{x:Bind local:MainPage.HexBrush(ColorHex)}"
                                                            BorderThickness="1" CornerRadius="4" Padding="8,5"
                                                            MaxWidth="{x:Bind MaxWidth}"
                                                            Margin="{x:Bind local:MainPage.NoticeMargin(Left, TopMargin, BottomMargin, Above)}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="{x:Bind local:MainPage.NoticeAlign(Above)}">
                                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap"
                                                                   FontSize="12" LineHeight="16"
                                                                   Foreground="{x:Bind local:MainPage.HexBrush(ColorHex)}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Frame + handles, turned as ONE about the box centre for a rotated text box. -->
                                        <Grid>
                                            <Grid.RenderTransform>
                                                <RotateTransform Angle="{x:Bind SelectionRotation, Mode=OneWay}"
                                                                 CenterX="{x:Bind SelectionCenterX, Mode=OneWay}"
                                                                 CenterY="{x:Bind SelectionCenterY, Mode=OneWay}" />
                                            </Grid.RenderTransform>
                                        <ItemsControl ItemsSource="{x:Bind SelectionOutline}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <Rectangle Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                               StrokeThickness="1" Fill="Transparent"
                                                               Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                            Corner grips for resizing.

                                            Drawn as a separate collection from
                                            the marquee because they are four
                                            squares rather than one rectangle,
                                            and IsHitTestVisible stays False:
                                            the pointer handler works out which
                                            corner was grabbed from the
                                            coordinates, so these are purely
                                            something to aim at. Letting them
                                            take the pointer would steal the
                                            press from the canvas that decides
                                            what the drag means.
                                        -->
                                        <ItemsControl ItemsSource="{x:Bind SelectionGrips}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <!--
                                                        WHITE fill with an accent
                                                        border, the convention in
                                                        every design tool. A solid
                                                        accent square reads as a
                                                        blob sitting on the page;
                                                        a white one reads as a
                                                        control, and stays visible
                                                        over dark artwork as well
                                                        as light paper.
                                                    -->
                                                    <Ellipse Fill="White"
                                                             Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                             StrokeThickness="1.5"
                                                             Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                             Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                             HorizontalAlignment="Left" VerticalAlignment="Top">
                                                        <Ellipse.Shadow>
                                                            <ThemeShadow />
                                                        </Ellipse.Shadow>
                                                    </Ellipse>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </Grid>
                                    </Grid>

                                    <!--
                                        Notes live OUTSIDE the scaled overlay.

                                        The overlay above is scaled by the slot
                                        width (800x) so that normalized rect
                                        sizes come out right. A note marker is
                                        a real control with an intrinsic size,
                                        so the same transform blew a 30px
                                        button up to 24000px: it covered the
                                        whole page and, being hit-testable,
                                        swallowed every pointer event meant for
                                        the tools underneath. Positioned here
                                        by pre-multiplied offset instead, so it
                                        stays a normal-sized button.
                                    -->
                                    <ItemsControl ItemsSource="{x:Bind Notes}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:NoteAnnotation">
                                                <Button AutomationProperties.Name="Note" Padding="4" Background="#FFFFD700" CornerRadius="12"
                                                        Margin="{x:Bind local:MainPage.ScaledOffset(X, Y, Scale)}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <FontIcon Glyph="&#xE70B;" FontSize="14" Foreground="#FF1A1A1A" />
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel Spacing="8" Width="220">
                                                                <TextBox Text="{x:Bind Text, Mode=TwoWay}" PlaceholderText="Note text" Height="90" AcceptsReturn="True" TextWrapping="Wrap" />
                                                                <!-- A note marker is a button whose click opens this flyout,
                                                                     so the Select tool can never pick it; without this there
                                                                     was no way to remove a note at all. -->
                                                                <Button Content="Delete note" HorizontalAlignment="Right"
                                                                        Click="DeleteNote_Click" Tag="{x:Bind}" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!--
                    Ink layer, spanning the WHOLE stack rather than sitting
                    inside a page card. Polyline points cannot be bound
                    through x:Bind, so strokes are built in code-behind,
                    and a page-spanning layer means a stroke drawn near a
                    page edge is never clipped by the card. Positions are
                    in slot space, so the ScrollView's zoom scales the ink
                    along with the pages.
                -->
                <Canvas x:Name="InkCanvas" IsHitTestVisible="False" />


                <!--
                    Isolated text-editing layer, ABOVE the ink canvas.

                    Separate from InkCanvas because that one is hit-test
                    invisible (so ink never eats a page gesture), but the text
                    editor MUST receive pointer input: clicking to place the
                    caret and dragging to select are what make editing feel
                    like a real text box rather than a field you can only type
                    into blind. A dim scrim over the rest of the page isolates
                    the box being edited, the way Word greys out everything
                    else; clicking the scrim (anywhere off the box) commits.

                    EditCanvas has NO background, so its empty area is
                    transparent to hit-testing and a click there falls through
                    to the scrim; only the editor child is interactive.
                    Collapsed until an edit begins.
                -->
                <!--
                    ⚠️ THIS IS THE INTERACTION THAT IS BEING REPLACED, NOT
                    EXTENDED. A settled product requirement: editing must feel
                    like editing the PDF's own text where it already sits, not
                    like typing into a separate box that appeared on top of the
                    page. This overlay is the opposite of that on both counts.
                    It floats a TextBox over the text, and the scrim DIMS THE
                    WHOLE PAGE while it is up, so the page does not stay
                    visually stable either.

                    It stays for now because nothing has replaced it yet. Do not
                    build on it, and do not keep it merely because it is already
                    written. The replacement puts a caret at the real character
                    position, from the geometry in TextRegionModel.cs.
                -->
                <Grid x:Name="EditOverlay" Visibility="Collapsed">
                    <Rectangle x:Name="EditScrim" Fill="#30000000"
                               PointerPressed="EditScrim_PointerPressed" />
                    <Canvas x:Name="EditCanvas" />
                </Grid>

                <!--
                    EDITING THE PAGE'S OWN TEXT, IN PLACE.

                    Deliberately NOT inside EditOverlay: no scrim, nothing
                    dimmed, no box. The page stays exactly as it is and this
                    carries only two things, both of which belong to the text
                    rather than to a dialog:

                      - the caret, at the character the reader clicked;
                      - the part of the line the page can no longer draw,
                        redrawn in the page's own font, size, colour and
                        baseline, covering only the old glyphs it replaces.

                    Until the reader changes something there is no second item
                    at all, so nothing whatever is painted over the document.

                    NOT HIT-TESTABLE: a click has to reach the page so it can
                    move the caret, exactly as clicking in text does anywhere.
                -->
                <Canvas x:Name="InPlaceLayer" IsHitTestVisible="False" />

            </controls:CursorGrid>
        </ScrollView>

        <!--
            Candidate Skia shape layer. COLLAPSED unless
            AppSettings.UseSkiaShapeLayer is set; exactly one of this and
            InkCanvas ever draws, and turning the flag off restores the
            renderer that always has.

            OUTSIDE the ScrollView, for the same reason the object toolbar is,
            plus one of its own. Inside, ZoomFactor is a compositor scale: it
            keeps the overlay's vector children crisp but would magnify a Skia
            BITMAP into blur as you zoom in. Out here the surface is the size
            of the viewport, is rasterised at final device resolution every
            frame, and takes zoom and scroll as numbers instead.

            Margin mirrors PageScroller's so its origin is the viewport's
            top-left, and SetRulersVisible keeps the two in step.
        -->
        <rendering:SkiaShapeLayer x:Name="SkiaShapeCanvas"
                                  Grid.Column="2"
                                  Grid.Row="1"
                                  Margin="22,22,0,0"
                                  IsHitTestVisible="False"
                                  Visibility="Collapsed" />

        <!--
            The Gradient panel: MOVABLE, and outside every flyout.

            It used to be an expander inside the Fill flyout, which was the
            wrong control for it twice over. A flyout is light-dismiss, so
            clicking the page to look at the shape closed it; and it is anchored
            to its button, so it sat over the document however little room there
            was. Setting a gradient means dragging four controls while WATCHING
            the shape, and a flyout allows neither.

            Positioned exactly as ObjectToolbar is, and for the reason recorded
            there: page cards carry a ThemeShadow and are therefore raised in
            the composition tree, so anything left at ground level is drawn
            behind the paper whatever its ZIndex says. Position and elevation
            both go through Translation, set in code; a RenderTransform would
            drive the same composition visual and quietly win, Z included.
        -->
        <Border x:Name="GradientPanelWindow" Grid.Column="2" Grid.Row="1"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Collapsed" Canvas.ZIndex="30" Translation="0,0,40"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                SizeChanged="GradientPanelWindow_SizeChanged">
            <StackPanel Width="264">

                <!-- Title bar: the drag handle, and the only way to move it. -->
                <Grid x:Name="GradientPanelTitleBar" Height="32" Padding="10,0,4,0"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      PointerPressed="GradientPanelTitle_PointerPressed"
                      PointerMoved="GradientPanelTitle_PointerMoved"
                      PointerReleased="GradientPanelTitle_PointerReleased"
                      PointerCaptureLost="GradientPanelTitle_PointerCaptureLost">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Gradient" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" />

                    <Button Grid.Column="1" x:Name="GradientPanelClose"
                            Width="28" Height="24" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Close the gradient panel"
                            ToolTipService.ToolTip="Close"
                            Click="GradientPanelClose_Click">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>

                <StackPanel Padding="10" Spacing="8">
                    <StackPanel x:Name="GradientSection"
                              HorizontalAlignment="Stretch">
                        <StackPanel x:Name="GradientRows" Spacing="8">
                            <ToggleSwitch x:Name="GradientToggle" Header="Gradient fill"
                                          OnContent="On" OffContent="Off"
                                          Toggled="Gradient_Toggled" />

                            <StackPanel x:Name="GradientControlsPanel" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Start" VerticalAlignment="Center" MinWidth="42" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border x:Name="GradientStartSwatch" Width="24" Height="24" CornerRadius="4"
                                            BorderBrush="#66000000" BorderThickness="1" VerticalAlignment="Center" />
                                    <Button AutomationProperties.Name="Blue" Width="22" Height="22" Padding="0" Background="#FF0078D4" Tag="#FF0078D4" Click="GradientStart_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Blue" />
                                    <Button AutomationProperties.Name="Red" Width="22" Height="22" Padding="0" Background="#FFD13438" Tag="#FFD13438" Click="GradientStart_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Red" />
                                    <Button AutomationProperties.Name="Green" Width="22" Height="22" Padding="0" Background="#FF107C10" Tag="#FF107C10" Click="GradientStart_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Green" />
                                    <Button AutomationProperties.Name="Amber" Width="22" Height="22" Padding="0" Background="#FFFFB900" Tag="#FFFFB900" Click="GradientStart_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Amber" />
                                    <Button AutomationProperties.Name="Black" Width="22" Height="22" Padding="0" Background="#FF000000" Tag="#FF000000" Click="GradientStart_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Black" />
                                    <Button AutomationProperties.Name="White" Width="22" Height="22" Padding="0" Background="#FFFFFFFF" Tag="#FFFFFFFF" Click="GradientStart_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="White" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="End" VerticalAlignment="Center" MinWidth="42" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border x:Name="GradientEndSwatch" Width="24" Height="24" CornerRadius="4"
                                            BorderBrush="#66000000" BorderThickness="1" VerticalAlignment="Center" />
                                    <Button AutomationProperties.Name="Blue" Width="22" Height="22" Padding="0" Background="#FF0078D4" Tag="#FF0078D4" Click="GradientEnd_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Blue" />
                                    <Button AutomationProperties.Name="Red" Width="22" Height="22" Padding="0" Background="#FFD13438" Tag="#FFD13438" Click="GradientEnd_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Red" />
                                    <Button AutomationProperties.Name="Green" Width="22" Height="22" Padding="0" Background="#FF107C10" Tag="#FF107C10" Click="GradientEnd_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Green" />
                                    <Button AutomationProperties.Name="Amber" Width="22" Height="22" Padding="0" Background="#FFFFB900" Tag="#FFFFB900" Click="GradientEnd_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Amber" />
                                    <Button AutomationProperties.Name="Black" Width="22" Height="22" Padding="0" Background="#FF000000" Tag="#FF000000" Click="GradientEnd_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Black" />
                                    <Button AutomationProperties.Name="White" Width="22" Height="22" Padding="0" Background="#FFFFFFFF" Tag="#FFFFFFFF" Click="GradientEnd_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="White" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Angle" VerticalAlignment="Center" MinWidth="42" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider x:Name="GradientAngleSlider" Width="126"
                                            Maximum="359" Minimum="0" StepFrequency="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Gradient direction in degrees"
                                            ValueChanged="Gradient_ValueChanged" />
                                    <TextBlock x:Name="GradientAngleReadout" VerticalAlignment="Center"
                                               MinWidth="34" TextAlignment="Right" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Spread" VerticalAlignment="Center" MinWidth="42" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider x:Name="GradientSpreadSlider" Width="126"
                                            Maximum="500" Minimum="10" StepFrequency="5"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Gradient ramp length as a percentage"
                                            ToolTipService.ToolTip="How long the ramp is. Below 100% each end fills flat; above 100% the shape shows only the middle of the ramp."
                                            ValueChanged="Gradient_ValueChanged" />
                                    <TextBlock x:Name="GradientSpreadReadout" VerticalAlignment="Center"
                                               MinWidth="34" TextAlignment="Right" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Button x:Name="GradientSwapButton" Content="Swap colours"
                                        HorizontalAlignment="Stretch" Height="28" FontSize="12"
                                        AutomationProperties.Name="Swap the gradient's two colours"
                                        Click="GradientSwap_Click" />

                                <Border x:Name="GradientPreview" Height="22" CornerRadius="4"
                                        BorderBrush="#66000000" BorderThickness="1" />
                            </StackPanel>

                            <TextBlock x:Name="GradientNoSelectionHint"
                                       Text="Select a shape to give it a gradient."
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                                </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--
            Contextual object toolbar. Floats over the viewport and follows the
            selection, so object commands are reachable without going to the
            menu. This is now the primary route to Group and Ungroup, because
            Ctrl+G proved to be interceptable outside the app entirely.

            OUTSIDE the ScrollView on purpose. Inside it the buttons would be
            scaled by ZoomFactor along with the page and would be the size of a
            postage stamp at 25% and unusable at 800%. Its Margin mirrors
            PageScroller's so that its origin is the viewport's top-left, which
            is the space ObjectToolbarPlacement computes in; SetRulersVisible
            keeps the two margins in step.

            Text labels rather than icons: no Segoe glyph reads unambiguously as
            "ungroup", and a guessed glyph that is missing from the font renders
            as a tofu box.

            ACRYLIC, like the property bar and the tool rail, and NOT a layer
            fill. This floats over WHITE PAPER, not over app chrome, and
            LayerFillColorAltBrush is opaque white in Light but about five per
            cent white in Dark. Over a page that is nothing at all: the panel
            vanished and took the pale button text with it, so the toolbar was
            invisible in every dark theme while looking perfect in the light
            one. Chrome that floats over the document needs a background that
            owns its pixels in every theme.

            TRANSLATION, not just ZIndex. Each page card carries a ThemeShadow,
            which puts it on a raised ELEVATION in the composition tree, and an
            elevated visual composites above an unelevated one whatever their
            ZIndex says: ZIndex only orders siblings within a panel's own render
            pass and does not reach across depth. So this toolbar was drawn
            behind every page it floated over, visible only where it overhung
            the paper onto the viewport background. The Z here lifts it back
            out; the X and Y stay zero because position is set by the
            TranslateTransform below, which is a separate mechanism.
        -->
        <Border x:Name="ObjectToolbar" Grid.Column="2" Grid.Row="1"
                Margin="22,22,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Collapsed" Canvas.ZIndex="20" Translation="0,0,32"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="3"
                SizeChanged="ObjectToolbar_SizeChanged">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="ObjToolGroup" Content="Group" Padding="10,4"
                        Click="ObjToolGroup_Click"
                        ToolTipService.ToolTip="Group the selected objects so they move together" />
                <Button x:Name="ObjToolUngroup" Content="Ungroup" Padding="10,4"
                        Click="ObjToolUngroup_Click"
                        ToolTipService.ToolTip="Break this group apart" />
                <Rectangle Width="1" Margin="3,4" VerticalAlignment="Stretch"
                           Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Button x:Name="ObjToolBack" Content="To back" Padding="10,4"
                        Click="ObjToolBack_Click"
                        ToolTipService.ToolTip="Send behind everything else on the page" />
                <Button x:Name="ObjToolBackward" AutomationProperties.Name="Send backward one step" Content="&#x2013;1" Padding="10,4"
                        Click="ObjToolBackward_Click"
                        ToolTipService.ToolTip="Send backward one step" />
                <Button x:Name="ObjToolForward" Content="+1" Padding="10,4"
                        Click="ObjToolForward_Click"
                        ToolTipService.ToolTip="Bring forward one step" />
                <Button x:Name="ObjToolFront" Content="To front" Padding="10,4"
                        Click="ObjToolFront_Click"
                        ToolTipService.ToolTip="Bring in front of everything else on the page" />
                <Rectangle Width="1" Margin="3,4" VerticalAlignment="Stretch"
                           Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Button x:Name="ObjToolDelete" Content="Delete" Padding="10,4"
                        Click="ObjToolDelete_Click"
                        ToolTipService.ToolTip="Delete the selected objects" />
            </StackPanel>
        </Border>

        <!--
            Define's popup: the English definition of the one word the reader
            right-clicked and asked about. A reading aid, not a dialog, so it is
            small, takes no focus and no clicks (a press anywhere, on it
            included, lands on the page and puts it away), and Escape closes it.

            Placed exactly like ObjectToolbar: in the scroller's viewport space,
            with the same margin and the same lift over the page cards, by
            ObjectToolbarPlacement, so above the word or below it when there is
            no room. Pale yellow with dark text in every theme, like a sticky
            note, because it floats over paper rather than over app chrome.
        -->
        <Border x:Name="DefinitionPopup" Grid.Column="2" Grid.Row="1"
                Margin="22,22,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Collapsed" Canvas.ZIndex="20" Translation="0,0,32"
                IsHitTestVisible="False" MaxWidth="420"
                Background="#FFFFF4CE" BorderBrush="#FFE6C84F"
                BorderThickness="1" CornerRadius="8" Padding="14,10,14,12"
                AutomationProperties.Name="Definition"
                SizeChanged="DefinitionPopup_SizeChanged">
            <StackPanel Spacing="6">
                <TextBlock x:Name="DefinitionWord" FontSize="17" FontWeight="Bold"
                           Foreground="#FF3D3413" />
                <TextBlock x:Name="DefinitionText" FontSize="14" LineHeight="21"
                           TextWrapping="Wrap" Foreground="#FF4A4020" />
                <!--
                    Myanmar meanings, from the AKK dictionary, one line per part
                    of speech shown above, then Hindi meanings in the same
                    shape. TextBlocks of their own with NO fixed
                    LineHeight: both scripts stack marks above and below the
                    letter, and the 21px lines above would clip them.
                -->
                <Rectangle x:Name="DefinitionTranslationsRule" Height="1" Margin="0,2"
                           Fill="#FFE6C84F" Visibility="Collapsed" />
                <TextBlock x:Name="DefinitionMyanmar" FontSize="14"
                           TextWrapping="Wrap" Foreground="#FF4A4020"
                           Visibility="Collapsed"
                           AutomationProperties.Name="Myanmar meaning" />
                <TextBlock x:Name="DefinitionHindi" FontSize="14"
                           TextWrapping="Wrap" Foreground="#FF4A4020"
                           Visibility="Collapsed"
                           AutomationProperties.Name="Hindi meaning" />
            </StackPanel>
        </Border>

        <!--
            Empty state: what the app shows before anything is open.

            Now the FIRST thing anyone sees, because launching no longer
            conjures a blank document. So it has to name the action rather than
            describe the absence: a button that opens the picker, and the drop
            target spelled out, since nothing about a canvas says you can drop
            on it.

            THEME BRUSHES, not the hardcoded whites this used to carry. Those
            were invisible against a light canvas, and nobody noticed for
            months because a blank document always covered this up.

            Still double-tappable, which is the gesture people try on an empty
            canvas, and it is the same handler as the button.
        -->
        <Border x:Name="EmptyState" Grid.Column="2" Grid.Row="1" Background="Transparent"
                AllowDrop="True"
                DragOver="EmptyState_DragOver"
                Drop="EmptyState_Drop"
                DoubleTapped="EmptyState_DoubleTapped"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
            <!--
                The welcome screen, and the first thing anyone sees.

                Built around CONTINUING rather than starting: the recent rows
                carry where reading stopped, so the common case is one click
                back into the book you were half way through. A plain
                recent-files list would say what you opened; this says where
                you left off, which is the question you actually have.
            -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="460" Margin="24,32" Spacing="6">

                <!--
                    The PNG, not the .ico.

                    An .ico holds ten frames and the decoder guesses which one
                    to use; asking it for a size only moves the guess. The
                    300px PNG is one unambiguous bitmap that scales DOWN to
                    whatever this display needs, which is the direction that
                    stays sharp. Same artwork, no guessing.
                -->
                <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                       Width="56" Height="56" HorizontalAlignment="Center" />

                <TextBlock Text="Ayaan PDF" HorizontalAlignment="Center" Margin="0,10,0,0"
                           Foreground="{StaticResource OnCanvasStrong}"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock x:Name="WelcomeSubtitle" Text="Open a document to begin"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource OnCanvasBody}"
                           Style="{StaticResource BodyTextBlockStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0"
                            HorizontalAlignment="Center">
                    <Button x:Name="EmptyStateOpen" AutomationProperties.Name="Open a PDF" Click="EmptyStateOpen_Click"
                            Padding="18,7" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <TextBlock Text="Open a PDF" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="WelcomeNew" AutomationProperties.Name="New document" Click="WelcomeNew_Click" Padding="18,7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7C3;" FontSize="14" />
                            <TextBlock Text="New document" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--
                    Collapsed until there is something to show, so a first run
                    is a clean two-button screen rather than an empty heading
                    over an empty box.
                -->
                <StackPanel x:Name="WelcomeRecentSection" Visibility="Collapsed"
                            Margin="0,26,0,0" Spacing="6">
                    <TextBlock Text="PICK UP WHERE YOU LEFT OFF"
                               Foreground="{StaticResource OnCanvasMuted}"
                               CharacterSpacing="80"
                               Style="{StaticResource CaptionTextBlockStyle}" />

                    <ItemsControl x:Name="WelcomeRecent">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewport:WelcomeEntry">
                                <!--
                                    A button, not a list item: it is one click
                                    that does one thing, and it gets focus and
                                    keyboard activation for free.
                                -->
                                <Button Click="WelcomeRecent_Click" Tag="{x:Bind Path}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="10,8" Margin="0,1"
                                        ToolTipService.ToolTip="{x:Bind Path}"
                                        AutomationProperties.Name="{x:Bind Name}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Glyph="&#xEA90;" FontSize="16"
                                                  VerticalAlignment="Center"
                                                  Foreground="{StaticResource OnCanvasMuted}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource OnCanvasStrong}"
                                                       Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Folder}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource OnCanvasMuted}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{x:Bind Resume}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource OnCanvasBody}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="or drop a PDF anywhere in this window"
                           HorizontalAlignment="Center" Margin="0,26,0,0"
                           Foreground="{StaticResource OnCanvasMuted}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!--
            Tool rail: icons only, vertical, hugging the left edge. The tools
            stay a glanceable column the way a canvas app expects, and cost a
            fixed 44px of overlay instead of a full toolbar row of height.
        -->
        <!--
            Docked flush to the window edge, full height, rather than floating
            centred with a margin either side. A floating pill spent width on
            gaps on both sides and left the tools bobbing in the middle of the
            window with nothing to align to; docked, the rail has an edge to sit
            against and the settings button has a bottom to sit at.
        -->
        <Border x:Name="ToolRail" Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Stretch" Margin="0"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0" CornerRadius="0" Padding="4,4,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--
                    Drag handle. Dragging the rail DOCKS it to the nearer side
                    rather than leaving it floating anywhere: a floating rail
                    would sit on top of the page, which is the overlap problem
                    the column layout exists to prevent. Docking keeps it
                    movable and keeps non-overlap guaranteed by layout.
                -->
                <Border x:Name="RailGrip" Height="18" Background="Transparent"
                        ToolTipService.ToolTip="Drag to move the toolbar to the other side"
                        PointerPressed="RailGrip_PointerPressed"
                        PointerMoved="RailGrip_PointerMoved"
                        PointerReleased="RailGrip_PointerReleased"
                        PointerCaptureLost="RailGrip_PointerReleased">
                    <Rectangle Width="18" Height="3" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                </Border>
                <!--
                    VIEW / EDIT.

                    Two buttons rather than one toggle, and that is deliberate:
                    a toggle says "pressed" or "not pressed" and the reader has
                    to know which state means which. Two labelled halves with
                    one of them lit say what the app IS.

                    At the top of the rail, because the rail is what changes
                    underneath it: the two that change the document itself, the
                    text box and the hyperlink, appear under Edit and under
                    nothing else. Everything a reader marks a page with stays
                    put across both.
                -->
                <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="2" Margin="0,22,0,6">
                    <Button x:Name="ViewModeButton" Click="ViewMode_Click"
                            AutomationProperties.Name="Reading mode"
                            ToolTipService.ToolTip="Reading: read the document, and mark it up with the highlighter, pen, shapes, notes and stamps"
                            HorizontalAlignment="Stretch" Height="30" Padding="0"
                            BorderThickness="1" CornerRadius="4,4,0,0">
                        <!-- Roomier than the path's 16x14, because the box clips. -->
                        <PathIcon Data="{StaticResource OpenBookPath}" Width="17" Height="15" />
                    </Button>
                    <Button x:Name="EditModeButton" Click="EditMode_Click"
                            AutomationProperties.Name="Edit mode"
                            ToolTipService.ToolTip="Edit: change the document itself, its own text and its objects"
                            HorizontalAlignment="Stretch" Height="30" Padding="0"
                            BorderThickness="1" CornerRadius="0,0,4,4">
                        <!-- A page with a pencil ON it, not a bare pencil: the
                             app has a pen, a highlighter and shapes, so a lone
                             pencil here would read as one more drawing tool
                             rather than as "change this document". -->
                        <FontIcon Glyph="&#xE932;" FontSize="16" />
                    </Button>
                </StackPanel>

                <!--
                    The tools themselves come from ToolCatalog, one row each.

                    They used to be six hand-written buttons plus a method that
                    assigned six backgrounds by name, so adding a tool meant
                    editing three places and forgetting any one of them left a
                    tool that could not be reached or never looked armed. A
                    single-selection list also means the ARMED tool is drawn by
                    the framework's own selection visual rather than by
                    assigning brushes, which is what made the previous rail look
                    hand-made.
                -->
                <ListView x:Name="ToolRailList" Grid.Row="1" VerticalAlignment="Top"
                          ItemsSource="{x:Bind ViewModel.Tools}"
                          SelectionMode="Single"
                          SelectionChanged="ToolRail_SelectionChanged"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Padding="0" BorderThickness="0" Background="Transparent">
                    <!--
                        The chosen tool, tinted with the accent. The stock
                        selection is a faint grey square and a 3px accent
                        sliver, while Reading and Edit above are solid accent,
                        so the mode looked more "on" than the tool in use. A
                        tint rather than solid accent keeps the icons their own
                        colour: the hand and the stamp are Paths, which cannot
                        follow a selected foreground.
                    -->
                    <ListView.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.18" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.26" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.14" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Dark">
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.24" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.32" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.18" />
                                </ResourceDictionary>
                                <!-- High contrast keeps the system highlight. -->
                                <ResourceDictionary x:Key="HighContrast" />
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Width" Value="36" />
                            <Setter Property="Height" Value="36" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewport:ToolDefinition">
                            <!--
                                One ContentControl whose content is chosen per
                                tool: a FontIcon for the glyph tools, a scaled
                                Path for the ones that carry PathData. Deciding
                                in code keeps the rail data-driven, since a tool
                                still declares its own icon in its record.
                            -->
                            <ContentControl Content="{x:Bind local:MainPage.ToolIcon((viewport:ToolDefinition))}"
                                            IsTabStop="False"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind Tooltip}"
                                            AutomationProperties.Name="{x:Bind Name}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--
                    Pinned to the bottom of the rail, which is what the docked
                    full-height shape buys: these are about the app rather than
                    about a mark on the page, so they sit apart from the tools.
                -->
                <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="2" VerticalAlignment="Bottom">
                <Rectangle Height="1" Margin="6,4" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />

                <Button AutomationProperties.Name="Pages" Click="ToggleThumbnails_Click" ToolTipService.ToolTip="Pages (F4)"
                        Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE8A9;" FontSize="16" />
                </Button>

                <Button AutomationProperties.Name="Bookmarks" Click="ToggleBookmarks_Click" ToolTipService.ToolTip="Bookmarks (F6)"
                        Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0">
                    <!-- Roomier than the path's 11x15, because the box clips. -->
                    <PathIcon Data="{StaticResource BookmarkRibbonPath}" Width="12" Height="16" />
                </Button>

                <!--
                    Only shown when the open document actually has fillable
                    fields, and it draws them rather than switching anything on.
                    Filling a form needs no mode: an ordinary click operates a
                    field in View and in Edit alike.
                -->
                <ToggleButton x:Name="FillFormButton" AutomationProperties.Name="Show form fields"
                              ToolTipService.ToolTip="Show form fields"
                              Visibility="{x:Bind ViewModel.FillFormButtonVisibility, Mode=OneWay}"
                              IsChecked="{x:Bind ViewModel.ShowFormFields, Mode=TwoWay}"
                              Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE762;" FontSize="16" />
                </ToggleButton>

                <Button AutomationProperties.Name="Settings" Click="Settings_Click" ToolTipService.ToolTip="Settings"
                        Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            Property bar: the options belonging to the ARMED tool, and nothing
            else.

            These controls used to live behind a second button in the rail, in
            a flyout, which is two clicks to change a colour and no way to see
            the current one without opening it. Sitting them above the canvas
            makes the state of the tool readable at a glance and each change one
            click, the way an options bar works in a drawing app.

            Which sections appear is decided by the tool's ToolOptions, so a
            tool declares what it offers in one record rather than here.

            Docked in its own row above the rulers; it used to float over the
            top of the page and cover what was there. The row is taken only
            while the bar has something to show, at one fixed height for every
            tool. For a tool with no options it is collapsed and the page gets
            the space.
        -->
        <Border x:Name="PropertyBar" Grid.Column="2" Visibility="Collapsed"
                MinHeight="44" Padding="8,4"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                SizeChanged="PropertyBar_SizeChanged"
                AutomationProperties.Name="Tool options">
            <!--
                One row whenever it fits. Row 1 carries the general sections
                (colour, width, shape, size), row 2 the rest (font, text style,
                opacity, stamps). On a window too narrow for both side by side,
                FitPropertyBar stacks them rather than let the last controls
                fall off the edge.
            -->
            <StackPanel x:Name="PropertyBarRows" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
            <StackPanel x:Name="PropertyBarRow1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" HorizontalAlignment="Left">

                <TextBlock x:Name="PropertyBarToolName" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />

                <!-- Colour -->
                <StackPanel x:Name="ColorSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <ListView x:Name="ColorChoices" SelectionMode="Single"
                              SelectionChanged="InkColor_SelectionChanged"
                              Padding="0" BorderThickness="0" Background="Transparent"
                              AutomationProperties.Name="Colour"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Width" Value="30" />
                                <Setter Property="Height" Value="30" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="1,0" />
                                <Setter Property="CornerRadius" Value="15" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewport:InkColor">
                                <!-- Inset from the 30px container so the
                                     selection ring around it stays visible. -->
                                <Border Width="20" Height="20" CornerRadius="10"
                                        ToolTipService.ToolTip="{x:Bind Name}"
                                        AutomationProperties.Name="{x:Bind Name}"
                                        Background="{x:Bind local:MainPage.HexBrush(Hex)}"
                                        BorderBrush="#66000000" BorderThickness="1" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--
                        Custom colour. The swatch always shows the tool's CURRENT
                        colour, so it doubles as the "you are here" indicator when
                        the chosen colour is not one of the presets. Clicking it
                        opens a full picker, so the presets are the common path and
                        any colour is one click further.
                    -->
                    <Button x:Name="CustomColorButton" Width="30" Height="30" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Custom colour"
                            ToolTipService.ToolTip="Custom colour">
                        <Grid Width="22" Height="22">
                            <Ellipse Stroke="#66000000" StrokeThickness="1">
                                <Ellipse.Fill>
                                    <!-- A hue ring, so the button reads as "pick any colour". -->
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFE00000" Offset="0.0" />
                                        <GradientStop Color="#FFF5B800" Offset="0.25" />
                                        <GradientStop Color="#FF2E9E3B" Offset="0.5" />
                                        <GradientStop Color="#FF1565C0" Offset="0.75" />
                                        <GradientStop Color="#FF7B1FA2" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <!-- The inner dot is the current colour. -->
                            <Ellipse x:Name="CustomColorSwatch" Width="11" Height="11"
                                     Stroke="#88FFFFFF" StrokeThickness="1" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="CustomColorFlyout" Placement="Bottom"
                                    Opening="CustomColorFlyout_Opening">
                                <ColorPicker x:Name="CustomColorPicker"
                                             IsAlphaEnabled="False"
                                             IsMoreButtonVisible="True"
                                             ColorSpectrumShape="Box"
                                             Width="280"
                                             ColorChanged="CustomColor_Changed" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- Width -->
                <StackPanel x:Name="WidthSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <ListView x:Name="WidthChoices" SelectionMode="Single"
                              SelectionChanged="InkWidth_SelectionChanged"
                              Padding="0" BorderThickness="0" Background="Transparent"
                              AutomationProperties.Name="Stroke width"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Width" Value="34" />
                                <Setter Property="Height" Value="30" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="1,0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewport:InkWidth">
                                <!-- The width itself is the label: a row of
                                     names would say less and take more room. -->
                                <Rectangle Width="20" RadiusX="4" RadiusY="4"
                                           VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind Name}"
                                           AutomationProperties.Name="{x:Bind Name}"
                                           Height="{x:Bind local:MainPage.WidthPreview(Value)}"
                                           Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!--
                    WHICH MARK the highlighter makes.

                    Drawn as real geometry for the same reason the shape picker
                    below is: each row shows the mark it makes over a word of
                    sample text, so a wash, a rule under and a rule through
                    cannot be confused or drift from what is actually drawn.

                    One row in the rail, three marks here, because all three are
                    the same drag over the same text.
                -->
                <StackPanel x:Name="MarkupSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <ListView x:Name="MarkupChoices" SelectionMode="Single"
                              SelectionChanged="MarkupKind_SelectionChanged"
                              Padding="0" BorderThickness="0" Background="Transparent"
                              AutomationProperties.Name="Markup"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Width" Value="34" />
                                <Setter Property="Height" Value="30" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="1,0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListViewItem Tag="Highlight" ToolTipService.ToolTip="Highlight"
                                      AutomationProperties.Name="Highlight">
                            <Grid Width="24" Height="18">
                                <Rectangle Fill="#66FFD400" RadiusX="1" RadiusY="1" />
                                <TextBlock Text="Ab" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem Tag="Underline" ToolTipService.ToolTip="Underline"
                                      AutomationProperties.Name="Underline">
                            <Grid Width="24" Height="18">
                                <TextBlock Text="Ab" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Rectangle Height="1.6" Width="18" Margin="0,0,0,1"
                                           VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                           Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem Tag="Strikeout" ToolTipService.ToolTip="Strikeout"
                                      AutomationProperties.Name="Strikeout">
                            <Grid Width="24" Height="18">
                                <TextBlock Text="Ab" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Rectangle Height="1.6" Width="18"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem Tag="Squiggly" ToolTipService.ToolTip="Squiggly"
                                      AutomationProperties.Name="Squiggly">
                            <Grid Width="24" Height="18">
                                <TextBlock Text="Ab" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Path Data="M0,3 L2,0 L4,3 L6,0 L8,3 L10,0 L12,3 L14,0 L16,3 L18,0"
                                      Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                      StrokeThickness="1.2" Margin="0,0,0,1"
                                      VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                            </Grid>
                        </ListViewItem>
                    </ListView>
                </StackPanel>

                <!--
                    Shape kind. Drawn as real geometry rather than icon-font
                    glyphs: the picker then shows exactly what each tool draws,
                    including the arrowhead, and cannot drift from it the way a
                    stand-in glyph would.
                -->
                <StackPanel x:Name="ShapeSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <ListView x:Name="ShapeChoices" SelectionMode="Single"
                              SelectionChanged="ShapeKind_SelectionChanged"
                              Padding="0" BorderThickness="0" Background="Transparent"
                              AutomationProperties.Name="Shape"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Width" Value="34" />
                                <Setter Property="Height" Value="30" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="1,0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListViewItem Tag="Rectangle" ToolTipService.ToolTip="Rectangle"
                                      AutomationProperties.Name="Rectangle">
                            <Rectangle Width="20" Height="14" RadiusX="1" RadiusY="1"
                                       Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                       StrokeThickness="1.5" />
                        </ListViewItem>
                        <ListViewItem Tag="Ellipse" ToolTipService.ToolTip="Ellipse"
                                      AutomationProperties.Name="Ellipse">
                            <Ellipse Width="20" Height="14"
                                     Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                     StrokeThickness="1.5" />
                        </ListViewItem>
                        <ListViewItem Tag="Line" ToolTipService.ToolTip="Line"
                                      AutomationProperties.Name="Line">
                            <Line X1="0" Y1="14" X2="20" Y2="0"
                                  Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                  StrokeThickness="1.5" />
                        </ListViewItem>
                        <ListViewItem Tag="Arrow" ToolTipService.ToolTip="Arrow"
                                      AutomationProperties.Name="Arrow">
                            <!--
                                Built the same way the tool draws: a shaft that
                                STOPS at the head, plus a solid triangle. The
                                first version was a hand-drawn polyline whose
                                barbs came out as a stray tick, which is what an
                                icon made by eye instead of from the geometry
                                gets you.
                            -->
                            <Grid Width="20" Height="14">
                                <Line X1="1" Y1="13" X2="13.2" Y2="4.9"
                                      Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" />
                                <Polygon Points="19,1 14.8,7.3 11.6,2.5"
                                         Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </ListViewItem>
                        <!--
                            APPENDED, not inserted. SetToolSections selects by
                            `SelectedIndex = (int)ActiveShapeKind`, so an item
                            placed anywhere but last would put every kind after
                            it out of step with its enum value.

                            RadiusX/Y 4 against the plain Rectangle icon's 1, so
                            the two are told apart at 20x14.
                        -->
                        <ListViewItem Tag="RoundedRectangle" ToolTipService.ToolTip="Rounded rectangle"
                                      AutomationProperties.Name="Rounded rectangle">
                            <Rectangle Width="20" Height="14" RadiusX="4" RadiusY="4"
                                       Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                       StrokeThickness="1.5" />
                        </ListViewItem>
                    </ListView>
                </StackPanel>

                <!-- Font size -->
                <StackPanel x:Name="FontSizeSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <FontIcon Glyph="&#xE8E9;" FontSize="13" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              ToolTipService.ToolTip="Font size" />
                    <ListView x:Name="FontSizeChoices" SelectionMode="Single"
                              SelectionChanged="FontSize_SelectionChanged"
                              Padding="0" BorderThickness="0" Background="Transparent"
                              AutomationProperties.Name="Font size"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Height" Value="30" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="Margin" Value="1,0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewport:FontSize">
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"
                                           AutomationProperties.Name="{x:Bind Name}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

            </StackPanel>
            <!-- Row 2: font, text style, opacity, stamps. -->
            <StackPanel x:Name="PropertyBarRow2" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" HorizontalAlignment="Left">

                <!-- Font family + bold/italic/underline/strikethrough. Unicode:
                     pick any installed font (including a local-language one). -->
                <StackPanel x:Name="FontSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <ComboBox x:Name="FontFamilyCombo" Width="164" Height="30" Padding="8,0"
                              PlaceholderText="Default font"
                              SelectionChanged="FontFamily_SelectionChanged"
                              ItemsSource="{x:Bind ViewModel.FontFamilies, Mode=OneWay}"
                              ToolTipService.ToolTip="Font"
                              AutomationProperties.Name="Font">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewport:FontFamily">
                                <TextBlock Text="{x:Bind Name}"
                                           FontFamily="{x:Bind Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ToggleButton x:Name="BoldBtn" Click="Bold_Click"
                                  Width="30" Height="30" Padding="0"
                                  AutomationProperties.Name="Bold"
                                  ToolTipService.ToolTip="Bold">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="15" />
                    </ToggleButton>
                    <ToggleButton x:Name="ItalicBtn" Click="Italic_Click"
                                  Width="30" Height="30" Padding="0"
                                  AutomationProperties.Name="Italic"
                                  ToolTipService.ToolTip="Italic">
                        <TextBlock Text="I" FontStyle="Italic" FontSize="15" FontFamily="Georgia" />
                    </ToggleButton>
                    <ToggleButton x:Name="UnderlineBtn" Click="Underline_Click"
                                  Width="30" Height="30" Padding="0"
                                  AutomationProperties.Name="Underline"
                                  ToolTipService.ToolTip="Underline">
                        <TextBlock Text="U" FontSize="15" TextDecorations="Underline" />
                    </ToggleButton>
                    <ToggleButton x:Name="StrikethroughBtn" Click="Strikethrough_Click"
                                  Width="30" Height="30" Padding="0"
                                  AutomationProperties.Name="Strikethrough"
                                  ToolTipService.ToolTip="Strikethrough">
                        <TextBlock Text="S" FontSize="15" TextDecorations="Strikethrough" />
                    </ToggleButton>
                </StackPanel>

                <!-- Text alignment, fill and outline -->
                <StackPanel x:Name="TextStyleSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />

                    <!-- Alignment: one of four, radio-style. Text-only; hidden
                         when TextStyleSection is showing for a shape (which
                         has no text alignment to speak of). -->
                    <StackPanel x:Name="TextAlignRow" Orientation="Horizontal" Spacing="1">
                        <ToggleButton x:Name="AlignLeftBtn" Tag="Left" Click="Align_Click"
                                      Width="30" Height="30" Padding="0"
                                      AutomationProperties.Name="Align left"
                                      ToolTipService.ToolTip="Align left">
                            <FontIcon Glyph="&#xE8E4;" FontSize="14" />
                        </ToggleButton>
                        <ToggleButton x:Name="AlignCenterBtn" Tag="Center" Click="Align_Click"
                                      Width="30" Height="30" Padding="0"
                                      AutomationProperties.Name="Center"
                                      ToolTipService.ToolTip="Center">
                            <FontIcon Glyph="&#xE8E3;" FontSize="14" />
                        </ToggleButton>
                        <ToggleButton x:Name="AlignRightBtn" Tag="Right" Click="Align_Click"
                                      Width="30" Height="30" Padding="0"
                                      AutomationProperties.Name="Align right"
                                      ToolTipService.ToolTip="Align right">
                            <FontIcon Glyph="&#xE8E2;" FontSize="14" />
                        </ToggleButton>
                        <ToggleButton x:Name="AlignJustifyBtn" Tag="Justify" Click="Align_Click"
                                      Width="30" Height="30" Padding="0"
                                      AutomationProperties.Name="Justify"
                                      ToolTipService.ToolTip="Justify">
                            <!-- No Segoe glyph reads as justify, so it is drawn:
                                 four full, equal lines. -->
                            <StackPanel Spacing="2.5" VerticalAlignment="Center">
                                <Rectangle Width="16" Height="1.6" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Rectangle Width="16" Height="1.6" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Rectangle Width="16" Height="1.6" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Rectangle Width="16" Height="1.6" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />

                    <!-- Fill -->
                    <Button x:Name="FillButton" Width="30" Height="30" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Fill colour"
                            ToolTipService.ToolTip="Fill">
                        <Grid Width="20" Height="20">
                            <Border x:Name="FillSwatch" CornerRadius="4"
                                    BorderBrush="#66000000" BorderThickness="1" />
                            <!-- Diagonal shown when there is no fill. -->
                            <Line x:Name="FillNoneSlash" X1="2" Y1="18" X2="18" Y2="2"
                                  Stroke="#C0D13438" StrokeThickness="1.5" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="FillFlyout" Placement="Bottom" Opening="FillFlyout_Opening">
                                <StackPanel Spacing="6" Width="272">
                                    <TextBlock Text="Standard colours" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <!-- Row 1: neutrals + warm -->
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button AutomationProperties.Name="Black" ToolTipService.ToolTip="Black" Width="28" Height="28" Padding="0" Background="#FF000000" Tag="#FF000000" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Dark grey" ToolTipService.ToolTip="Dark grey" Width="28" Height="28" Padding="0" Background="#FF404040" Tag="#FF404040" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Grey" ToolTipService.ToolTip="Grey" Width="28" Height="28" Padding="0" Background="#FF808080" Tag="#FF808080" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Light grey" ToolTipService.ToolTip="Light grey" Width="28" Height="28" Padding="0" Background="#FFC0C0C0" Tag="#FFC0C0C0" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="White" ToolTipService.ToolTip="White" Width="28" Height="28" Padding="0" Background="#FFFFFFFF" Tag="#FFFFFFFF" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Red" ToolTipService.ToolTip="Red" Width="28" Height="28" Padding="0" Background="#FFD13438" Tag="#FFD13438" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Orange" ToolTipService.ToolTip="Orange" Width="28" Height="28" Padding="0" Background="#FFF7630C" Tag="#FFF7630C" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Amber" ToolTipService.ToolTip="Amber" Width="28" Height="28" Padding="0" Background="#FFFFB900" Tag="#FFFFB900" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                    </StackPanel>
                                    <!-- Row 2: cool + tints -->
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button AutomationProperties.Name="Green" ToolTipService.ToolTip="Green" Width="28" Height="28" Padding="0" Background="#FF107C10" Tag="#FF107C10" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Teal" ToolTipService.ToolTip="Teal" Width="28" Height="28" Padding="0" Background="#FF00B7C3" Tag="#FF00B7C3" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Blue" ToolTipService.ToolTip="Blue" Width="28" Height="28" Padding="0" Background="#FF0078D4" Tag="#FF0078D4" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Purple" ToolTipService.ToolTip="Purple" Width="28" Height="28" Padding="0" Background="#FF8764B8" Tag="#FF8764B8" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Magenta" ToolTipService.ToolTip="Magenta" Width="28" Height="28" Padding="0" Background="#FFE3008C" Tag="#FFE3008C" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Brown" ToolTipService.ToolTip="Brown" Width="28" Height="28" Padding="0" Background="#FF7A4200" Tag="#FF7A4200" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Pale yellow" ToolTipService.ToolTip="Pale yellow" Width="28" Height="28" Padding="0" Background="#FFFFF4CE" Tag="#FFFFF4CE" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Pale green" ToolTipService.ToolTip="Pale green" Width="28" Height="28" Padding="0" Background="#FFDFF6DD" Tag="#FFDFF6DD" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                    </StackPanel>
                                    <Button Content="No fill" HorizontalAlignment="Stretch" Click="NoFill_Click" />
                                    <Expander Header="Custom colour" HorizontalAlignment="Stretch" IsExpanded="False">
                                        <ColorPicker x:Name="FillPicker" IsAlphaEnabled="False"
                                                     IsMoreButtonVisible="True" ColorSpectrumShape="Box"
                                                     Width="256" ColorChanged="FillColor_Changed" />
                                    </Expander>

                                    <!-- Gradient. A FILL, not an effect: it is what the
                                         inside of the shape is painted with, so it lives
                                         beside the solid colours it replaces. -->
                                    <Button x:Name="GradientOpenButton" Content="Gradient…"
                                            HorizontalAlignment="Stretch" Height="30" FontSize="12"
                                            AutomationProperties.Name="Open the gradient panel"
                                            ToolTipService.ToolTip="Opens a movable panel, so the shape stays visible while you set the gradient"
                                            Click="GradientOpen_Click" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Outline -->
                    <Button x:Name="OutlineButton" Width="30" Height="30" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Outline colour"
                            ToolTipService.ToolTip="Outline">
                        <Grid Width="20" Height="20">
                            <Border x:Name="OutlineSwatch" CornerRadius="4" Background="Transparent"
                                    BorderBrush="#FF1565C0" BorderThickness="2" />
                            <Line x:Name="OutlineNoneSlash" X1="2" Y1="18" X2="18" Y2="2"
                                  Stroke="#C0D13438" StrokeThickness="1.5" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="OutlineFlyout" Placement="Bottom" Opening="OutlineFlyout_Opening">
                                <StackPanel Spacing="6" Width="272">
                                    <TextBlock Text="Standard colours" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button AutomationProperties.Name="Black" ToolTipService.ToolTip="Black" Width="28" Height="28" Padding="0" Background="#FF000000" Tag="#FF000000" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Dark grey" ToolTipService.ToolTip="Dark grey" Width="28" Height="28" Padding="0" Background="#FF404040" Tag="#FF404040" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Grey" ToolTipService.ToolTip="Grey" Width="28" Height="28" Padding="0" Background="#FF808080" Tag="#FF808080" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Light grey" ToolTipService.ToolTip="Light grey" Width="28" Height="28" Padding="0" Background="#FFC0C0C0" Tag="#FFC0C0C0" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="White" ToolTipService.ToolTip="White" Width="28" Height="28" Padding="0" Background="#FFFFFFFF" Tag="#FFFFFFFF" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Red" ToolTipService.ToolTip="Red" Width="28" Height="28" Padding="0" Background="#FFD13438" Tag="#FFD13438" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Orange" ToolTipService.ToolTip="Orange" Width="28" Height="28" Padding="0" Background="#FFF7630C" Tag="#FFF7630C" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Amber" ToolTipService.ToolTip="Amber" Width="28" Height="28" Padding="0" Background="#FFFFB900" Tag="#FFFFB900" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button AutomationProperties.Name="Green" ToolTipService.ToolTip="Green" Width="28" Height="28" Padding="0" Background="#FF107C10" Tag="#FF107C10" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Teal" ToolTipService.ToolTip="Teal" Width="28" Height="28" Padding="0" Background="#FF00B7C3" Tag="#FF00B7C3" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Blue" ToolTipService.ToolTip="Blue" Width="28" Height="28" Padding="0" Background="#FF0078D4" Tag="#FF0078D4" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Purple" ToolTipService.ToolTip="Purple" Width="28" Height="28" Padding="0" Background="#FF8764B8" Tag="#FF8764B8" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Magenta" ToolTipService.ToolTip="Magenta" Width="28" Height="28" Padding="0" Background="#FFE3008C" Tag="#FFE3008C" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Brown" ToolTipService.ToolTip="Brown" Width="28" Height="28" Padding="0" Background="#FF7A4200" Tag="#FF7A4200" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Pale yellow" ToolTipService.ToolTip="Pale yellow" Width="28" Height="28" Padding="0" Background="#FFFFF4CE" Tag="#FFFFF4CE" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button AutomationProperties.Name="Pale green" ToolTipService.ToolTip="Pale green" Width="28" Height="28" Padding="0" Background="#FFDFF6DD" Tag="#FFDFF6DD" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                    </StackPanel>
                                    <TextBlock Text="Thickness" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel x:Name="ThicknessRow" Orientation="Horizontal" Spacing="4">
                                        <RadioButton x:Name="Thickness1" GroupName="OutlineThickness" Content="1 pt" Tag="1" Click="OutlineThickness_Click" MinWidth="0" Padding="8,2" />
                                        <RadioButton x:Name="Thickness2" GroupName="OutlineThickness" Content="2 pt" Tag="2" Click="OutlineThickness_Click" MinWidth="0" Padding="8,2" />
                                        <RadioButton x:Name="Thickness3" GroupName="OutlineThickness" Content="3 pt" Tag="3" Click="OutlineThickness_Click" MinWidth="0" Padding="8,2" />
                                        <RadioButton x:Name="Thickness5" GroupName="OutlineThickness" Content="5 pt" Tag="5" Click="OutlineThickness_Click" MinWidth="0" Padding="8,2" />
                                    </StackPanel>
                                    <Button Content="No outline" HorizontalAlignment="Stretch" Click="NoOutline_Click" />
                                    <Expander Header="Custom colour" HorizontalAlignment="Stretch" IsExpanded="False">
                                        <ColorPicker x:Name="OutlinePicker" IsAlphaEnabled="False"
                                                     IsMoreButtonVisible="True" ColorSpectrumShape="Box"
                                                     Width="256" ColorChanged="OutlineColor_Changed" />
                                    </Expander>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- Opacity: stroke on the left, an optional fill slider on
                     the right (visible only when the selected object HAS a
                     fill - a filled shape today, potentially a text box's
                     fill tomorrow). Two sliders means the labels stop being
                     optional: "Opacity" and "Fill opacity" precede each so a
                     user doesn't have to guess which they are dragging. The
                     first said "Stroke", and beside the line widths it read
                     as a thickness. -->
                <StackPanel x:Name="OpacitySection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <TextBlock Text="Opacity" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <!--
                        Maximum BEFORE Minimum, and that is not cosmetic: XAML
                        assigns attributes in written order, and a Minimum above
                        the Maximum in force at that moment is rejected outright.
                        Written the other way round this threw a XamlParseException
                        from InitializeComponent and the app died at startup with
                        nothing but a hex code on screen.

                        ValueChanged is attached LAST for the same reason: setting
                        Minimum coerces Value up to it, and a handler already
                        wired would take that for the user choosing 10% and
                        rewrite the tool's colour before the app had even loaded.
                    -->
                    <Slider x:Name="OpacitySlider" Width="88" Maximum="100" Minimum="10"
                            StepFrequency="5" TickFrequency="10"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Opacity"
                            ToolTipService.ToolTip="Opacity"
                            ValueChanged="Opacity_ValueChanged" />
                    <TextBlock x:Name="OpacityReadout" VerticalAlignment="Center" MinWidth="34"
                               TextAlignment="Right"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />

                    <!-- Fill opacity: separate slider so a user can dim just
                         the fill (keep the outline crisp) or vice versa.
                         Collapsed until the selection actually has a fill. -->
                    <StackPanel x:Name="FillOpacitySection" Orientation="Horizontal"
                                Spacing="6" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                                   Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <TextBlock Text="Fill opacity" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="FillOpacitySlider" Width="88" Maximum="100" Minimum="10"
                                StepFrequency="5" TickFrequency="10"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Fill opacity"
                                ToolTipService.ToolTip="Fill opacity"
                                ValueChanged="FillOpacity_ValueChanged" />
                        <TextBlock x:Name="FillOpacityReadout" VerticalAlignment="Center" MinWidth="34"
                                   TextAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>

                    <!-- Corner radius. Only meaningful for a rounded rectangle,
                         so it is collapsed for every other kind rather than sat
                         there doing nothing. A PERCENTAGE of the roundest the
                         box can be, not an absolute measurement: the control
                         then means the same thing on a small badge and a
                         full-page box, and it survives a resize. -->
                    <StackPanel x:Name="CornerRadiusSection" Orientation="Horizontal"
                                Spacing="6" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                                   Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <TextBlock Text="Corners" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="CornerRadiusSlider" Width="88" Maximum="100" Minimum="0"
                                StepFrequency="5" TickFrequency="25"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Corner radius"
                                ToolTipService.ToolTip="Corner radius (0 is square)"
                                ValueChanged="CornerRadius_ValueChanged" />
                        <TextBlock x:Name="CornerRadiusReadout" VerticalAlignment="Center" MinWidth="34"
                                   TextAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- Align + distribute. Shown only when 2+ annotations are selected. -->
                <StackPanel x:Name="AlignSection" Orientation="Horizontal" Spacing="3"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Button AutomationProperties.Name="Align left edges" Width="28" Height="28" Padding="0" Tag="Left" Click="AlignObjects_Click"
                            ToolTipService.ToolTip="Align left edges">
                        <FontIcon Glyph="&#xE8E4;" FontSize="14" />
                    </Button>
                    <Button AutomationProperties.Name="Align horizontal centres" Width="28" Height="28" Padding="0" Tag="CenterH" Click="AlignObjects_Click"
                            ToolTipService.ToolTip="Align horizontal centres">
                        <FontIcon Glyph="&#xE8E3;" FontSize="14" />
                    </Button>
                    <Button AutomationProperties.Name="Align right edges" Width="28" Height="28" Padding="0" Tag="Right" Click="AlignObjects_Click"
                            ToolTipService.ToolTip="Align right edges">
                        <FontIcon Glyph="&#xE8E2;" FontSize="14" />
                    </Button>
                    <Rectangle Width="1" Height="14" VerticalAlignment="Center"
                               Margin="2,0" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <!-- Vertical alignment icons: the same three Fluent align glyphs used above
                         for horizontal, ROTATED 90 degrees. Same visual language, different axis. -->
                    <Button AutomationProperties.Name="Align top edges" Width="28" Height="28" Padding="0" Tag="Top" Click="AlignObjects_Click"
                            ToolTipService.ToolTip="Align top edges">
                        <FontIcon Glyph="&#xE8E4;" FontSize="14"
                                  RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform Angle="90" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                    <Button AutomationProperties.Name="Align vertical centres" Width="28" Height="28" Padding="0" Tag="MiddleV" Click="AlignObjects_Click"
                            ToolTipService.ToolTip="Align vertical centres">
                        <FontIcon Glyph="&#xE8E3;" FontSize="14"
                                  RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform Angle="90" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                    <Button AutomationProperties.Name="Align bottom edges" Width="28" Height="28" Padding="0" Tag="Bottom" Click="AlignObjects_Click"
                            ToolTipService.ToolTip="Align bottom edges">
                        <FontIcon Glyph="&#xE8E2;" FontSize="14"
                                  RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform Angle="90" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                    <Rectangle Width="1" Height="14" VerticalAlignment="Center"
                               Margin="2,0" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Button AutomationProperties.Name="Distribute horizontally (3+ objects)" Width="28" Height="28" Padding="0" Tag="H" Click="Distribute_Click"
                            ToolTipService.ToolTip="Distribute horizontally (3+ objects)">
                        <TextBlock Text="↔" FontSize="14" HorizontalAlignment="Center" />
                    </Button>
                    <Button AutomationProperties.Name="Distribute vertically (3+ objects)" Width="28" Height="28" Padding="0" Tag="V" Click="Distribute_Click"
                            ToolTipService.ToolTip="Distribute vertically (3+ objects)">
                        <TextBlock Text="↕" FontSize="14" HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>

                <!--
                    Stamps, in two labelled rows.

                    The built-ins and the user's own PNGs are different kinds of
                    thing: one set is always there and cannot be deleted, the
                    other is a folder they control. A single merged strip gave
                    no way to tell at a glance which was which, or which the
                    Add and Open-folder buttons act on.
                -->
                <StackPanel x:Name="StampSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />

                    <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">

                    <!-- Built-in -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Built-in" Width="58" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <ListView x:Name="BuiltInStampChoices" SelectionMode="Single"
                                  SelectionChanged="BuiltInStampChoice_SelectionChanged"
                                  Padding="0" BorderThickness="0" Background="Transparent"
                                  AutomationProperties.Name="Built-in stamp"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollMode="Enabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <!-- Wider than the PNG tiles because a stamp is
                                     wide: at 40px APPROVED would be a smear. -->
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Width" Value="96" />
                                    <Setter Property="Height" Value="42" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="1,0" />
                                    <Setter Property="CornerRadius" Value="6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewport:BuiltInStamp">
                                    <Image Width="90" Height="36" Stretch="Uniform"
                                           ToolTipService.ToolTip="{x:Bind Label}"
                                           AutomationProperties.Name="{x:Bind Id}"
                                           Source="{x:Bind local:MainPage.BuiltInStampThumbnail(Id)}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- The user's own -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="My stamps" Width="58" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="StampEmptyHint" Text="No stamps yet"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <ListView x:Name="StampChoices" SelectionMode="Single"
                              SelectionChanged="StampChoice_SelectionChanged"
                              Padding="0" BorderThickness="0" Background="Transparent"
                              AutomationProperties.Name="Stamp"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Width" Value="52" />
                                <Setter Property="Height" Value="42" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="1,0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:StampEntry">
                                <Image Width="44" Height="36" Stretch="Uniform"
                                       ToolTipService.ToolTip="{x:Bind Name}"
                                       AutomationProperties.Name="{x:Bind Name}"
                                       Source="{x:Bind local:MainPage.StampThumbnail(Path)}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Click="AddStamp_Click" Width="30" Height="30" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Add a stamp"
                            ToolTipService.ToolTip="Add a PNG stamp">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                    </Button>
                    <Button Click="OpenStampFolder_Click" Width="30" Height="30" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Open the stamp folder"
                            ToolTipService.ToolTip="Open the stamp folder">
                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                    </Button>
                    </StackPanel>

                    </StackPanel>
                </StackPanel>

                <!--
                    Effects: ONE section, holding a ROW per effect.

                    A flyout rather than inline controls, the same escape hatch
                    FillButton and OutlineButton already take: a drop shadow
                    alone wants about six controls and this bar must never
                    scroll. Adding a glow later puts another row inside
                    EffectRows and changes nothing out here, which is the whole
                    reason this is a container and not a control.

                    EffectRows is empty until the Drop Shadow row lands.
                -->
                <StackPanel x:Name="EffectsSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <DropDownButton x:Name="EffectsButton" Height="28" Padding="10,0"
                                    AutomationProperties.Name="Effects"
                                    ToolTipService.ToolTip="Effects">
                        <TextBlock Text="Effects" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <DropDownButton.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel x:Name="EffectRows" Orientation="Vertical"
                                            Spacing="8" MinWidth="268">

                                    <!--
                                        The Drop Shadow ROW. Adding a glow later
                                        puts a second block in here and touches
                                        nothing outside this flyout.
                                    -->
                                    <StackPanel Spacing="8">
                                        <ToggleSwitch x:Name="ShadowToggle" Header="Drop shadow"
                                                      OnContent="On" OffContent="Off"
                                                      Toggled="Shadow_Toggled" />

                                        <StackPanel x:Name="ShadowControls" Spacing="8">
                                            <TextBlock Text="Light direction" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <!--
                                                Eight presets as a compass, the centre left empty.
                                                Tag is the angle the LIGHT comes from, counter-clockwise
                                                from due east, so the shadow falls the opposite way.
                                            -->
                                            <Grid ColumnSpacing="3" RowSpacing="3" HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Button AutomationProperties.Name="Lit from the upper left" Grid.Row="0" Grid.Column="0" Width="30" Height="30" Padding="0" Tag="135" Click="ShadowDirection_Click" ToolTipService.ToolTip="Lit from the upper left"><TextBlock Text="&#x2196;" /></Button>
                                                <Button AutomationProperties.Name="Lit from above" Grid.Row="0" Grid.Column="1" Width="30" Height="30" Padding="0" Tag="90" Click="ShadowDirection_Click" ToolTipService.ToolTip="Lit from above"><TextBlock Text="&#x2191;" /></Button>
                                                <Button AutomationProperties.Name="Lit from the upper right" Grid.Row="0" Grid.Column="2" Width="30" Height="30" Padding="0" Tag="45" Click="ShadowDirection_Click" ToolTipService.ToolTip="Lit from the upper right"><TextBlock Text="&#x2197;" /></Button>
                                                <Button AutomationProperties.Name="Lit from the left" Grid.Row="1" Grid.Column="0" Width="30" Height="30" Padding="0" Tag="180" Click="ShadowDirection_Click" ToolTipService.ToolTip="Lit from the left"><TextBlock Text="&#x2190;" /></Button>
                                                <Button AutomationProperties.Name="Lit from the right" Grid.Row="1" Grid.Column="2" Width="30" Height="30" Padding="0" Tag="0" Click="ShadowDirection_Click" ToolTipService.ToolTip="Lit from the right"><TextBlock Text="&#x2192;" /></Button>
                                                <Button AutomationProperties.Name="Lit from the lower left" Grid.Row="2" Grid.Column="0" Width="30" Height="30" Padding="0" Tag="225" Click="ShadowDirection_Click" ToolTipService.ToolTip="Lit from the lower left"><TextBlock Text="&#x2199;" /></Button>
                                                <Button AutomationProperties.Name="Lit from below" Grid.Row="2" Grid.Column="1" Width="30" Height="30" Padding="0" Tag="270" Click="ShadowDirection_Click" ToolTipService.ToolTip="Lit from below"><TextBlock Text="&#x2193;" /></Button>
                                                <Button AutomationProperties.Name="Lit from the lower right" Grid.Row="2" Grid.Column="2" Width="30" Height="30" Padding="0" Tag="315" Click="ShadowDirection_Click" ToolTipService.ToolTip="Lit from the lower right"><TextBlock Text="&#x2198;" /></Button>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Angle" VerticalAlignment="Center" MinWidth="52" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <NumberBox x:Name="ShadowAngleBox" Width="120"
                                                           Minimum="0" Maximum="359" SmallChange="5"
                                                           SpinButtonPlacementMode="Compact"
                                                           AutomationProperties.Name="Light angle in degrees"
                                                           ValueChanged="ShadowAngle_ValueChanged" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Distance" VerticalAlignment="Center" MinWidth="52" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Slider x:Name="ShadowDistanceSlider" Width="126"
                                                        Maximum="30" Minimum="0" StepFrequency="1"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="Shadow distance in points"
                                                        ValueChanged="Shadow_ValueChanged" />
                                                <TextBlock x:Name="ShadowDistanceReadout" VerticalAlignment="Center"
                                                           MinWidth="30" TextAlignment="Right" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Blur" VerticalAlignment="Center" MinWidth="52" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Slider x:Name="ShadowBlurSlider" Width="126"
                                                        Maximum="18" Minimum="0" StepFrequency="1"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="Shadow blur in points"
                                                        ValueChanged="Shadow_ValueChanged" />
                                                <TextBlock x:Name="ShadowBlurReadout" VerticalAlignment="Center"
                                                           MinWidth="30" TextAlignment="Right" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Opacity" VerticalAlignment="Center" MinWidth="52" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Slider x:Name="ShadowOpacitySlider" Width="126"
                                                        Maximum="100" Minimum="10" StepFrequency="5"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="Shadow opacity"
                                                        ValueChanged="Shadow_ValueChanged" />
                                                <TextBlock x:Name="ShadowOpacityReadout" VerticalAlignment="Center"
                                                           MinWidth="30" TextAlignment="Right" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Colour" VerticalAlignment="Center" MinWidth="52" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Border x:Name="ShadowSwatch" Width="24" Height="24" CornerRadius="4"
                                                        BorderBrush="#66000000" BorderThickness="1"
                                                        VerticalAlignment="Center" />
                                                <Button AutomationProperties.Name="Black" Width="24" Height="24" Padding="0" Background="#FF000000" Tag="#FF000000" Click="ShadowColor_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Black" />
                                                <Button AutomationProperties.Name="Dark grey" Width="24" Height="24" Padding="0" Background="#FF404040" Tag="#FF404040" Click="ShadowColor_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Dark grey" />
                                                <Button AutomationProperties.Name="Grey" Width="24" Height="24" Padding="0" Background="#FF808080" Tag="#FF808080" Click="ShadowColor_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Grey" />
                                                <Button AutomationProperties.Name="Red" Width="24" Height="24" Padding="0" Background="#FFD13438" Tag="#FFD13438" Click="ShadowColor_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Red" />
                                                <Button AutomationProperties.Name="Blue" Width="24" Height="24" Padding="0" Background="#FF0078D4" Tag="#FF0078D4" Click="ShadowColor_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Blue" />
                                                <Button AutomationProperties.Name="Green" Width="24" Height="24" Padding="0" Background="#FF107C10" Tag="#FF107C10" Click="ShadowColor_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Green" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock x:Name="ShadowNoSelectionHint"
                                                   Text="Select a shape to give it a shadow."
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />

                                    <!--
                                        The Glow ROW. A second block in the same
                                        flyout, which is what the Effects section
                                        was shaped for: it touches nothing
                                        outside these lines.

                                        The shadow's row minus direction and
                                        distance, because a glow has nowhere to
                                        fall. Same control shapes, same handler
                                        pattern, same guard.
                                    -->
                                    <StackPanel Spacing="8">
                                        <ToggleSwitch x:Name="GlowToggle" Header="Outer glow"
                                                      OnContent="On" OffContent="Off"
                                                      Toggled="Glow_Toggled" />

                                        <StackPanel x:Name="GlowControlsPanel" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Blur" VerticalAlignment="Center" MinWidth="52" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Slider x:Name="GlowBlurSlider" Width="126"
                                                        Maximum="18" Minimum="1" StepFrequency="1"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="Glow blur in points"
                                                        ValueChanged="Glow_ValueChanged" />
                                                <TextBlock x:Name="GlowBlurReadout" VerticalAlignment="Center"
                                                           MinWidth="30" TextAlignment="Right" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Opacity" VerticalAlignment="Center" MinWidth="52" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Slider x:Name="GlowOpacitySlider" Width="126"
                                                        Maximum="100" Minimum="10" StepFrequency="5"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="Glow opacity"
                                                        ValueChanged="Glow_ValueChanged" />
                                                <TextBlock x:Name="GlowOpacityReadout" VerticalAlignment="Center"
                                                           MinWidth="30" TextAlignment="Right" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Colour" VerticalAlignment="Center" MinWidth="52" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Border x:Name="GlowSwatch" Width="24" Height="24" CornerRadius="4"
                                                        BorderBrush="#66000000" BorderThickness="1"
                                                        VerticalAlignment="Center" />
                                                <Button AutomationProperties.Name="Yellow" Width="24" Height="24" Padding="0" Background="#FFFFD400" Tag="#FFFFD400" Click="GlowColor_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Yellow" />
                                                <Button AutomationProperties.Name="Orange" Width="24" Height="24" Padding="0" Background="#FFFF7A00" Tag="#FFFF7A00" Click="GlowColor_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Orange" />
                                                <Button AutomationProperties.Name="Red" Width="24" Height="24" Padding="0" Background="#FFD13438" Tag="#FFD13438" Click="GlowColor_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Red" />
                                                <Button AutomationProperties.Name="Blue" Width="24" Height="24" Padding="0" Background="#FF0078D4" Tag="#FF0078D4" Click="GlowColor_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Blue" />
                                                <Button AutomationProperties.Name="Green" Width="24" Height="24" Padding="0" Background="#FF10D070" Tag="#FF10D070" Click="GlowColor_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="Green" />
                                                <Button AutomationProperties.Name="White" Width="24" Height="24" Padding="0" Background="#FFFFFFFF" Tag="#FFFFFFFF" Click="GlowColor_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="White" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock x:Name="GlowNoSelectionHint"
                                                   Text="Select a shape to give it a glow."
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

            </StackPanel>
            </StackPanel>
        </Border>

        <!--
            Pages panel as an OVERLAY, not a permanent column, so it never
            takes width away from the canvas. Hidden until asked for.
        -->
        <Border x:Name="ThumbnailPanel" Visibility="Collapsed"
                Grid.Column="1" Grid.RowSpan="2"
                Width="{x:Bind ViewModel.ThumbnailPaneWidth, Mode=OneWay}"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    Resize grip on the panel's INNER edge (the one facing the
                    document): the right edge while docked left, flipped to the
                    left edge when the panel is moved to the right. Dragging it
                    toward the document widens the thumbnails, away narrows them.
                    A thin transparent strip, so the whole edge is grabbable.
                -->
                <Border x:Name="ThumbnailResizeGrip" Width="8" HorizontalAlignment="Right"
                        Grid.RowSpan="2" Background="Transparent" Canvas.ZIndex="2"
                        ToolTipService.ToolTip="Drag to resize, or Ctrl+scroll"
                        PointerPressed="ThumbnailResize_PointerPressed"
                        PointerMoved="ThumbnailResize_PointerMoved"
                        PointerReleased="ThumbnailResize_PointerReleased"
                        PointerCaptureLost="ThumbnailResize_PointerReleased" />

                <!-- Header: what the panel is, and how many pages, with a hint
                     that they can be dragged. -->
                <Grid Padding="14,10,10,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Pages" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.PageCount, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>

                <ListView
                Grid.Row="1"
                x:Name="ThumbnailList"
                SelectionMode="Extended"
                SelectionChanged="ThumbnailList_SelectionChanged"
                PointerWheelChanged="ThumbnailList_PointerWheelChanged"
                Padding="8,0,8,8"
                ItemsSource="{x:Bind ViewModel.Thumbnails}"
                CanReorderItems="True"
                CanDragItems="True"
                AllowDrop="True"
                DragItemsCompleted="ThumbnailList_DragItemsCompleted"
                ContainerContentChanging="ThumbnailList_ContainerContentChanging">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:PageThumbnail">
                        <StackPanel Spacing="4" Margin="0,0,0,12" Width="{x:Bind CardWidth, Mode=OneWay}">
                            <!--
                                Right-click a page for the actions drag cannot do:
                                rotate, duplicate, delete, and a keyboard-free
                                nudge up or down.
                            -->
                            <StackPanel.ContextFlyout>
                                <!-- Tagged commands act on every chosen page when the
                                     page right-clicked is one of several chosen, and
                                     PageMenu_Opening names them for how many. -->
                                <MenuFlyout Opening="PageMenu_Opening">
                                    <MenuFlyoutItem Text="Rotate 90&#176;" Tag="Rotate" Click="PageRotate_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7AD;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Rotate pages..." Click="PageRotateDialog_Click" />
                                    <MenuFlyoutItem Text="Duplicate" Tag="Duplicate" Click="PageDuplicate_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Insert blank page after" Click="PageInsertBlankAfter_Click" />
                                    <MenuFlyoutItem Text="Extract page..." Tag="Extract" Click="PageExtract_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Move up" Tag="MoveUp" Click="PageMoveUp_Click" />
                                    <MenuFlyoutItem Text="Move down" Tag="MoveDown" Click="PageMoveDown_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Delete page" Tag="Delete" Click="PageDelete_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <!-- The page sits on a rounded, shadowed card so it
                                 reads as a sheet, with its number as a small
                                 badge in the corner rather than a line of text
                                 below, which is tidier and saves height. -->
                            <Grid>
                                <Border CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        Background="{StaticResource PageSheetBrush}">
                                    <Border.Shadow>
                                        <ThemeShadow />
                                    </Border.Shadow>
                                    <Image
                                        Source="{x:Bind Bitmap, Mode=OneWay}"
                                        Stretch="Uniform"
                                        RenderTransformOrigin="0.5,0.5"
                                        Width="{x:Bind ImageWidth, Mode=OneWay}"
                                        Height="{x:Bind ImageHeight, Mode=OneWay}">
                                        <Image.RenderTransform>
                                            <RotateTransform Angle="{x:Bind ViewRotation, Mode=OneWay}" />
                                        </Image.RenderTransform>
                                    </Image>
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,4,4" CornerRadius="8" Padding="6,1"
                                        Background="#B0000000">
                                    <TextBlock Text="{x:Bind DisplayNumber}"
                                               Foreground="White" FontSize="11" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!--
            The document's own outline. Shares the slot with the pages panel
            rather than taking a second one: both are ways of navigating the
            same document, only one is wanted at a time, and two side by side
            would leave the page itself squeezed into what is left.
        -->
        <Border x:Name="BookmarkPanel" Visibility="Collapsed"
                Grid.Column="1" Grid.RowSpan="2" Width="260"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="14,10,10,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bookmarks" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0"
                               Text="{x:Bind ViewModel.Bookmarks.Count, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <!--
                            The one a reader reaches for first: mark the page in
                            front of them. It was the gap under the two bulk
                            features, which can only build an outline from
                            scratch and replace whatever was there.
                        -->
                        <Button AutomationProperties.Name="Add a bookmark here, named after the selected text" Click="AddBookmark_Click"
                                Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Add a bookmark here, named after the selected text (Ctrl+B)">
                            <!-- Roomier than the path's 17.5x13, because the box clips. -->
                            <PathIcon Data="{StaticResource BookmarkAddPath}" Width="19" Height="14" />
                        </Button>
                        <!--
                            One button, because there is one question: make me
                            an outline. HOW to describe a heading is a choice
                            inside the dialog, not a choice of which dialog to
                            open. Two buttons that looked alike and answered the
                            same question meant whichever you picked, you had to
                            close it to try the other.
                        -->
                        <Button AutomationProperties.Name="Create bookmarks from the document's headings" Click="StyleBookmarks_Click"
                                Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Create bookmarks from the document's headings">
                            <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--
                    Says so when the file has no outline. An empty list would
                    look like a panel that failed to load, and most PDFs have no
                    outline at all, so this is the common case rather than an
                    edge one.
                -->
                <TextBlock Grid.Row="1" Margin="14,4,14,14" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.NoBookmarksVisibility, Mode=OneWay}"
                           Text="This document has no bookmarks. Bookmarks are an outline the document's author saves into the file."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />

                <ListView x:Name="BookmarkList" Grid.Row="1"
                          Padding="4,0,4,8"
                          ItemsSource="{x:Bind ViewModel.Bookmarks}"
                          IsItemClickEnabled="True"
                          ItemClick="BookmarkList_ItemClick"
                          SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:BookmarkItem">
                            <!--
                                The nesting is an INDENT, not nested controls:
                                the list arrives flat with a depth per row, so
                                one ListView virtualizes the whole outline
                                however deep it goes.
                            -->
                            <Grid Margin="{x:Bind Indent}" ColumnSpacing="8">
                                <!--
                                    Rename and delete live here rather than as
                                    buttons on every row: they are done rarely,
                                    and a row is a click target for GOING there.
                                -->
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Rename" Click="RenameBookmark_Click" />
                                        <MenuFlyoutItem Text="Delete" Click="DeleteBookmark_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Title}"
                                           VerticalAlignment="Center" FontSize="13" />
                                <TextBlock Grid.Column="1" Text="{x:Bind PageLabel}"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!--
            Naming a bookmark. Used for renaming one, and for adding one where
            no text was selected to name it after.
        -->
        <ContentDialog x:Name="BookmarkNameDialog" Title="Bookmark name"
                       PrimaryButtonText="Save" CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <StackPanel Spacing="8" Width="360">
                <!-- Enter accepts it: a single-line TextBox does not handle the
                     key, so the dialog's default button takes it. -->
                <TextBox x:Name="BookmarkNameBox" Header="Name" />
                <TextBlock x:Name="BookmarkNamePage"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </ContentDialog>


        <!--
            Rotate Pages dialog. The quick right-click "Rotate 90" is one page,
            one click; this is for rotating many at once, by a chosen amount,
            filtered by range, odd/even and orientation. Laid out here but only
            shown via ShowAsync, so it costs nothing until opened.
        -->
        <!--
            Password prompt for an encrypted document.

            A PasswordBox, not a TextBox, so the characters are masked and
            Windows keeps the field out of the usual text services. Nothing
            typed here is stored, remembered between documents, or written to
            the trace.
        -->
        <ContentDialog x:Name="PasswordDialog" Title="Password required"
                       PrimaryButtonText="Open" CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <StackPanel Spacing="12" Width="320">
                <TextBlock x:Name="PasswordPrompt" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <PasswordBox x:Name="PasswordEntry" PlaceholderText="Password"
                             HorizontalAlignment="Stretch" />
                <TextBlock x:Name="PasswordError" Text="That password did not open the document."
                           Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </ContentDialog>

        <!--
            Offered when a previous run left work behind.

            Worded as an offer, not an announcement: the snapshot is the app's
            own copy and the user's file was never touched, so nothing has
            happened to their document and nothing will unless they say so.
            "Not now" keeps the snapshot, because deleting somebody's only
            remaining copy of an afternoon's work must take a deliberate press.
        -->
        <ContentDialog x:Name="RecoveryDialog" Title="Recover unsaved work"
                       PrimaryButtonText="Recover" SecondaryButtonText="Discard"
                       CloseButtonText="Not now" DefaultButton="Primary">
            <StackPanel Spacing="12" Width="380">
                <TextBlock TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Ayaan PDF closed without saving these. Your original files were not changed." />
                <ListView x:Name="RecoveryList" SelectionMode="Single" MaxHeight="200">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:RecoveryChoice">
                            <StackPanel Padding="0,6">
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind Detail}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="RotatePagesDialog" Title="Rotate pages"
                       PrimaryButtonText="Rotate" CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <StackPanel Spacing="16" Width="300">
                <StackPanel Spacing="4">
                    <TextBlock Text="Direction" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="RotateDirectionCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Clockwise 90&#176;" Tag="90" />
                        <ComboBoxItem Content="Counterclockwise 90&#176;" Tag="-90" />
                        <ComboBoxItem Content="180&#176;" Tag="180" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Pages" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <RadioButton x:Name="RotateRangeAll" Content="All" GroupName="rotateRange" IsChecked="True" />
                    <RadioButton x:Name="RotateRangeCurrent" Content="Current page" GroupName="rotateRange" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <RadioButton x:Name="RotateRangePages" Content="Pages" GroupName="rotateRange"
                                     VerticalAlignment="Center" MinWidth="64" />
                        <TextBox x:Name="RotateFrom" Width="52" InputScope="Number"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="to" VerticalAlignment="Center" />
                        <TextBox x:Name="RotateTo" Width="52" InputScope="Number"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Apply to" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="RotateParityCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Even and odd pages" />
                        <ComboBoxItem Content="Odd pages only" />
                        <ComboBoxItem Content="Even pages only" />
                    </ComboBox>
                    <ComboBox x:Name="RotateOrientationCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Pages of any orientation" />
                        <ComboBoxItem Content="Portrait pages only" />
                        <ComboBoxItem Content="Landscape pages only" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </ContentDialog>

        <!-- Extract Pages dialog: a range out to a new file, optionally one
             file per page, optionally removing them from this document. -->
        <ContentDialog x:Name="ExtractPagesDialog" Title="Extract pages"
                       PrimaryButtonText="Extract" CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <StackPanel Spacing="16" Width="300">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="From" VerticalAlignment="Center" />
                    <TextBox x:Name="ExtractFrom" Width="52" VerticalAlignment="Center" />
                    <TextBlock Text="to" VerticalAlignment="Center" />
                    <TextBox x:Name="ExtractTo" Width="52" VerticalAlignment="Center" />
                    <TextBlock x:Name="ExtractOfLabel" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <CheckBox x:Name="ExtractDeleteAfter" Content="Delete pages after extracting" />
                <CheckBox x:Name="ExtractSeparate" Content="Extract pages as separate files" />
            </StackPanel>
        </ContentDialog>

        <!--
            THE STATUS BAR: where you are in the document on the left, how you
            are looking at it on the right. Docked along the bottom, across
            every column, where Word and Acrobat keep theirs.

            Until 3.46 this was a pill floating over the canvas, draggable to
            six anchors, and a bar over the page covers the page. Docked, it has
            its own row and nothing it shows can sit on a word.

            ⚠️ IN FULL SCREEN IT FLOATS AGAIN. SetPresenting moves it into the
            page's row, over the bottom of the document, where it comes back
            when the pointer moves and fades after three seconds. A row that
            came and went would resize the viewport every time it did.
            VerticalAlignment="Bottom" is what places it there; in its own Auto
            row it changes nothing.

            View > Status bar hides it (ShowStatusBar). Full screen shows it
            regardless, because there it is the only chrome there is.
        -->
        <Border x:Name="StatusBar" Grid.Row="2" Grid.ColumnSpan="5"
                VerticalAlignment="Bottom" MinHeight="32" Padding="8,2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                PointerEntered="StatusBar_PointerEntered"
                PointerExited="StatusBar_PointerExited">
            <Grid x:Name="StatusContent" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Where you are. -->
                <StackPanel x:Name="StatusLeft" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!--
                    The page readout is editable: type a number, press Enter.
                    It lives HERE, in the always-visible status bar, and not in
                    the thumbnail panel header where it was first put: that
                    panel is Collapsed by default, so the box was invisible
                    until someone opened the panel.
                -->
                <!--
                    The field and the total are ONE unit inside a single border,
                    rather than a bordered TextBox sitting next to loose text.

                    A TextBox will NOT centre next to a TextBlock by setting
                    properties on the TextBox. MinHeight="0" sets the control,
                    while the template's own content element carries
                    MinHeight="{ThemeResource TextControlThemeMinHeight}" = 32
                    and TextControlThemePadding = 10,5,6,6, neither of which any
                    property on the control can reach. That inner 32 against an
                    outer 26 is the whole of the misalignment: the text sits
                    where a 32px box would put it. Overriding the two resources
                    in the TextBox's own scope is what actually moves it, and
                    the scope keeps the override off every other TextBox.
                -->
                <!--
                    Page stepping, either side of the readout.

                    The box alone meant the only way to move one page was to
                    click into it and type a number, or know PageUp. A reader
                    reaches for an arrow.
                -->
                <Button AutomationProperties.Name="Previous page" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Click="PrevPage_Click" Width="24" Height="26" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        IsEnabled="{x:Bind ViewModel.CanGoToPreviousPage, Mode=OneWay}"
                        ToolTipService.ToolTip="Previous page (Page Up)" />
                <Border VerticalAlignment="Center" Height="26" Padding="6,0"
                        Margin="2,0,2,0" CornerRadius="4"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="3"
                                VerticalAlignment="Center">
                        <TextBox x:Name="PageJumpBox" Width="36" MinWidth="0"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 BorderThickness="0" Background="Transparent"
                                 TextAlignment="Right" FontSize="12" InputScope="Number"
                                 KeyDown="PageJumpBox_KeyDown"
                                 LostFocus="PageJumpBox_LostFocus"
                                 ToolTipService.ToolTip="Go to page">
                            <TextBox.Resources>
                                <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                                <Thickness x:Key="TextControlThemePadding">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock VerticalAlignment="Center" FontSize="12"
                                   Text="{x:Bind ViewModel.PageCountSuffix, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Button AutomationProperties.Name="Next page" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Click="NextPage_Click" Width="24" Height="26" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        IsEnabled="{x:Bind ViewModel.CanGoToNextPage, Mode=OneWay}"
                        ToolTipService.ToolTip="Next page (Page Down)" />
                <!--
                    Back and forward through where the reader has been. They
                    earn permanent width because a chord cannot be discovered,
                    and on a three-thousand page book this is the difference
                    between returning to where you were and hunting for it.
                    Both are disabled when there is nowhere to go, which is the
                    only thing that tells a reader the history is empty.

                    Forward is here because Back without it is a one-way door:
                    having gone back, the only way to undo that was Alt+Right,
                    which nothing on screen mentions.
                -->
                <StackPanel x:Name="NavHistoryGroup" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center">
                    <!-- Both start off. Nothing has been opened yet, so there is
                         nowhere to go back to, and SyncBarNavState only runs
                         once a document has been loaded. -->
                    <Button x:Name="NavBackButton" AutomationProperties.Name="Back" Content="&#xE72B;" IsEnabled="False"
                            FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Click="NavBack_Click" Width="26" Height="26" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Back (Alt+Left)" />
                    <Button x:Name="NavForwardButton" AutomationProperties.Name="Forward" Content="&#xE72A;" IsEnabled="False"
                            FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Click="NavForward_Click" Width="26" Height="26" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Forward (Alt+Right)" />
                </StackPanel>
                <!-- Unsaved work, beside where you are. -->
                <TextBlock Text="&#9679;" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           VerticalAlignment="Center" Margin="4,0,0,0" FontSize="14"
                           ToolTipService.ToolTip="Unsaved changes"
                           Visibility="{x:Bind ViewModel.DirtyIndicatorVisibility, Mode=OneWay}" />
                </StackPanel>

                <!-- Says why text selection is unavailable, instead of the
                     tool silently doing nothing on a scanned page. In the
                     stretching middle column and trimmed, so a long message
                     gives way rather than pushing the controls off the bar. -->
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TextAvailabilityLabel, Mode=OneWay}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />

                <!-- How you are looking at it. -->
                <StackPanel x:Name="StatusRight" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!--
                    The modes the page is LOOKED at in: night, turned, how it
                    scrolls, and full screen. Toggles rather than menu ticks,
                    because night mode being on is a thing to SEE.

                    Grouped, with its divider inside, because this is the first
                    thing the bar gives up when the window is too narrow for all
                    of it (see StatusBarOverflow), and a divider left behind by a
                    hidden group divides one thing from nothing. Every item here
                    is also named in the "..." menu, so nothing becomes
                    unreachable.
                -->
                <StackPanel x:Name="ViewModesGroup" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="NightModeBarButton" AutomationProperties.Name="Night mode" Click="NightModeBar_Click"
                                  Width="28" Height="26" Padding="0" BorderThickness="0"
                                  Background="Transparent"
                                  ToolTipService.ToolTip="Night mode">
                        <FontIcon Glyph="&#xE708;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="RotateBarButton" AutomationProperties.Name="Rotate view clockwise" Click="RotateBar_Click"
                                  Width="28" Height="26" Padding="0" BorderThickness="0"
                                  Background="Transparent"
                                  ToolTipService.ToolTip="Rotate view clockwise (Ctrl+Shift++)">
                        <FontIcon Glyph="&#xE7AD;" FontSize="14" />
                    </ToggleButton>
                    <!--
                        Which way the document scrolls. A plain button, not a
                        toggle: the icon shows the mode you are IN, one page
                        running into the next while scrolling is continuous and
                        a single sheet when it is not, and the tooltip says what
                        pressing it will do.
                    -->
                    <Button x:Name="PageModeBarButton" AutomationProperties.Name="Page layout" Click="PageModeBar_Click"
                            Width="28" Height="26" Padding="0" BorderThickness="0"
                            Background="Transparent">
                        <Grid>
                            <FontIcon x:Name="PageModeBarIcon" Glyph="&#xE7C3;" FontSize="14"
                                      Visibility="Collapsed" />
                            <!-- Roomier than the path's 10x14, because the box clips. -->
                            <PathIcon x:Name="ContinuousPagesIcon" Data="{StaticResource ContinuousPagesPath}"
                                      Width="11" Height="15" />
                        </Grid>
                    </Button>
                    <Button AutomationProperties.Name="Full screen" Content="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Click="FullScreen_Click" Width="28" Height="26" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Full screen (F11)" />
                    <Rectangle Width="1" Height="16" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                </StackPanel>
                <Button AutomationProperties.Name="Zoom out" Content="&#xE949;" FontFamily="Segoe MDL2 Assets" FontSize="11" Click="ZoomOut_Click"
                        Width="28" Height="26" Padding="0" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Zoom out" />
                <!-- Zoom readout doubles as a preset menu. -->
                <Button x:Name="ZoomMenuButton" AutomationProperties.Name="Zoom presets" Width="60" Height="26" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Zoom presets">
                    <!-- A caret, because the bare percentage read as a label
                         and nobody clicks a label. -->
                    <StackPanel Orientation="Horizontal" Spacing="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ZoomPercentText" Text="100%" TextAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <FontIcon Glyph="&#xE70D;" FontSize="8" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem Text="Fit page" Click="ZoomFitPage_Click"
                                            KeyboardAcceleratorTextOverride="Ctrl+0" />
                            <MenuFlyoutItem Text="Fit width" Click="ZoomFitWidth_Click"
                                            KeyboardAcceleratorTextOverride="Ctrl+2" />
                            <MenuFlyoutItem Text="Actual size" Click="ZoomActualSize_Click"
                                            KeyboardAcceleratorTextOverride="Ctrl+1" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="50%" Click="ZoomPreset_Click" Tag="0.5" />
                            <MenuFlyoutItem Text="100%" Click="ZoomPreset_Click" Tag="1.0" />
                            <MenuFlyoutItem Text="200%" Click="ZoomPreset_Click" Tag="2.0" />
                            <MenuFlyoutItem Text="400%" Click="ZoomPreset_Click" Tag="4.0" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button AutomationProperties.Name="Zoom in" Content="&#xE948;" FontFamily="Segoe MDL2 Assets" FontSize="11" Click="ZoomIn_Click"
                        Width="28" Height="26" Padding="0" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Zoom in" />
                <!-- Toggles between the whole page and the full width, which is
                     what the handler does; it used to claim to be fit width
                     alone, so half of its presses looked like a bug. -->
                <Button AutomationProperties.Name="Fit page or fit width" Content="&#xE9A6;" FontFamily="Segoe MDL2 Assets" FontSize="11" Click="ResetZoom_Click"
                        Width="28" Height="26" Padding="0" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Fit page or fit width (Ctrl+0, Ctrl+2)" />

                <Rectangle Width="1" Height="16" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <!--
                    The rest of the View menu, one click from the page instead
                    of three from the rail. Text items rather than icons: these
                    are the ones chosen rarely, and a wrong Segoe MDL2 code
                    renders as an empty box, so only glyphs this app already
                    proves are used above.

                    It also NAMES every icon on the bar. An icon can only be
                    guessed at; this is where a reader finds out that the moon
                    is night mode, and it is where those commands still live
                    when the canvas is too narrow to show their buttons.
                -->
                <Button x:Name="ViewOptionsButton" AutomationProperties.Name="View options" Content="&#xE712;"
                        FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Width="24" Height="26" Padding="0" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="View options">
                    <Button.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem x:Name="BarNavBackItem" Text="Back" Click="NavBack_Click"
                                            KeyboardAcceleratorTextOverride="Alt+Left" />
                            <MenuFlyoutItem x:Name="BarNavForwardItem" Text="Forward" Click="NavForward_Click"
                                            KeyboardAcceleratorTextOverride="Alt+Right" />
                            <MenuFlyoutSeparator />
                            <RadioMenuFlyoutItem x:Name="BarContinuousItem" Text="Continuous scrolling"
                                                 GroupName="barPageViewMode" IsChecked="True"
                                                 Click="ContinuousView_Click" />
                            <RadioMenuFlyoutItem x:Name="BarSinglePageItem" Text="Single page"
                                                 GroupName="barPageViewMode"
                                                 Click="SinglePageView_Click" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="BarNightModeItem" Text="Night mode"
                                                  Click="NightModeToggle_Click" />
                            <MenuFlyoutItem Text="Full screen" Click="FullScreen_Click"
                                            KeyboardAcceleratorTextOverride="F11" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Rotate clockwise" Click="RotateViewCw_Click"
                                            KeyboardAcceleratorTextOverride="Ctrl+Shift++" />
                            <MenuFlyoutItem Text="Rotate anticlockwise" Click="RotateViewCcw_Click"
                                            KeyboardAcceleratorTextOverride="Ctrl+Shift+-" />
                            <MenuFlyoutItem x:Name="BarResetRotationItem" Text="Reset view rotation"
                                            Click="ResetViewRotation_Click" IsEnabled="False" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="BarRulersToggle" Text="Rulers in Edit mode"
                                                  Click="RulersToggle_Click"
                                                  KeyboardAcceleratorTextOverride="Ctrl+R" />
                            <MenuFlyoutSubItem Text="Ruler units">
                                <MenuFlyoutItem Text="Inches" Click="RulerUnit_Click" Tag="Inches" />
                                <MenuFlyoutItem Text="Centimeters" Click="RulerUnit_Click" Tag="Centimeters" />
                                <MenuFlyoutItem Text="Millimeters" Click="RulerUnit_Click" Tag="Millimeters" />
                                <MenuFlyoutItem Text="Points" Click="RulerUnit_Click" Tag="Points" />
                                <MenuFlyoutItem Text="Picas" Click="RulerUnit_Click" Tag="Picas" />
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!--
            FIND, over the top right of the page while it is wanted.

            It lived on the floating bar. With the bar docked, and able to be
            hidden from the View menu, find cannot live there: hiding the status
            bar would take find with it. The title bar's glass (MainWindow's
            QuickFind), Edit > Find and Ctrl+F all open it here.

            ⚠️ INSIDE THE PAGE, NOT IN THE TITLE BAR. A search box out there is
            outside RootGrid, so while it held focus no key would reach
            RootGrid_KeyDown, the trap the menu bar already hit. Here the keys
            still bubble, and it is still there in full screen, where the title
            bar is not.

            Top RIGHT, below the ruler: the object toolbar owns the top left, and
            the tool options and notices are centred.
        -->
        <StackPanel x:Name="FindPanel" Grid.Column="2" Grid.Row="1" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,20,0"
                    Orientation="Horizontal" Spacing="4" Padding="6,3"
                    Canvas.ZIndex="25" Translation="0,0,32"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6">
                <TextBox x:Name="SearchBox" Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Find" Width="200" Height="26" Margin="2,0,0,0"
                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                         FontSize="12" BorderThickness="0" Background="Transparent"
                         KeyDown="SearchBox_KeyDown">
                    <!-- Same template floor as the page field: without this the
                         search text sits low against the buttons beside it. -->
                    <TextBox.Resources>
                        <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                        <Thickness x:Key="TextControlThemePadding">0</Thickness>
                    </TextBox.Resources>
                </TextBox>
                <!--
                    Find options. A flyout rather than two more buttons in the
                    strip: they are set rarely and read never, so they do not
                    earn permanent width beside a control people use constantly.
                -->
                <Button x:Name="SearchOptionsButton" AutomationProperties.Name="Find options" Content="&#xE712;"
                        FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Width="24" Height="26" Padding="0" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Find options">
                    <Button.Flyout>
                        <MenuFlyout>
                            <ToggleMenuFlyoutItem x:Name="MatchCaseToggle" Text="Match case"
                                                  IsChecked="{x:Bind ViewModel.SearchMatchCase, Mode=TwoWay}"
                                                  Click="SearchOption_Click" />
                            <ToggleMenuFlyoutItem x:Name="WholeWordToggle" Text="Whole word"
                                                  IsChecked="{x:Bind ViewModel.SearchWholeWord, Mode=TwoWay}"
                                                  Click="SearchOption_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <!--
                    Wide enough for "12345 of 67890" so the buttons beside it do
                    not shuffle sideways as the total climbs during a sweep. The
                    count is the one part of this strip that changes on its own.
                -->
                <TextBlock Text="{x:Bind ViewModel.SearchStatus, Mode=OneWay}" VerticalAlignment="Center"
                           MinWidth="84" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <!--
                    Says the total is still climbing, so the count itself can
                    stay a plain "12 of 431" rather than "12 of 431+".

                    Always present and always the same size, with only IsActive
                    bound: collapsing it would move every control to its right
                    the moment a search started and again when it finished.
                -->
                <ProgressRing IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                              Width="12" Height="12" Margin="0,0,2,0"
                              VerticalAlignment="Center"
                              ToolTipService.ToolTip="Searching the rest of the document" />
                <Button AutomationProperties.Name="Previous match" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="SearchPrev_Click"
                        Width="24" Height="26" Padding="0" Background="Transparent" BorderThickness="0"
                        IsEnabled="{x:Bind ViewModel.HasSearchMatches, Mode=OneWay}"
                        ToolTipService.ToolTip="Previous match (Shift+Enter)" />
                <Button AutomationProperties.Name="Next match" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="SearchNext_Click"
                        Width="24" Height="26" Padding="0" Background="Transparent" BorderThickness="0"
                        IsEnabled="{x:Bind ViewModel.HasSearchMatches, Mode=OneWay}"
                        ToolTipService.ToolTip="Next match (Enter)" />
                <Button AutomationProperties.Name="Close find" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Click="FindClose_Click" Width="24" Height="26" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Close find (Esc)" />
                </StackPanel>

        <!--
            WHAT THE APP IS DOING DURING THE TWENTY SECONDS IT USED TO SPEND IN
            SILENCE.

            A Burmese page cannot be read until its font has been reshaped into
            an index, and until that finishes the page shows the scrambled
            fragments PDFium made of it and refuses to be clicked. For the whole
            of that wait the app said nothing whatever, which a reader can only
            read as a hang: they are looking at their own document behaving as
            though it were broken.

            LAST CHILD OF THE GRID so it floats over the page rather than moving
            it, and not hit-testable, because it explains a wait rather than
            asking anything of the reader: a click must reach the document
            underneath it as if this were not here.

            ⚠️ Grid.Column="2", AND WITHOUT IT THIS IS NOT A FLOATING NOTICE AT
            ALL. The chrome here occupies real COLUMNS and the canvas is the
            third of them, so an element that does not say which column it is in
            lands in the first: shipped that way once, and it appeared squashed
            into the bottom of the tool rail, on top of the buttons there,
            nowhere near the document it was talking about.

            TOP centre. The bottom of the canvas already carries the status
            pill, centred, and two centred things at the same edge collide.
            Below the 22px ruler, and centred rather than left so it clears the
            object toolbar in the corner.
        -->
        <Border Grid.Column="2" Grid.Row="1"
                Visibility="{x:Bind ViewModel.IsPreparingText, Mode=OneWay}"
                IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,34,0,0" Padding="16,12"
                CornerRadius="8" MinWidth="300"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.PrepareMessage}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ProgressBar Value="{x:Bind ViewModel.PreparePercent, Mode=OneWay}"
                             Minimum="0" Maximum="100" />
                <!--
                    Says the wait is finite and roughly how much is left, which
                    is the difference between waiting and wondering.
                -->
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="This happens once per document. The text can be edited when it finishes." />
            </StackPanel>
        </Border>

        <!--
            THE NOTICE BAR. `Status` was written in 148 places and shown in none,
            so a refusal that only set it was a click that did nothing and said
            nothing. StatusNotices decides what reaches this: refusals and
            instructions, never confirmations, and never a refusal the label
            beside the clicked text is already explaining.

            In the canvas column for the reason the card above gives, top centre
            below the ruler, and pushed under that card while it shows.
        -->
        <InfoBar x:Name="NoticeBar" Grid.Column="2" Grid.Row="1"
                 HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="560"
                 Margin="{x:Bind local:MainPage.NoticeMargin(ViewModel.IsPreparingText), Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                 Severity="{x:Bind local:MainPage.NoticeSeverity(ViewModel.NoticeIsWarning), Mode=OneWay}"
                 Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                 AutomationProperties.Name="Notice" />

        <!--
            SAVING. The file is written off the UI thread, so the window keeps
            painting instead of freezing for the 11 s a large book takes to
            clean. The page takes no input meanwhile: an edit arriving half way
            would be lost, or reach a document PDFium is writing out. So this
            covers the whole page, transparent but hit-testable, from the first
            moment; the card only appears if the save is still going after
            400 ms, so a quick save shows nothing at all.

            Over everything, the paper included, which sits in a raised layer
            of its own (see GradientPanelWindow).
        -->
        <Grid x:Name="SavingOverlay" Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="5"
              Visibility="Collapsed" Canvas.ZIndex="50" Translation="0,0,64"
              Background="Transparent">
            <Border x:Name="SavingCard"
                    AutomationProperties.Name="Saving"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20,16" CornerRadius="8" MinWidth="320"
                    Visibility="Collapsed"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel Spacing="8">
                    <TextBlock Text="Saving" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock Text="{x:Bind ViewModel.SavingStep, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
