<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PdfEditorApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PdfEditorApp"
    xmlns:controls="using:PdfEditorApp.Controls"
    xmlns:viewmodels="using:PdfEditorApp.ViewModels"
    xmlns:viewport="using:PdfEditorApp.Viewport"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Canvas-first shell.

        The document canvas fills the whole window and everything else FLOATS
        over it, rather than the canvas being a panel squeezed between a menu
        bar, a button strip and a status bar. Permanently visible chrome
        competes with the page for both attention and pixels; here the tools
        live in a narrow rail and a status pill that overlay the canvas, and
        the pages panel is hidden until asked for, so the page is the app.

        The canvas background is a flat neutral deliberately darker than the
        page, so a white sheet reads as an object sitting on a surface. That
        contrast is what makes it feel like a canvas rather than a borderless
        region of the window.
    -->
    <!-- KeyboardAcceleratorPlacementMode=Hidden: WinUI otherwise advertises an
         accelerator by floating a tooltip ("Ctrl+G") over its owner. On a menu
         item that is helpful; on this Grid, whose owner is the whole editor,
         it parks a label in the middle of the canvas on top of the user's
         drawing and stays there. The menu entries still show their shortcuts. -->
    <Grid x:Name="RootGrid" IsTabStop="True" KeyDown="RootGrid_KeyDown" KeyUp="RootGrid_KeyUp"
          KeyboardAcceleratorPlacementMode="Hidden">
        <!-- Ctrl chords are NOT declared as accelerators on this Grid, and the
             accelerators on the MenuFlyoutItems below are not what makes them
             fire. Those items live in a Button's MenuFlyout, so they are not in
             the visual tree until the flyout opens, and an accelerator on an
             unrealised element is not live. They are kept only because they are
             what renders "Ctrl+G" beside the menu entry.

             Every Ctrl chord that actually works from the canvas is a case in
             RootGrid_KeyDown. That is the single registration point; add new
             ones there. -->
        <!--
            The canvas surface. A fixed neutral grey rather than a theme
            brush: theme surface colours are near-white in light mode, so a
            white page on one is invisible as an object. The page needs to sit
            on something clearly darker than itself in BOTH themes, which is
            exactly the case for not deferring to the theme here.
        -->
        <Grid.Background>
            <SolidColorBrush Color="#3A3A3D" />
        </Grid.Background>

        <!--
            Chrome occupies real COLUMNS; the canvas gets what is left.

            This was twice attempted with the canvas overlaid and inset by a
            margin, and the page was covered both times: first because the
            inset was a hand-written number that disagreed with the panel's
            geometry, then because it was derived from ActualWidth, which is
            zero while the panel is collapsed and had not been laid out yet
            when the inset was read. Any arithmetic that reproduces what the
            layout engine already knows will eventually disagree with it.
            Giving the panel a column means overlap is not expressible.
        -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="ThumbnailColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
            MaxZoomFactor is 8, i.e. 800%. This was briefly raised to 64 to
            match Acrobat, on the theory that tiles had removed the reason for
            the cap. They had not: the page went visibly BLURRY at 6400%, and
            the tile counts in the trace, which looked healthy, said nothing
            about it.

            The reason is the tiles' LAYOUT size. Tile position and size are in
            unzoomed slot DIPs, and the level doubles with the zoom, so a tile
            shrinks as you go in: about 12 DIP at 800%, but 1.6 DIP at 6400%.
            The ScrollView's zoom is a compositor scale over content laid out at
            that size, so past some point the tiles are rasterized far smaller
            than they are displayed and magnified back up.

            Raising this again needs a floor on how small a tile may be in slot
            DIPs, with the level chosen against that floor, NOT just a bigger
            number here.
        -->
        <!-- Rulers: PageMaker-style top and left, giving the user a visible
             coordinate frame while placing shapes. Overlaid on the viewport
             column with a Margin on the ScrollView reserving room; toggled
             from View > Rulers. Corner covers the intersection so the two
             rulers don't butt into each other visually. -->
        <Border x:Name="RulerCorner" Grid.Column="2"
                Width="22" Height="22"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,1" Canvas.ZIndex="10" />

        <!-- Live preview line shown while dragging a guide out of a ruler.
             Positioned in viewport-DIP space via Margin, so it lands under
             the pointer even as the pointer crosses out of the ruler onto
             the page. Horizontal preview: full viewport width, 1 DIP tall,
             top of Margin = pointer Y. Vertical preview: 1 DIP wide, full
             height, left of Margin = pointer X. Collapsed until pressed. -->
        <Rectangle x:Name="GuidePreviewLine" Grid.Column="2"
                   Fill="#FF00A0D8" Opacity="0.85"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   IsHitTestVisible="False"
                   UseLayoutRounding="False"
                   Canvas.ZIndex="9"
                   Visibility="Collapsed" />

        <!-- Coordinate readout that follows the pointer during the drag.
             Small floating chip near the cursor showing the current position
             in the active ruler unit, so precise placement is a matter of
             watching the number rather than counting ticks. Collapsed until
             a ruler drag starts. -->
        <Border x:Name="GuideReadout" Grid.Column="2"
                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="3"
                Padding="4,1"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                IsHitTestVisible="False"
                Canvas.ZIndex="11"
                Visibility="Collapsed">
            <TextBlock x:Name="GuideReadoutText" FontSize="10"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Border>
        <controls:CursorCanvas x:Name="TopRuler" Grid.Column="2"
                Height="22" Margin="22,0,0,0"
                HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Background="{ThemeResource LayerFillColorAltBrush}"
                Canvas.ZIndex="10"
                PointerPressed="TopRuler_PointerPressed"
                PointerMoved="Ruler_PointerMoved"
                PointerReleased="Ruler_PointerReleased"
                PointerCaptureLost="Ruler_PointerCaptureLost"
                PointerEntered="Ruler_PointerEntered"
                PointerExited="Ruler_PointerExited"
                RightTapped="Ruler_RightTapped"
                SizeChanged="Rulers_SizeChanged">
            <Canvas.ContextFlyout>
                <MenuFlyout x:Name="RulerFlyout">
                    <RadioMenuFlyoutItem Text="Inches"       GroupName="RulerUnitFly" Click="RulerUnit_Click" Tag="Inches" IsChecked="True" />
                    <RadioMenuFlyoutItem Text="Centimeters"  GroupName="RulerUnitFly" Click="RulerUnit_Click" Tag="Centimeters" />
                    <RadioMenuFlyoutItem Text="Millimeters"  GroupName="RulerUnitFly" Click="RulerUnit_Click" Tag="Millimeters" />
                    <RadioMenuFlyoutItem Text="Points"       GroupName="RulerUnitFly" Click="RulerUnit_Click" Tag="Points" />
                    <RadioMenuFlyoutItem Text="Picas"        GroupName="RulerUnitFly" Click="RulerUnit_Click" Tag="Picas" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Add guide at exact position..." Click="AddGuideAt_Click" />
                    <MenuFlyoutItem Text="Add margin guides..." Click="AddMargins_Click" />
                    <MenuFlyoutItem Text="Add column guides..." Click="AddColumns_Click" />
                    <ToggleMenuFlyoutItem x:Name="LockGuidesToggle" Text="Lock guides" Click="LockGuidesToggle_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Clear guides on this page" Click="ClearGuidesPage_Click" />
                    <MenuFlyoutItem Text="Clear all guides" Click="ClearGuidesAll_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Hide Rulers" Click="RulersHide_Click" />
                </MenuFlyout>
            </Canvas.ContextFlyout>
        </controls:CursorCanvas>
        <controls:CursorCanvas x:Name="LeftRuler" Grid.Column="2"
                Width="22" Margin="0,22,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Background="{ThemeResource LayerFillColorAltBrush}"
                Canvas.ZIndex="10"
                PointerPressed="LeftRuler_PointerPressed"
                PointerMoved="Ruler_PointerMoved"
                PointerReleased="Ruler_PointerReleased"
                PointerCaptureLost="Ruler_PointerCaptureLost"
                PointerEntered="Ruler_PointerEntered"
                PointerExited="Ruler_PointerExited"
                RightTapped="Ruler_RightTapped"
                SizeChanged="Rulers_SizeChanged" />

        <ScrollView
            x:Name="PageScroller"
            Grid.Column="2"
            Margin="22,22,0,0"
            ZoomMode="Enabled"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Enabled"
            MinZoomFactor="0.1"
            MaxZoomFactor="8"
            ViewChanged="PageScroller_ViewChanged"
            SizeChanged="PageScroller_SizeChanged">
            <!--
                Width/Height are pinned to the ViewModel's layout size in
                DIPs and the Image stretches to fill it. Sharper renders
                therefore change only pixel density, never layout, so
                ScrollView.ZoomFactor 1.0 reliably means "fits the width".
            -->
            <controls:CursorGrid
                x:Name="ViewportHost"
                Background="Transparent"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="24"
                PointerPressed="ViewportHost_PointerPressed"
                PointerMoved="ViewportHost_PointerMoved"
                PointerReleased="ViewportHost_PointerReleased"
                PointerCanceled="ViewportHost_PointerReleased"
                PointerCaptureLost="ViewportHost_PointerCaptureLost"
                DoubleTapped="ViewportHost_DoubleTapped"
                IsDoubleTapEnabled="True">

                <!--
                    Continuous page stack.

                    Each card is sized in SLOT space (unzoomed DIPs) from
                    the page's intrinsic size, fixed the moment the
                    document opens. Zoom is the ScrollView's own zoom
                    factor, which grows the scrollable extent, so a card
                    always occupies its final space and bitmaps can stream
                    in or be released without anything below shifting.

                    ItemsControl, not ItemsRepeater: the slots already
                    virtualize their PIXELS in the view model (bitmaps are
                    released outside the window while heights stay), so
                    virtualizing the containers as well would buy little
                    and would make scroll-offset-to-page mapping depend on
                    realization order.
                -->
                <!--
                    ItemsRepeater, not ItemsControl: an ItemsControl over a
                    StackPanel realises EVERY item up front. A 3352-page book
                    therefore built 3352 shadowed cards before it could show
                    one, which took 69 seconds and 1.1 GB.

                    The original objection to virtualising was that
                    scroll-offset-to-page mapping would depend on realisation
                    order. It does not: PageAt reads _layout.TopOf(i) and the
                    slot's own height, both of which are known for every page
                    the moment the layout is built, whether or not a container
                    for it exists. Nothing in the code-behind looks a page card
                    up by container either.
                -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.PageSlots}" HorizontalAlignment="Center">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:PageSlot">
                            <!-- The page card: white sheet, thin border, drop shadow. -->
                            <Border Width="{x:Bind SlotWidth}" Height="{x:Bind SlotHeight}"
                                    Background="White"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <Border.Shadow>
                                    <ThemeShadow />
                                </Border.Shadow>
                                <Grid>
                                    <Image Source="{x:Bind Bitmap, Mode=OneWay}" Stretch="Fill" />

                                    <!--
                                        Deep-zoom tiles, laid over the stretched
                                        full-page bitmap so the page underneath
                                        shows through until each tile arrives.
                                        That is the progressive effect: the view
                                        is never blank, it just gets sharper.

                                        Positions are slot DIPs, already
                                        multiplied, so the tiles line up with
                                        the page exactly and no transform sits
                                        between layout and geometry.

                                        UseLayoutRounding MUST be False here.
                                        Tiles are a fraction of a DIP wide in
                                        slot space (12.5 at 800%, 1.6 at 6400%)
                                        and the default rounding snaps each one
                                        UP to the next whole physical pixel
                                        while leaving its position exact. At
                                        150% scale that turned a 12.5 DIP tile
                                        into 12.6667, so every tile overlapped
                                        its neighbour by a sixth of a DIP: a
                                        grid of seams magnified by the zoom into
                                        1.3 DIP of doubled content across the
                                        whole page. Deeper levels are worse, the
                                        overlap becoming a gap once a tile
                                        rounds DOWN. This is measured in
                                        diag.log by the tilegeom lines: want and
                                        got must agree.
                                    -->
                                    <ItemsControl ItemsSource="{x:Bind Tiles}" IsHitTestVisible="False"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                  UseLayoutRounding="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Grid UseLayoutRounding="False" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:PageTile">
                                                <Image Source="{x:Bind Bitmap, Mode=OneWay}" Stretch="Fill"
                                                       Width="{x:Bind Size}" Height="{x:Bind Size}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       UseLayoutRounding="False"
                                                       Margin="{x:Bind local:MainPage.Offset(Left, Top)}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--
                                        Overlay layer for this page.

                                        NO ScaleTransform. Every rect below is
                                        already multiplied into slot DIPs by
                                        the view model. A RenderTransform runs
                                        AFTER layout, so normalized rects were
                                        laid out at sub-pixel sizes (about
                                        0.3 x 0.02 DIP) and produced no
                                        geometry to scale up: selections,
                                        highlights and search hits were all
                                        computed correctly and drew nothing.
                                    -->
                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <ItemsControl ItemsSource="{x:Bind SearchMatchRects}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <Rectangle Fill="#66FFA500" Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                            Fillable form fields, shown only in fill mode. A tinted fill
                                            plus a dashed accent border so they read as "click here to
                                            type" without hiding the field's own printed box. Display
                                            only: the click is caught by the viewport host, which hit-tests
                                            the field and opens the text editor on it.
                                        -->
                                        <ItemsControl ItemsSource="{x:Bind FormFieldOutlines}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <Rectangle Fill="#332563EB"
                                                               Stroke="#CC2563EB" StrokeThickness="1.5"
                                                               StrokeDashArray="3,2" RadiusX="1" RadiusY="1"
                                                               Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{x:Bind SelectionRects}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <Rectangle Fill="#665599FF" Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Highlights arrive flattened: one entry per rectangle, carrying its colour. -->
                                        <ItemsControl ItemsSource="{x:Bind HighlightRects}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <Rectangle Fill="{x:Bind local:MainPage.HexBrush(ColorHex)}"
                                                               Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                            Marquee around the selected annotation.

                                            A hairline solid border, not a thick
                                            dashed one. The mark being selected
                                            is the thing worth looking at; the
                                            selection should point at it, not
                                            compete with it. Every serious
                                            editor draws this the same way, and
                                            a heavy dashed rectangle reads as a
                                            debug overlay rather than a tool.
                                        -->
                                        <!-- Smart alignment guides: bright orange lines that flash into
                                             existence while you drag and your edge/centre aligns with
                                             another object's edge/centre. ItemsControl over an ObservableCollection
                                             so the .Clear() at drag-end reliably disappears the lines - the
                                             earlier nullable-property approach's PropertyChanged wasn't always
                                             re-evaluating the binding. -->
                                        <ItemsControl ItemsSource="{x:Bind SmartGuideLines}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:SmartGuideLine">
                                                    <Rectangle Fill="{x:Bind local:MainPage.SmartGuideBrush, Mode=OneTime}"
                                                               Opacity="0.9" UseLayoutRounding="False"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                                               Width="{x:Bind PixelWidth}"
                                                               Height="{x:Bind PixelHeight}"
                                                               Margin="{x:Bind local:MainPage.Offset(PixelLeft, PixelTop)}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Ruler guides: horizontal/vertical lines spanning the page,
                                             drawn above the page content but below selection marquees.
                                             1 DIP thick, Acrobat-cyan. IsHitTestVisible=False for now;
                                             the pointer falls through so drawing tools still work over
                                             a guide. Move/delete will get their own pass. -->
                                        <ItemsControl ItemsSource="{x:Bind Guides}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:GuideMark">
                                                    <Rectangle Opacity="0.85"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                                               UseLayoutRounding="False"
                                                               Fill="{x:Bind local:MainPage.GuideFill(IsSelected, IsSnapActive), Mode=OneWay}"
                                                               Width="{x:Bind PixelWidth, Mode=OneWay}"
                                                               Height="{x:Bind PixelHeight, Mode=OneWay}"
                                                               Margin="{x:Bind local:MainPage.Offset(PixelLeft, PixelTop), Mode=OneWay}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Marquees for the multi-selection extras: thin accent outlines, no
                                             handles, OUTSIDE the rotate transform because each extra keeps its
                                             own upright frame. -->
                                        <ItemsControl ItemsSource="{x:Bind ExtraSelectionOutlines}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <Rectangle Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                               StrokeThickness="1" StrokeDashArray="3,2"
                                                               Fill="Transparent"
                                                               Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Frame + handles, turned as ONE about the box centre for a rotated text box. -->
                                        <Grid>
                                            <Grid.RenderTransform>
                                                <RotateTransform Angle="{x:Bind SelectionRotation, Mode=OneWay}"
                                                                 CenterX="{x:Bind SelectionCenterX, Mode=OneWay}"
                                                                 CenterY="{x:Bind SelectionCenterY, Mode=OneWay}" />
                                            </Grid.RenderTransform>
                                        <ItemsControl ItemsSource="{x:Bind SelectionOutline}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <Rectangle Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                               StrokeThickness="1" Fill="Transparent"
                                                               Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                               Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                            Corner grips for resizing.

                                            Drawn as a separate collection from
                                            the marquee because they are four
                                            squares rather than one rectangle,
                                            and IsHitTestVisible stays False:
                                            the pointer handler works out which
                                            corner was grabbed from the
                                            coordinates, so these are purely
                                            something to aim at. Letting them
                                            take the pointer would steal the
                                            press from the canvas that decides
                                            what the drag means.
                                        -->
                                        <ItemsControl ItemsSource="{x:Bind SelectionGrips}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewport:ScaledRect">
                                                    <!--
                                                        WHITE fill with an accent
                                                        border, the convention in
                                                        every design tool. A solid
                                                        accent square reads as a
                                                        blob sitting on the page;
                                                        a white one reads as a
                                                        control, and stays visible
                                                        over dark artwork as well
                                                        as light paper.
                                                    -->
                                                    <Ellipse Fill="White"
                                                             Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                             StrokeThickness="1.5"
                                                             Width="{x:Bind Width}" Height="{x:Bind Height}"
                                                             Margin="{x:Bind local:MainPage.Offset(Left, Top)}"
                                                             HorizontalAlignment="Left" VerticalAlignment="Top">
                                                        <Ellipse.Shadow>
                                                            <ThemeShadow />
                                                        </Ellipse.Shadow>
                                                    </Ellipse>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </Grid>
                                    </Grid>

                                    <!--
                                        Notes live OUTSIDE the scaled overlay.

                                        The overlay above is scaled by the slot
                                        width (800x) so that normalized rect
                                        sizes come out right. A note marker is
                                        a real control with an intrinsic size,
                                        so the same transform blew a 30px
                                        button up to 24000px: it covered the
                                        whole page and, being hit-testable,
                                        swallowed every pointer event meant for
                                        the tools underneath. Positioned here
                                        by pre-multiplied offset instead, so it
                                        stays a normal-sized button.
                                    -->
                                    <ItemsControl ItemsSource="{x:Bind Notes}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:NoteAnnotation">
                                                <Button Padding="4" Background="#FFFFD700" CornerRadius="12"
                                                        Margin="{x:Bind local:MainPage.ScaledOffset(X, Y, Scale)}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <FontIcon Glyph="&#xE70B;" FontSize="14" Foreground="#FF1A1A1A" />
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel Spacing="8" Width="220">
                                                                <TextBox Text="{x:Bind Text, Mode=TwoWay}" PlaceholderText="Note text" Height="90" AcceptsReturn="True" TextWrapping="Wrap" />
                                                                <!-- A note marker is a button whose click opens this flyout,
                                                                     so the Select tool can never pick it; without this there
                                                                     was no way to remove a note at all. -->
                                                                <Button Content="Delete note" HorizontalAlignment="Right"
                                                                        Click="DeleteNote_Click" Tag="{x:Bind}" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!--
                    Ink layer, spanning the WHOLE stack rather than sitting
                    inside a page card. Polyline points cannot be bound
                    through x:Bind, so strokes are built in code-behind,
                    and a page-spanning layer means a stroke drawn near a
                    page edge is never clipped by the card. Positions are
                    in slot space, so the ScrollView's zoom scales the ink
                    along with the pages.
                -->
                <Canvas x:Name="InkCanvas" IsHitTestVisible="False" />

                <!--
                    Isolated text-editing layer, ABOVE the ink canvas.

                    Separate from InkCanvas because that one is hit-test
                    invisible (so ink never eats a page gesture), but the text
                    editor MUST receive pointer input: clicking to place the
                    caret and dragging to select are what make editing feel
                    like a real text box rather than a field you can only type
                    into blind. A dim scrim over the rest of the page isolates
                    the box being edited, the way Word greys out everything
                    else; clicking the scrim (anywhere off the box) commits.

                    EditCanvas has NO background, so its empty area is
                    transparent to hit-testing and a click there falls through
                    to the scrim; only the editor child is interactive.
                    Collapsed until an edit begins.
                -->
                <Grid x:Name="EditOverlay" Visibility="Collapsed">
                    <Rectangle x:Name="EditScrim" Fill="#30000000"
                               PointerPressed="EditScrim_PointerPressed" />
                    <Canvas x:Name="EditCanvas" />
                </Grid>

            </controls:CursorGrid>
        </ScrollView>

        <!--
            Contextual object toolbar. Floats over the viewport and follows the
            selection, so object commands are reachable without going to the
            menu. This is now the primary route to Group and Ungroup, because
            Ctrl+G proved to be interceptable outside the app entirely.

            OUTSIDE the ScrollView on purpose. Inside it the buttons would be
            scaled by ZoomFactor along with the page and would be the size of a
            postage stamp at 25% and unusable at 800%. Its Margin mirrors
            PageScroller's so that its origin is the viewport's top-left, which
            is the space ObjectToolbarPlacement computes in; SetRulersVisible
            keeps the two margins in step.

            Text labels rather than icons: no Segoe glyph reads unambiguously as
            "ungroup", and a guessed glyph that is missing from the font renders
            as a tofu box.
        -->
        <Border x:Name="ObjectToolbar" Grid.Column="2"
                Margin="22,22,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Collapsed" Canvas.ZIndex="20"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="3"
                SizeChanged="ObjectToolbar_SizeChanged">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ObjectToolbarOffset" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="ObjToolGroup" Content="Group" Padding="10,4"
                        Click="ObjToolGroup_Click"
                        ToolTipService.ToolTip="Group the selected objects so they move together" />
                <Button x:Name="ObjToolUngroup" Content="Ungroup" Padding="10,4"
                        Click="ObjToolUngroup_Click"
                        ToolTipService.ToolTip="Break this group apart" />
                <Rectangle Width="1" Margin="3,4" VerticalAlignment="Stretch"
                           Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Button x:Name="ObjToolBack" Content="To back" Padding="10,4"
                        Click="ObjToolBack_Click"
                        ToolTipService.ToolTip="Send behind everything else on the page" />
                <Button x:Name="ObjToolBackward" Content="&#x2013;1" Padding="10,4"
                        Click="ObjToolBackward_Click"
                        ToolTipService.ToolTip="Send backward one step" />
                <Button x:Name="ObjToolForward" Content="+1" Padding="10,4"
                        Click="ObjToolForward_Click"
                        ToolTipService.ToolTip="Bring forward one step" />
                <Button x:Name="ObjToolFront" Content="To front" Padding="10,4"
                        Click="ObjToolFront_Click"
                        ToolTipService.ToolTip="Bring in front of everything else on the page" />
                <Rectangle Width="1" Margin="3,4" VerticalAlignment="Stretch"
                           Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Button x:Name="ObjToolDelete" Content="Delete" Padding="10,4"
                        Click="ObjToolDelete_Click"
                        ToolTipService.ToolTip="Delete the selected objects" />
            </StackPanel>
        </Border>

        <!--
            Empty state. Without it a fresh launch is an unexplained grey void
            with no indication that anything works or what to do next.
        -->
        <!--
            Empty state. Hit-testable and double-tappable, so the obvious
            gesture on a blank canvas actually opens a file.
        -->
        <Border Grid.Column="2" Background="Transparent"
                DoubleTapped="EmptyState_DoubleTapped"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xEA90;" FontSize="40" Foreground="#8AFFFFFF" HorizontalAlignment="Center" />
                <TextBlock Text="No document open" Foreground="#C8FFFFFF" HorizontalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Double-click here, or press Ctrl+O" Foreground="#8AFFFFFF"
                           HorizontalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>
        </Border>

        <!--
            Tool rail: icons only, vertical, hugging the left edge. The tools
            stay a glanceable column the way a canvas app expects, and cost a
            fixed 44px of overlay instead of a full toolbar row of height.
        -->
        <!--
            Docked flush to the window edge, full height, rather than floating
            centred with a margin either side. A floating pill spent width on
            gaps on both sides and left the tools bobbing in the middle of the
            window with nothing to align to; docked, the rail has an edge to sit
            against and the settings button has a bottom to sit at.
        -->
        <Border x:Name="ToolRail" Grid.Column="0" VerticalAlignment="Stretch" Margin="0"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0" CornerRadius="0" Padding="4,4,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--
                    Drag handle. Dragging the rail DOCKS it to the nearer side
                    rather than leaving it floating anywhere: a floating rail
                    would sit on top of the page, which is the overlap problem
                    the column layout exists to prevent. Docking keeps it
                    movable and keeps non-overlap guaranteed by layout.
                -->
                <Border x:Name="RailGrip" Height="18" Background="Transparent"
                        ToolTipService.ToolTip="Drag to move the toolbar to the other side"
                        PointerPressed="RailGrip_PointerPressed"
                        PointerMoved="RailGrip_PointerMoved"
                        PointerReleased="RailGrip_PointerReleased"
                        PointerCaptureLost="RailGrip_PointerReleased">
                    <Rectangle Width="18" Height="3" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                </Border>
                <!--
                    The tools themselves come from ToolCatalog, one row each.

                    They used to be six hand-written buttons plus a method that
                    assigned six backgrounds by name, so adding a tool meant
                    editing three places and forgetting any one of them left a
                    tool that could not be reached or never looked armed. A
                    single-selection list also means the ARMED tool is drawn by
                    the framework's own selection visual rather than by
                    assigning brushes, which is what made the previous rail look
                    hand-made.
                -->
                <ListView x:Name="ToolRailList" Grid.Row="1" VerticalAlignment="Top"
                          ItemsSource="{x:Bind viewport:ToolCatalog.All}"
                          SelectionMode="Single"
                          SelectionChanged="ToolRail_SelectionChanged"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Padding="0" BorderThickness="0" Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Width" Value="36" />
                            <Setter Property="Height" Value="36" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewport:ToolDefinition">
                            <!--
                                One ContentControl whose content is chosen per
                                tool: a FontIcon for the glyph tools, a scaled
                                Path for the ones that carry PathData. Deciding
                                in code keeps the rail data-driven, since a tool
                                still declares its own icon in its record.
                            -->
                            <ContentControl Content="{x:Bind local:MainPage.ToolIcon((viewport:ToolDefinition))}"
                                            IsTabStop="False"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind Tooltip}"
                                            AutomationProperties.Name="{x:Bind Name}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--
                    Pinned to the bottom of the rail, which is what the docked
                    full-height shape buys: these are about the app rather than
                    about a mark on the page, so they sit apart from the tools.
                -->
                <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="2" VerticalAlignment="Bottom">
                <Rectangle Height="1" Margin="6,4" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />

                <Button Click="ToggleThumbnails_Click" ToolTipService.ToolTip="Pages (F4)"
                        Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE8A9;" FontSize="16" />
                </Button>

                <!-- Only shown when the open document actually has fillable fields. -->
                <ToggleButton x:Name="FillFormButton"
                              ToolTipService.ToolTip="Fill form fields"
                              Visibility="{x:Bind ViewModel.FillFormButtonVisibility, Mode=OneWay}"
                              IsChecked="{x:Bind ViewModel.FormFillMode, Mode=TwoWay}"
                              Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE762;" FontSize="16" />
                </ToggleButton>

                <Button ToolTipService.ToolTip="Menu"
                        Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Right">
                            <MenuFlyoutItem Text="New" Click="New_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="N" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Open..." Click="OpenFile_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="RecentMenu" Text="Recent files" />
                            <MenuFlyoutSeparator />
                            <!--
                                The accelerators here have to match
                                KeyboardCommands, not just look right in the
                                menu. Once a flyout has been opened its
                                accelerators go live and fire BEFORE the page's
                                key handler, so a stale one silently steals the
                                chord: Save As kept Ctrl+S after Save was added
                                and went on opening the picker.
                            -->
                            <MenuFlyoutItem Text="Save" Click="Save_Click"
                                            IsEnabled="{x:Bind ViewModel.HasDocumentPath, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="S" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Save As..." Click="SaveAs_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <!--
                                Flattening used to be what an ordinary Save did,
                                silently. It is now its own command, confirmed
                                first, because it is the one save whose result
                                cannot be undone by reopening the file.
                            -->
                            <MenuFlyoutItem Text="Flatten and save a copy..." Click="FlattenSaveAs_Click" />
                            <MenuFlyoutItem Text="Print..." Click="Print_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE749;" />
                                </MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="P" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind ViewModel.UndoLabel, Mode=OneWay}" Click="Undo_Click"
                                            IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="Z" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.RedoLabel, Mode=OneWay}" Click="Redo_Click"
                                            IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="Y" />
                                    <!-- Ctrl+Shift+Z as well: both are standard for redo on
                                         Windows and users arrive expecting whichever their
                                         previous editor used. -->
                                    <KeyboardAccelerator Modifiers="Control,Shift" Key="Z" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <!--
                                Everything below is grouped by what it acts on.
                                These are the entries that made the menu thirty
                                rows long, and they are also the ones reached
                                least often, so they cost a hover and save the
                                list.
                            -->
                            <MenuFlyoutSubItem Text="Pages">
                                <MenuFlyoutSubItem Text="Insert">
                                    <MenuFlyoutItem Text="From file..." Click="InsertFromFile_Click" />
                                    <MenuFlyoutItem Text="A blank page" Click="InsertBlankPage_Click" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutItem Text="Extract pages..." Click="ExtractPagesMenu_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Rotate page 90" Click="RotatePage_Click" />
                                <MenuFlyoutItem Text="Rotate pages..." Click="RotatePagesMenu_Click" />
                                <MenuFlyoutItem Text="Delete page" Click="DeletePage_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Name="SignatureMenu" Text="Signature" />
                            <MenuFlyoutSubItem Text="Arrange">
                                <MenuFlyoutItem Text="Group" Click="Group_Click">
                                    <MenuFlyoutItem.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control" Key="G" />
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Ungroup" Click="Ungroup_Click">
                                    <MenuFlyoutItem.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control,Shift" Key="G" />
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="View">
                                <ToggleMenuFlyoutItem x:Name="RulersToggle" Text="Rulers"
                                                      IsChecked="True" Click="RulersToggle_Click">
                                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control" Key="R" />
                                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                                </ToggleMenuFlyoutItem>
                                <MenuFlyoutSubItem Text="Ruler units">
                                <RadioMenuFlyoutItem x:Name="UnitInches" Text="Inches"
                                                     GroupName="RulerUnit" IsChecked="True"
                                                     Click="RulerUnit_Click" Tag="Inches" />
                                <RadioMenuFlyoutItem x:Name="UnitCentimeters" Text="Centimeters"
                                                     GroupName="RulerUnit"
                                                     Click="RulerUnit_Click" Tag="Centimeters" />
                                <RadioMenuFlyoutItem x:Name="UnitMillimeters" Text="Millimeters"
                                                     GroupName="RulerUnit"
                                                     Click="RulerUnit_Click" Tag="Millimeters" />
                                <RadioMenuFlyoutItem x:Name="UnitPoints" Text="Points"
                                                     GroupName="RulerUnit"
                                                     Click="RulerUnit_Click" Tag="Points" />
                                    <RadioMenuFlyoutItem x:Name="UnitPicas" Text="Picas"
                                                         GroupName="RulerUnit"
                                                         Click="RulerUnit_Click" Tag="Picas" />
                                </MenuFlyoutSubItem>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Close document" Click="CloseDocument_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="W" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="About Ayaan PDF" Click="About_Click" />
                            <MenuFlyoutItem Text="Exit" Click="Exit_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button Click="Settings_Click" ToolTipService.ToolTip="Settings"
                        Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            Property bar: the options belonging to the ARMED tool, and nothing
            else.

            These controls used to live behind a second button in the rail, in
            a flyout, which is two clicks to change a colour and no way to see
            the current one without opening it. Sitting them above the canvas
            makes the state of the tool readable at a glance and each change one
            click, the way an options bar works in a drawing app.

            Which sections appear is decided by the tool's ToolOptions, so a
            tool declares what it offers in one record rather than here.
            Collapsed entirely for tools that offer nothing, so the canvas is
            uncluttered whenever the bar has nothing to say.
        -->
        <!-- ZIndex 30: ABOVE the floating object toolbar (20). Both are
             top-aligned in this column and the object toolbar clamps to a few
             pixels from the top of the viewport, so a selection near the top of
             a page put it straight over this bar and hid whatever was under it.
             The property bar is the app's chrome and wins. -->
        <Border x:Name="PropertyBar" Grid.Column="2" Visibility="Collapsed"
                Canvas.ZIndex="30"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,12,12,0"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="18" Padding="10,4"
                AutomationProperties.Name="Tool options">
            <!--
                Scrollable, so the bar CANNOT clip. A horizontal StackPanel does
                not compress: the drawing tool's sections come to roughly 500
                DIP, which fits any normal window and silently loses its last
                control on a narrow one. The ScrollViewer caps the bar at the
                column width and lets what does not fit be reached instead of
                cut off, and it costs nothing at the sizes that do fit.
            -->
            <!--
                Two rows, not one scrolling row: a bar you have to scroll hides
                controls. Row 1 carries the general sections (colour, width,
                shape, size); row 2 the rest (font, text style, opacity,
                stamps). Sections still show or hide per tool, and row 2 is
                collapsed whenever none of its sections apply, so a simple tool
                stays a single row.
            -->
            <StackPanel Orientation="Vertical" Spacing="4">
            <StackPanel x:Name="PropertyBarRow1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" HorizontalAlignment="Center">

                <TextBlock x:Name="PropertyBarToolName" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />

                <!-- Colour -->
                <StackPanel x:Name="ColorSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <ListView x:Name="ColorChoices" SelectionMode="Single"
                              SelectionChanged="InkColor_SelectionChanged"
                              Padding="0" BorderThickness="0" Background="Transparent"
                              AutomationProperties.Name="Colour"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Width" Value="30" />
                                <Setter Property="Height" Value="30" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="1,0" />
                                <Setter Property="CornerRadius" Value="15" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewport:InkColor">
                                <!-- Inset from the 30px container so the
                                     selection ring around it stays visible. -->
                                <Border Width="20" Height="20" CornerRadius="10"
                                        ToolTipService.ToolTip="{x:Bind Name}"
                                        AutomationProperties.Name="{x:Bind Name}"
                                        Background="{x:Bind local:MainPage.HexBrush(Hex)}"
                                        BorderBrush="#66000000" BorderThickness="1" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--
                        Custom colour. The swatch always shows the tool's CURRENT
                        colour, so it doubles as the "you are here" indicator when
                        the chosen colour is not one of the presets. Clicking it
                        opens a full picker, so the presets are the common path and
                        any colour is one click further.
                    -->
                    <Button x:Name="CustomColorButton" Width="30" Height="30" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Custom colour"
                            ToolTipService.ToolTip="Custom colour">
                        <Grid Width="22" Height="22">
                            <Ellipse Stroke="#66000000" StrokeThickness="1">
                                <Ellipse.Fill>
                                    <!-- A hue ring, so the button reads as "pick any colour". -->
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFE00000" Offset="0.0" />
                                        <GradientStop Color="#FFF5B800" Offset="0.25" />
                                        <GradientStop Color="#FF2E9E3B" Offset="0.5" />
                                        <GradientStop Color="#FF1565C0" Offset="0.75" />
                                        <GradientStop Color="#FF7B1FA2" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <!-- The inner dot is the current colour. -->
                            <Ellipse x:Name="CustomColorSwatch" Width="11" Height="11"
                                     Stroke="#88FFFFFF" StrokeThickness="1" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="CustomColorFlyout" Placement="Bottom"
                                    Opening="CustomColorFlyout_Opening">
                                <ColorPicker x:Name="CustomColorPicker"
                                             IsAlphaEnabled="False"
                                             IsMoreButtonVisible="True"
                                             ColorSpectrumShape="Box"
                                             Width="280"
                                             ColorChanged="CustomColor_Changed" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- Width -->
                <StackPanel x:Name="WidthSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <ListView x:Name="WidthChoices" SelectionMode="Single"
                              SelectionChanged="InkWidth_SelectionChanged"
                              Padding="0" BorderThickness="0" Background="Transparent"
                              AutomationProperties.Name="Stroke width"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Width" Value="34" />
                                <Setter Property="Height" Value="30" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="1,0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewport:InkWidth">
                                <!-- The width itself is the label: a row of
                                     names would say less and take more room. -->
                                <Rectangle Width="20" RadiusX="4" RadiusY="4"
                                           VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind Name}"
                                           AutomationProperties.Name="{x:Bind Name}"
                                           Height="{x:Bind local:MainPage.WidthPreview(Value)}"
                                           Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!--
                    Shape kind. Drawn as real geometry rather than icon-font
                    glyphs: the picker then shows exactly what each tool draws,
                    including the arrowhead, and cannot drift from it the way a
                    stand-in glyph would.
                -->
                <StackPanel x:Name="ShapeSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <ListView x:Name="ShapeChoices" SelectionMode="Single"
                              SelectionChanged="ShapeKind_SelectionChanged"
                              Padding="0" BorderThickness="0" Background="Transparent"
                              AutomationProperties.Name="Shape"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Width" Value="34" />
                                <Setter Property="Height" Value="30" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="1,0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListViewItem Tag="Rectangle" ToolTipService.ToolTip="Rectangle"
                                      AutomationProperties.Name="Rectangle">
                            <Rectangle Width="20" Height="14" RadiusX="1" RadiusY="1"
                                       Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                       StrokeThickness="1.5" />
                        </ListViewItem>
                        <ListViewItem Tag="Ellipse" ToolTipService.ToolTip="Ellipse"
                                      AutomationProperties.Name="Ellipse">
                            <Ellipse Width="20" Height="14"
                                     Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                     StrokeThickness="1.5" />
                        </ListViewItem>
                        <ListViewItem Tag="Line" ToolTipService.ToolTip="Line"
                                      AutomationProperties.Name="Line">
                            <Line X1="0" Y1="14" X2="20" Y2="0"
                                  Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                  StrokeThickness="1.5" />
                        </ListViewItem>
                        <ListViewItem Tag="Arrow" ToolTipService.ToolTip="Arrow"
                                      AutomationProperties.Name="Arrow">
                            <!--
                                Built the same way the tool draws: a shaft that
                                STOPS at the head, plus a solid triangle. The
                                first version was a hand-drawn polyline whose
                                barbs came out as a stray tick, which is what an
                                icon made by eye instead of from the geometry
                                gets you.
                            -->
                            <Grid Width="20" Height="14">
                                <Line X1="1" Y1="13" X2="13.2" Y2="4.9"
                                      Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" />
                                <Polygon Points="19,1 14.8,7.3 11.6,2.5"
                                         Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </ListViewItem>
                        <!--
                            APPENDED, not inserted. SetToolSections selects by
                            `SelectedIndex = (int)ActiveShapeKind`, so an item
                            placed anywhere but last would put every kind after
                            it out of step with its enum value.

                            RadiusX/Y 4 against the plain Rectangle icon's 1, so
                            the two are told apart at 20x14.
                        -->
                        <ListViewItem Tag="RoundedRectangle" ToolTipService.ToolTip="Rounded rectangle"
                                      AutomationProperties.Name="Rounded rectangle">
                            <Rectangle Width="20" Height="14" RadiusX="4" RadiusY="4"
                                       Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                       StrokeThickness="1.5" />
                        </ListViewItem>
                    </ListView>
                </StackPanel>

                <!-- Font size -->
                <StackPanel x:Name="FontSizeSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <FontIcon Glyph="&#xE8E9;" FontSize="13" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              ToolTipService.ToolTip="Font size" />
                    <ListView x:Name="FontSizeChoices" SelectionMode="Single"
                              SelectionChanged="FontSize_SelectionChanged"
                              Padding="0" BorderThickness="0" Background="Transparent"
                              AutomationProperties.Name="Font size"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Height" Value="30" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="Margin" Value="1,0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewport:FontSize">
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"
                                           AutomationProperties.Name="{x:Bind Name}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

            </StackPanel>
            <!-- Row 2: font, text style, opacity, stamps. -->
            <StackPanel x:Name="PropertyBarRow2" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Font family + bold/italic/underline/strikethrough. Unicode:
                     pick any installed font (including a local-language one). -->
                <StackPanel x:Name="FontSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <ComboBox x:Name="FontFamilyCombo" Width="164" Height="30" Padding="8,0"
                              PlaceholderText="Default font"
                              SelectionChanged="FontFamily_SelectionChanged"
                              ItemsSource="{x:Bind ViewModel.FontFamilies, Mode=OneWay}"
                              ToolTipService.ToolTip="Font"
                              AutomationProperties.Name="Font">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewport:FontFamily">
                                <TextBlock Text="{x:Bind Name}"
                                           FontFamily="{x:Bind Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ToggleButton x:Name="BoldBtn" Click="Bold_Click"
                                  Width="30" Height="30" Padding="0"
                                  AutomationProperties.Name="Bold"
                                  ToolTipService.ToolTip="Bold">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="15" />
                    </ToggleButton>
                    <ToggleButton x:Name="ItalicBtn" Click="Italic_Click"
                                  Width="30" Height="30" Padding="0"
                                  AutomationProperties.Name="Italic"
                                  ToolTipService.ToolTip="Italic">
                        <TextBlock Text="I" FontStyle="Italic" FontSize="15" FontFamily="Georgia" />
                    </ToggleButton>
                    <ToggleButton x:Name="UnderlineBtn" Click="Underline_Click"
                                  Width="30" Height="30" Padding="0"
                                  AutomationProperties.Name="Underline"
                                  ToolTipService.ToolTip="Underline">
                        <TextBlock Text="U" FontSize="15" TextDecorations="Underline" />
                    </ToggleButton>
                    <ToggleButton x:Name="StrikethroughBtn" Click="Strikethrough_Click"
                                  Width="30" Height="30" Padding="0"
                                  AutomationProperties.Name="Strikethrough"
                                  ToolTipService.ToolTip="Strikethrough">
                        <TextBlock Text="S" FontSize="15" TextDecorations="Strikethrough" />
                    </ToggleButton>
                </StackPanel>

                <!-- Text alignment, fill and outline -->
                <StackPanel x:Name="TextStyleSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />

                    <!-- Alignment: one of four, radio-style. Text-only; hidden
                         when TextStyleSection is showing for a shape (which
                         has no text alignment to speak of). -->
                    <StackPanel x:Name="TextAlignRow" Orientation="Horizontal" Spacing="1">
                        <ToggleButton x:Name="AlignLeftBtn" Tag="Left" Click="Align_Click"
                                      Width="30" Height="30" Padding="0"
                                      AutomationProperties.Name="Align left"
                                      ToolTipService.ToolTip="Align left">
                            <FontIcon Glyph="&#xE8E4;" FontSize="14" />
                        </ToggleButton>
                        <ToggleButton x:Name="AlignCenterBtn" Tag="Center" Click="Align_Click"
                                      Width="30" Height="30" Padding="0"
                                      AutomationProperties.Name="Center"
                                      ToolTipService.ToolTip="Center">
                            <FontIcon Glyph="&#xE8E3;" FontSize="14" />
                        </ToggleButton>
                        <ToggleButton x:Name="AlignRightBtn" Tag="Right" Click="Align_Click"
                                      Width="30" Height="30" Padding="0"
                                      AutomationProperties.Name="Align right"
                                      ToolTipService.ToolTip="Align right">
                            <FontIcon Glyph="&#xE8E2;" FontSize="14" />
                        </ToggleButton>
                        <ToggleButton x:Name="AlignJustifyBtn" Tag="Justify" Click="Align_Click"
                                      Width="30" Height="30" Padding="0"
                                      AutomationProperties.Name="Justify"
                                      ToolTipService.ToolTip="Justify">
                            <!-- No Segoe glyph reads as justify, so it is drawn:
                                 four full, equal lines. -->
                            <StackPanel Spacing="2.5" VerticalAlignment="Center">
                                <Rectangle Width="16" Height="1.6" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Rectangle Width="16" Height="1.6" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Rectangle Width="16" Height="1.6" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Rectangle Width="16" Height="1.6" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />

                    <!-- Fill -->
                    <Button x:Name="FillButton" Width="30" Height="30" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Fill colour"
                            ToolTipService.ToolTip="Fill">
                        <Grid Width="20" Height="20">
                            <Border x:Name="FillSwatch" CornerRadius="4"
                                    BorderBrush="#66000000" BorderThickness="1" />
                            <!-- Diagonal shown when there is no fill. -->
                            <Line x:Name="FillNoneSlash" X1="2" Y1="18" X2="18" Y2="2"
                                  Stroke="#C0D13438" StrokeThickness="1.5" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="FillFlyout" Placement="Bottom" Opening="FillFlyout_Opening">
                                <StackPanel Spacing="6" Width="272">
                                    <TextBlock Text="Standard colours" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <!-- Row 1: neutrals + warm -->
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Width="28" Height="28" Padding="0" Background="#FF000000" Tag="#FF000000" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FF404040" Tag="#FF404040" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FF808080" Tag="#FF808080" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFC0C0C0" Tag="#FFC0C0C0" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFFFFFFF" Tag="#FFFFFFFF" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFD13438" Tag="#FFD13438" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFF7630C" Tag="#FFF7630C" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFFFB900" Tag="#FFFFB900" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                    </StackPanel>
                                    <!-- Row 2: cool + tints -->
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Width="28" Height="28" Padding="0" Background="#FF107C10" Tag="#FF107C10" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FF00B7C3" Tag="#FF00B7C3" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FF0078D4" Tag="#FF0078D4" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FF8764B8" Tag="#FF8764B8" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFE3008C" Tag="#FFE3008C" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FF7A4200" Tag="#FF7A4200" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFFFF4CE" Tag="#FFFFF4CE" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFDFF6DD" Tag="#FFDFF6DD" Click="FillPreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                    </StackPanel>
                                    <Button Content="No fill" HorizontalAlignment="Stretch" Click="NoFill_Click" />
                                    <Expander Header="Custom colour" HorizontalAlignment="Stretch" IsExpanded="False">
                                        <ColorPicker x:Name="FillPicker" IsAlphaEnabled="False"
                                                     IsMoreButtonVisible="True" ColorSpectrumShape="Box"
                                                     Width="256" ColorChanged="FillColor_Changed" />
                                    </Expander>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Outline -->
                    <Button x:Name="OutlineButton" Width="30" Height="30" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Outline colour"
                            ToolTipService.ToolTip="Outline">
                        <Grid Width="20" Height="20">
                            <Border x:Name="OutlineSwatch" CornerRadius="4" Background="Transparent"
                                    BorderBrush="#FF1565C0" BorderThickness="2" />
                            <Line x:Name="OutlineNoneSlash" X1="2" Y1="18" X2="18" Y2="2"
                                  Stroke="#C0D13438" StrokeThickness="1.5" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="OutlineFlyout" Placement="Bottom" Opening="OutlineFlyout_Opening">
                                <StackPanel Spacing="6" Width="272">
                                    <TextBlock Text="Standard colours" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Width="28" Height="28" Padding="0" Background="#FF000000" Tag="#FF000000" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FF404040" Tag="#FF404040" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FF808080" Tag="#FF808080" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFC0C0C0" Tag="#FFC0C0C0" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFFFFFFF" Tag="#FFFFFFFF" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFD13438" Tag="#FFD13438" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFF7630C" Tag="#FFF7630C" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFFFB900" Tag="#FFFFB900" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Width="28" Height="28" Padding="0" Background="#FF107C10" Tag="#FF107C10" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FF00B7C3" Tag="#FF00B7C3" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FF0078D4" Tag="#FF0078D4" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FF8764B8" Tag="#FF8764B8" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFE3008C" Tag="#FFE3008C" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FF7A4200" Tag="#FF7A4200" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFFFF4CE" Tag="#FFFFF4CE" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <Button Width="28" Height="28" Padding="0" Background="#FFDFF6DD" Tag="#FFDFF6DD" Click="OutlinePreset_Click" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                    </StackPanel>
                                    <TextBlock Text="Thickness" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel x:Name="ThicknessRow" Orientation="Horizontal" Spacing="4">
                                        <RadioButton x:Name="Thickness1" GroupName="OutlineThickness" Content="1 pt" Tag="1" Click="OutlineThickness_Click" MinWidth="0" Padding="8,2" />
                                        <RadioButton x:Name="Thickness2" GroupName="OutlineThickness" Content="2 pt" Tag="2" Click="OutlineThickness_Click" MinWidth="0" Padding="8,2" />
                                        <RadioButton x:Name="Thickness3" GroupName="OutlineThickness" Content="3 pt" Tag="3" Click="OutlineThickness_Click" MinWidth="0" Padding="8,2" />
                                        <RadioButton x:Name="Thickness5" GroupName="OutlineThickness" Content="5 pt" Tag="5" Click="OutlineThickness_Click" MinWidth="0" Padding="8,2" />
                                    </StackPanel>
                                    <Button Content="No outline" HorizontalAlignment="Stretch" Click="NoOutline_Click" />
                                    <Expander Header="Custom colour" HorizontalAlignment="Stretch" IsExpanded="False">
                                        <ColorPicker x:Name="OutlinePicker" IsAlphaEnabled="False"
                                                     IsMoreButtonVisible="True" ColorSpectrumShape="Box"
                                                     Width="256" ColorChanged="OutlineColor_Changed" />
                                    </Expander>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- Opacity: stroke on the left, an optional fill slider on
                     the right (visible only when the selected object HAS a
                     fill - a filled shape today, potentially a text box's
                     fill tomorrow). Two sliders means the labels stop being
                     optional: "Stroke" and "Fill" precede each so a user
                     doesn't have to guess which they are dragging. -->
                <StackPanel x:Name="OpacitySection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <TextBlock Text="Stroke" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <!--
                        Maximum BEFORE Minimum, and that is not cosmetic: XAML
                        assigns attributes in written order, and a Minimum above
                        the Maximum in force at that moment is rejected outright.
                        Written the other way round this threw a XamlParseException
                        from InitializeComponent and the app died at startup with
                        nothing but a hex code on screen.

                        ValueChanged is attached LAST for the same reason: setting
                        Minimum coerces Value up to it, and a handler already
                        wired would take that for the user choosing 10% and
                        rewrite the tool's colour before the app had even loaded.
                    -->
                    <Slider x:Name="OpacitySlider" Width="88" Maximum="100" Minimum="10"
                            StepFrequency="5" TickFrequency="10"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Stroke opacity"
                            ToolTipService.ToolTip="Stroke opacity"
                            ValueChanged="Opacity_ValueChanged" />
                    <TextBlock x:Name="OpacityReadout" VerticalAlignment="Center" MinWidth="34"
                               TextAlignment="Right"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />

                    <!-- Fill opacity: separate slider so a user can dim just
                         the fill (keep the outline crisp) or vice versa.
                         Collapsed until the selection actually has a fill. -->
                    <StackPanel x:Name="FillOpacitySection" Orientation="Horizontal"
                                Spacing="6" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                                   Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <TextBlock Text="Fill" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="FillOpacitySlider" Width="88" Maximum="100" Minimum="10"
                                StepFrequency="5" TickFrequency="10"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Fill opacity"
                                ToolTipService.ToolTip="Fill opacity"
                                ValueChanged="FillOpacity_ValueChanged" />
                        <TextBlock x:Name="FillOpacityReadout" VerticalAlignment="Center" MinWidth="34"
                                   TextAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>

                    <!-- Corner radius. Only meaningful for a rounded rectangle,
                         so it is collapsed for every other kind rather than sat
                         there doing nothing. A PERCENTAGE of the roundest the
                         box can be, not an absolute measurement: the control
                         then means the same thing on a small badge and a
                         full-page box, and it survives a resize. -->
                    <StackPanel x:Name="CornerRadiusSection" Orientation="Horizontal"
                                Spacing="6" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                                   Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <TextBlock Text="Corners" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="CornerRadiusSlider" Width="88" Maximum="100" Minimum="0"
                                StepFrequency="5" TickFrequency="25"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Corner radius"
                                ToolTipService.ToolTip="Corner radius (0 is square)"
                                ValueChanged="CornerRadius_ValueChanged" />
                        <TextBlock x:Name="CornerRadiusReadout" VerticalAlignment="Center" MinWidth="34"
                                   TextAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- Align + distribute. Shown only when 2+ annotations are selected. -->
                <StackPanel x:Name="AlignSection" Orientation="Horizontal" Spacing="3"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Button Width="28" Height="28" Padding="0" Tag="Left" Click="AlignObjects_Click"
                            ToolTipService.ToolTip="Align left edges">
                        <FontIcon Glyph="&#xE8E4;" FontSize="14" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0" Tag="CenterH" Click="AlignObjects_Click"
                            ToolTipService.ToolTip="Align horizontal centres">
                        <FontIcon Glyph="&#xE8E3;" FontSize="14" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0" Tag="Right" Click="AlignObjects_Click"
                            ToolTipService.ToolTip="Align right edges">
                        <FontIcon Glyph="&#xE8E2;" FontSize="14" />
                    </Button>
                    <Rectangle Width="1" Height="14" VerticalAlignment="Center"
                               Margin="2,0" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <!-- Vertical alignment icons: the same three Fluent align glyphs used above
                         for horizontal, ROTATED 90 degrees. Same visual language, different axis. -->
                    <Button Width="28" Height="28" Padding="0" Tag="Top" Click="AlignObjects_Click"
                            ToolTipService.ToolTip="Align top edges">
                        <FontIcon Glyph="&#xE8E4;" FontSize="14"
                                  RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform Angle="90" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                    <Button Width="28" Height="28" Padding="0" Tag="MiddleV" Click="AlignObjects_Click"
                            ToolTipService.ToolTip="Align vertical centres">
                        <FontIcon Glyph="&#xE8E3;" FontSize="14"
                                  RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform Angle="90" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                    <Button Width="28" Height="28" Padding="0" Tag="Bottom" Click="AlignObjects_Click"
                            ToolTipService.ToolTip="Align bottom edges">
                        <FontIcon Glyph="&#xE8E2;" FontSize="14"
                                  RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform Angle="90" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                    <Rectangle Width="1" Height="14" VerticalAlignment="Center"
                               Margin="2,0" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Button Width="28" Height="28" Padding="0" Tag="H" Click="Distribute_Click"
                            ToolTipService.ToolTip="Distribute horizontally (3+ objects)">
                        <TextBlock Text="↔" FontSize="14" HorizontalAlignment="Center" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0" Tag="V" Click="Distribute_Click"
                            ToolTipService.ToolTip="Distribute vertically (3+ objects)">
                        <TextBlock Text="↕" FontSize="14" HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>

                <!-- Stamps -->
                <StackPanel x:Name="StampSection" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Rectangle Width="1" Height="18" VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <TextBlock x:Name="StampEmptyHint" Text="No stamps yet"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <ListView x:Name="StampChoices" SelectionMode="Single"
                              SelectionChanged="StampChoice_SelectionChanged"
                              MaxWidth="320" Padding="0" BorderThickness="0" Background="Transparent"
                              AutomationProperties.Name="Stamp"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Width" Value="40" />
                                <Setter Property="Height" Value="34" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="1,0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:StampEntry">
                                <Image Width="30" Height="26" Stretch="Uniform"
                                       ToolTipService.ToolTip="{x:Bind Name}"
                                       AutomationProperties.Name="{x:Bind Name}"
                                       Source="{x:Bind local:MainPage.StampThumbnail(Path)}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Click="AddStamp_Click" Width="30" Height="30" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Add a stamp"
                            ToolTipService.ToolTip="Add a PNG stamp">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                    </Button>
                    <Button Click="OpenStampFolder_Click" Width="30" Height="30" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Open the stamp folder"
                            ToolTipService.ToolTip="Open the stamp folder">
                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                    </Button>
                </StackPanel>

            </StackPanel>
            </StackPanel>
        </Border>

        <!--
            Pages panel as an OVERLAY, not a permanent column, so it never
            takes width away from the canvas. Hidden until asked for.
        -->
        <Border x:Name="ThumbnailPanel" Visibility="Collapsed"
                Grid.Column="1" Margin="0,12,12,12"
                Width="{x:Bind ViewModel.ThumbnailPaneWidth, Mode=OneWay}"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    Resize grip on the panel's INNER edge (the one facing the
                    document): the right edge while docked left, flipped to the
                    left edge when the panel is moved to the right. Dragging it
                    toward the document widens the thumbnails, away narrows them.
                    A thin transparent strip, so the whole edge is grabbable.
                -->
                <Border x:Name="ThumbnailResizeGrip" Width="8" HorizontalAlignment="Right"
                        Grid.RowSpan="2" Background="Transparent" Canvas.ZIndex="2"
                        ToolTipService.ToolTip="Drag to resize, or Ctrl+scroll"
                        PointerPressed="ThumbnailResize_PointerPressed"
                        PointerMoved="ThumbnailResize_PointerMoved"
                        PointerReleased="ThumbnailResize_PointerReleased"
                        PointerCaptureLost="ThumbnailResize_PointerReleased" />

                <!-- Header: what the panel is, and how many pages, with a hint
                     that they can be dragged. -->
                <Grid Padding="14,10,10,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Pages" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.PageCount, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>

                <ListView
                Grid.Row="1"
                x:Name="ThumbnailList"
                PointerWheelChanged="ThumbnailList_PointerWheelChanged"
                Padding="8,0,8,8"
                ItemsSource="{x:Bind ViewModel.Thumbnails}"
                SelectedIndex="{x:Bind ViewModel.CurrentPageIndex, Mode=OneWay}"
                IsItemClickEnabled="True"
                ItemClick="ThumbnailList_ItemClick"
                CanReorderItems="True"
                CanDragItems="True"
                AllowDrop="True"
                ContainerContentChanging="ThumbnailList_ContainerContentChanging">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:PageThumbnail">
                        <StackPanel Spacing="4" Margin="0,0,0,12" Width="{x:Bind CardWidth, Mode=OneWay}">
                            <!--
                                Right-click a page for the actions drag cannot do:
                                rotate, duplicate, delete, and a keyboard-free
                                nudge up or down.
                            -->
                            <StackPanel.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Rotate 90&#176;" Click="PageRotate_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7AD;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Rotate pages..." Click="PageRotateDialog_Click" />
                                    <MenuFlyoutItem Text="Duplicate" Click="PageDuplicate_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Insert blank page after" Click="PageInsertBlankAfter_Click" />
                                    <MenuFlyoutItem Text="Extract page..." Click="PageExtract_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Move up" Click="PageMoveUp_Click" />
                                    <MenuFlyoutItem Text="Move down" Click="PageMoveDown_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Delete page" Click="PageDelete_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <!-- The page sits on a rounded, shadowed card so it
                                 reads as a sheet, with its number as a small
                                 badge in the corner rather than a line of text
                                 below, which is tidier and saves height. -->
                            <Grid>
                                <Border CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        Background="White">
                                    <Border.Shadow>
                                        <ThemeShadow />
                                    </Border.Shadow>
                                    <Image
                                        Source="{x:Bind Bitmap, Mode=OneWay}"
                                        Stretch="Uniform"
                                        Width="{x:Bind CardWidth, Mode=OneWay}"
                                        Height="{x:Bind CardHeight, Mode=OneWay}" />
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,4,4" CornerRadius="8" Padding="6,1"
                                        Background="#B0000000">
                                    <TextBlock Text="{x:Bind DisplayNumber}"
                                               Foreground="White" FontSize="11" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!--
            Rotate Pages dialog. The quick right-click "Rotate 90" is one page,
            one click; this is for rotating many at once, by a chosen amount,
            filtered by range, odd/even and orientation. Laid out here but only
            shown via ShowAsync, so it costs nothing until opened.
        -->
        <ContentDialog x:Name="RotatePagesDialog" Title="Rotate pages"
                       PrimaryButtonText="Rotate" CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <StackPanel Spacing="16" Width="300">
                <StackPanel Spacing="4">
                    <TextBlock Text="Direction" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="RotateDirectionCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Clockwise 90&#176;" Tag="90" />
                        <ComboBoxItem Content="Counterclockwise 90&#176;" Tag="-90" />
                        <ComboBoxItem Content="180&#176;" Tag="180" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Pages" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <RadioButton x:Name="RotateRangeAll" Content="All" GroupName="rotateRange" IsChecked="True" />
                    <RadioButton x:Name="RotateRangeCurrent" Content="Current page" GroupName="rotateRange" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <RadioButton x:Name="RotateRangePages" Content="Pages" GroupName="rotateRange"
                                     VerticalAlignment="Center" MinWidth="64" />
                        <TextBox x:Name="RotateFrom" Width="52" InputScope="Number"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="to" VerticalAlignment="Center" />
                        <TextBox x:Name="RotateTo" Width="52" InputScope="Number"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Apply to" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="RotateParityCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Even and odd pages" />
                        <ComboBoxItem Content="Odd pages only" />
                        <ComboBoxItem Content="Even pages only" />
                    </ComboBox>
                    <ComboBox x:Name="RotateOrientationCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Pages of any orientation" />
                        <ComboBoxItem Content="Portrait pages only" />
                        <ComboBoxItem Content="Landscape pages only" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </ContentDialog>

        <!-- Extract Pages dialog: a range out to a new file, optionally one
             file per page, optionally removing them from this document. -->
        <ContentDialog x:Name="ExtractPagesDialog" Title="Extract pages"
                       PrimaryButtonText="Extract" CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <StackPanel Spacing="16" Width="300">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="From" VerticalAlignment="Center" />
                    <TextBox x:Name="ExtractFrom" Width="52" VerticalAlignment="Center" />
                    <TextBlock Text="to" VerticalAlignment="Center" />
                    <TextBox x:Name="ExtractTo" Width="52" VerticalAlignment="Center" />
                    <TextBlock x:Name="ExtractOfLabel" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <CheckBox x:Name="ExtractDeleteAfter" Content="Delete pages after extracting" />
                <CheckBox x:Name="ExtractSeparate" Content="Extract pages as separate files" />
            </StackPanel>
        </ContentDialog>

        <!--
            Status pill: page position, zoom, fit and find. Floats bottom
            centre and stays out of the way, replacing a full-width status bar.
        -->
        <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="18" Padding="6,3">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!--
                    The page readout is editable: type a number, press Enter.
                    It lives HERE, in the always-visible status bar, and not in
                    the thumbnail panel header where it was first put: that
                    panel is Collapsed by default, so the box was invisible
                    until someone opened the panel.
                -->
                <StackPanel Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="10,0,6,0">
                    <TextBox x:Name="PageJumpBox" Width="44" Height="26"
                             Padding="4,1,4,1" TextAlignment="Center"
                             FontSize="12" InputScope="Number"
                             KeyDown="PageJumpBox_KeyDown"
                             LostFocus="PageJumpBox_LostFocus"
                             ToolTipService.ToolTip="Go to page" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.PageCountSuffix, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <!-- Says why text selection is unavailable, instead of the
                     tool silently doing nothing on a scanned page. -->
                <TextBlock Text="{x:Bind ViewModel.TextAvailabilityLabel, Mode=OneWay}"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <Rectangle Width="1" Height="16" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Button Content="&#xE949;" FontFamily="Segoe MDL2 Assets" FontSize="11" Click="ZoomOut_Click"
                        Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Zoom out" />
                <!-- Zoom readout doubles as a preset menu. -->
                <Button x:Name="ZoomMenuButton" Width="52" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Zoom presets">
                    <TextBlock x:Name="ZoomPercentText" Text="100%" TextAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem Text="Fit page" Click="ZoomFitPage_Click" />
                            <MenuFlyoutItem Text="Fit width" Click="ZoomFitWidth_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="50%" Click="ZoomPreset_Click" Tag="0.5" />
                            <MenuFlyoutItem Text="100%" Click="ZoomPreset_Click" Tag="1.0" />
                            <MenuFlyoutItem Text="200%" Click="ZoomPreset_Click" Tag="2.0" />
                            <MenuFlyoutItem Text="400%" Click="ZoomPreset_Click" Tag="4.0" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Content="&#xE948;" FontFamily="Segoe MDL2 Assets" FontSize="11" Click="ZoomIn_Click"
                        Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Zoom in" />
                <Button Content="&#xE9A6;" FontFamily="Segoe MDL2 Assets" FontSize="11" Click="ResetZoom_Click"
                        Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Fit width" />
                <Rectangle Width="1" Height="16" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <TextBox x:Name="SearchBox" Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Find" Width="120" Height="28" Margin="2,0,0,0"
                         VerticalAlignment="Center" BorderThickness="0" Background="Transparent"
                         KeyDown="SearchBox_KeyDown" />
                <TextBlock Text="{x:Bind ViewModel.SearchStatus, Mode=OneWay}" VerticalAlignment="Center"
                           MinWidth="52" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <Button Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="SearchPrev_Click"
                        Width="24" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                        IsEnabled="{x:Bind ViewModel.HasSearchMatches, Mode=OneWay}"
                        ToolTipService.ToolTip="Previous match (Shift+Enter)" />
                <Button Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="SearchNext_Click"
                        Width="24" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                        IsEnabled="{x:Bind ViewModel.HasSearchMatches, Mode=OneWay}"
                        ToolTipService.ToolTip="Next match (Enter)" />
                <TextBlock Text="&#9679;" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"
                           ToolTipService.ToolTip="Unsaved changes"
                           Visibility="{x:Bind ViewModel.DirtyIndicatorVisibility, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
