<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PdfEditorApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PdfEditorApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Ayaan PDF"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        Named so the themes can paint it. The tab strip takes its colour from
        here rather than from the TabView, whose Background does not reach it.
    -->
    <!--
        KeyboardAcceleratorPlacementMode=Hidden for the same reason MainPage's
        RootGrid sets it: WinUI advertises an accelerator by floating a tooltip
        naming its chord over the owning element. On a menu item that is useful.
        Here the owner is the entire window, so "Ctrl+Q" appeared over the app
        at startup and sat there.
    -->
    <Grid x:Name="Shell" KeyboardAcceleratorPlacementMode="Hidden">
        <!--
            Quit, from anywhere.

            An ACCELERATOR on the window's root, not a case in the page's key
            handler: that handler ignores every key while a text field has
            focus, so a canvas-only chord would die the moment the caret was in
            the find box or the page-jump field. An accelerator is offered to
            the tree before the focused element routes the key, so it fires
            wherever focus happens to be.

            Not declared on the Exit menu item either. A MenuFlyoutItem's
            accelerator is dead until its flyout has been opened once, which is
            the trap that left Ctrl+Z unimplemented for months; the item carries
            the text only, to print the chord beside it.
        -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="Q" Invoked="Quit_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The commands you reach for without thinking, in the strip of dead
            space above the tabs. The test for what belongs here is whether you
            would look for it: Save As, Flatten and Extract all fail that and
            stay in the menu.

            ONLY TitleDragArea is handed to SetTitleBar. Whatever that call
            receives becomes the drag region and its children stop receiving
            clicks, so a bar with buttons has to keep them in a separate column
            from the part you drag.
        -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                The real app icon, not a glyph that happened to look like a
                page. ms-appx resolves to the app folder for an unpackaged app,
                which is why the csproj had to start copying the .ico there.
            -->
            <StackPanel Orientation="Horizontal" Margin="12,0,6,0"
                        VerticalAlignment="Center">
                <!-- Left as a plain .ico source on purpose. At 18 DIP the
                     decoder picks a small frame and renders it at close to its
                     native size, which is sharp. Adding a DecodePixelWidth here
                     forced a large frame to be squeezed into 27 real pixels and
                     made it visibly WORSE, so this one is better left alone. -->
                <Image Source="ms-appx:///Assets/AppIcon.ico" Width="18" Height="18" />
            </StackPanel>

            <!--
                THE MENU of the tab in front, File to Help, beside the icon where
                every desktop app keeps it. The window only hosts it: each
                MainPage declares its own, because the entries call that page's
                handlers and bind to its view model, and ShowMenuOf swaps it in
                when the front tab changes. One page's menu is in the tree at a
                time, so a tab behind cannot act on keys meant for the one on
                screen.

                Its own column, NOT inside TitleDragArea, which swallows clicks.
            -->
            <Border x:Name="MenuHost" Grid.Column="1" />

            <!--
                AllowFocusOnInteraction="False": a click must leave focus on the
                document. The title bar is outside the page's RootGrid, so a quick
                button left holding focus kept every key from the page's key
                handler, and Ctrl+Z after clicking Undo did nothing until the page
                was clicked. They can still be reached with Tab.
            -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                <Rectangle Width="1" Height="14" Margin="4,0,5,0"
                           Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Button x:Name="QuickOpen" AutomationProperties.Name="Open" Click="QuickOpen_Click" AllowFocusOnInteraction="False" Width="30" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Open (Ctrl+O)">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                </Button>
                <Button x:Name="QuickSave" AutomationProperties.Name="Save" Click="QuickSave_Click" AllowFocusOnInteraction="False" Width="30" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Save (Ctrl+S)">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                </Button>
                <Rectangle Width="1" Height="14" Margin="5,0"
                           Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Button x:Name="QuickUndo" AutomationProperties.Name="Undo" Click="QuickUndo_Click" AllowFocusOnInteraction="False" Width="30" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                </Button>
                <Button x:Name="QuickRedo" AutomationProperties.Name="Redo" Click="QuickRedo_Click" AllowFocusOnInteraction="False" Width="30" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Redo (Ctrl+Y)">
                    <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                </Button>
                <Rectangle Width="1" Height="14" Margin="5,0"
                           Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <!-- Find in the tab in front. It opens that page's own find
                     strip, which stays inside the page so its keys still reach
                     the page's key handler. -->
                <Button x:Name="QuickFind" AutomationProperties.Name="Find" Click="QuickFind_Click" AllowFocusOnInteraction="False" Width="30" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Find (Ctrl+F)">
                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                </Button>
            </StackPanel>

            <!--
                The draggable remainder. It carries the app's name and build and
                nothing that has to be clicked, because a drag region swallows
                clicks. The tabs below already name every open document, and the
                taskbar gets the document name through Window.Title.
            -->
            <Border x:Name="TitleDragArea" Grid.Column="3" Background="Transparent">
                <TextBlock x:Name="TitleText" Text="Ayaan PDF" Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </Border>
        </Grid>

        <!--
            One tab per open document. Each tab's content is its own MainPage,
            and a MainPage owns a ViewportViewModel, so a document's handle,
            path, page slots, selection, history and groups are already
            per-page: tabs needed no change to the view model at all.
        -->
        <!--
            VerticalAlignment is set EXPLICITLY because WinUI's own TabView
            style sets it to Top. A Top-aligned TabView takes only the height it
            needs, which is its tab strip plus whatever the page inside happens
            to want, so the document stopped short of the bottom of the window
            and the Shell's own colour showed through underneath as a band of
            dead space. Measured: in a 680-tall window the TabView came out 523
            and left 123 blank. A local value beats the style setter.
        -->
        <TabView x:Name="Tabs" Grid.Row="1"
                 VerticalAlignment="Stretch"
                 TabWidthMode="SizeToContent"
                 IsAddTabButtonVisible="True"
                 AddTabButtonClick="Tabs_AddTabButtonClick"
                 TabCloseRequested="Tabs_TabCloseRequested"
                 SelectionChanged="Tabs_SelectionChanged">
            <!--
                The stock tab strip is built for touch and costs about 48px
                before a page is drawn. Overriding the theme resources rather
                than restyling the control keeps every visual state, and a
                document editor is looked at far more than its tabs are.
            -->
            <TabView.Resources>
                <!--
                    Declared HERE, as brush objects, and recoloured in place
                    when the theme changes. Assigning a NEW brush into this
                    dictionary at runtime does nothing: a ThemeResource is
                    resolved once, when the template expands, and the tab then
                    holds the brush object it found. That is why the tab kept
                    the colour of whichever theme was active at startup while
                    everything around it changed. Mutating .Color on the object
                    the tab is already holding reaches it.
                -->
                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="Transparent" />
                <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />

                <x:Double x:Key="TabViewItemMinHeight">30</x:Double>
                <x:Double x:Key="TabViewItemHeaderMinHeight">30</x:Double>
                <x:Double x:Key="TabViewItemHeaderFontSize">12</x:Double>
                <Thickness x:Key="TabViewItemHeaderPadding">10,0,10,0</Thickness>
                <Thickness x:Key="TabViewHeaderPadding">0</Thickness>
            </TabView.Resources>
        </TabView>
    </Grid>
</Window>
