<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PdfEditorApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PdfEditorApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Ayaan PDF"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The commands you reach for without thinking, in the strip of dead
            space above the tabs. The test for what belongs here is whether you
            would look for it: Save As, Flatten and Extract all fail that and
            stay in the menu.

            ONLY TitleDragArea is handed to SetTitleBar. Whatever that call
            receives becomes the drag region and its children stop receiving
            clicks, so a bar with buttons has to keep them in a separate column
            from the part you drag.
        -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <FontIcon Glyph="&#xE8A5;" FontSize="14" Margin="12,0,10,0" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="QuickOpen" Click="QuickOpen_Click" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Open (Ctrl+O)">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                </Button>
                <Button x:Name="QuickSave" Click="QuickSave_Click" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Save (Ctrl+S)">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                </Button>
                <Rectangle Width="1" Height="16" Margin="4,0"
                           Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Button x:Name="QuickUndo" Click="QuickUndo_Click" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                </Button>
                <Button x:Name="QuickRedo" Click="QuickRedo_Click" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Redo (Ctrl+Y)">
                    <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                </Button>
            </StackPanel>

            <!--
                The draggable remainder. The app name rather than the document's:
                the tabs below already say which file is which, and the taskbar
                gets the document name through Window.Title. Left-aligned with a
                margin so it cannot slide under the caption buttons.
            -->
            <Border x:Name="TitleDragArea" Grid.Column="2" Background="Transparent">
                <TextBlock x:Name="TitleText" Text="Ayaan PDF" Margin="8,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </Border>
        </Grid>

        <!--
            One tab per open document. Each tab's content is its own MainPage,
            and a MainPage owns a ViewportViewModel, so a document's handle,
            path, page slots, selection, history and groups are already
            per-page: tabs needed no change to the view model at all.
        -->
        <TabView x:Name="Tabs" Grid.Row="1"
                 TabWidthMode="SizeToContent"
                 IsAddTabButtonVisible="True"
                 AddTabButtonClick="Tabs_AddTabButtonClick"
                 TabCloseRequested="Tabs_TabCloseRequested"
                 SelectionChanged="Tabs_SelectionChanged" />
    </Grid>
</Window>
