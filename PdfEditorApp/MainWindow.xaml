<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PdfEditorApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PdfEditorApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Ayaan PDF"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8A5;" FontSize="14" Margin="12,0,8,0" />
            <!--
                Named and set from code rather than bound: the title bar lives
                in the Window and the document lives in the page inside the
                Frame, so there is no binding path between them.
            -->
            <TextBlock x:Name="TitleText" Grid.Column="1" Text="Ayaan PDF"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!--
            One tab per open document. Each tab's content is its own MainPage,
            and a MainPage owns a ViewportViewModel, so a document's handle,
            path, page slots, selection, history and groups are already
            per-page: tabs needed no change to the view model at all.
        -->
        <TabView x:Name="Tabs" Grid.Row="1"
                 TabWidthMode="SizeToContent"
                 IsAddTabButtonVisible="True"
                 AddTabButtonClick="Tabs_AddTabButtonClick"
                 TabCloseRequested="Tabs_TabCloseRequested"
                 SelectionChanged="Tabs_SelectionChanged" />
    </Grid>
</Window>
