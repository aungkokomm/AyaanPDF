<?xml version="1.0" encoding="utf-8"?>
<!--
    File > Merge files: many PDFs and pictures into one new PDF, which opens
    in a tab of its own. The files it was made from are never changed.

    A window rather than a dialog, like the page picker and the bookmark
    window: a list of thirty files, each with its pages and its buttons, does
    not fit in a ContentDialog's 548 pixels.
-->
<Window
    x:Class="PdfEditorApp.MergeFilesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:PdfEditorApp.ViewModels"
    Title="Merge files">

    <Grid x:Name="Root" AllowDrop="True" DragOver="Files_DragOver" Drop="Files_Drop" KeyDown="Root_KeyDown"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Adding and ordering. -->
        <Grid Padding="16,12,16,12" ColumnSpacing="8"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AddFilesButton" Content="Add files" Style="{StaticResource AccentButtonStyle}" Click="AddFiles_Click" />
                <Button x:Name="SortButton" Content="Sort by name" Click="SortByName_Click" />
            </StackPanel>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Or drop PDFs and pictures here"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Grid Grid.Row="1" Padding="20,6,32,6" ColumnSpacing="10"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="38" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="2" Text="File" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="3" Text="Pages" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Grid Grid.Row="2">
            <!--
                Dragged into order like the thumbnails are; the merge takes the
                files in the order the list shows. A file that needs attention
                is marked on its own row.
            -->
            <ListView x:Name="FileList" Padding="4,4,4,4" SelectionMode="None"
                      CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                      DragOver="Files_DragOver" Drop="Files_Drop"
                      AutomationProperties.Name="Files to merge">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:MergeItem">
                        <Grid Padding="0,6,0,6" ColumnSpacing="10" AutomationProperties.Name="{x:Bind Name}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE76F;" FontSize="14" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                            <Border Grid.Column="1" Width="36" Height="46" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Detail, Mode=OneWay}"
                                           Visibility="{x:Bind DetailVisibility, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Problem, Mode=OneWay}" TextWrapping="Wrap"
                                           Visibility="{x:Bind ProblemVisibility, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>

                            <TextBox Grid.Column="3" VerticalAlignment="Center"
                                     Text="{x:Bind PagesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{x:Bind CanChoosePages, Mode=OneWay}"
                                     AutomationProperties.Name="Pages to use"
                                     TextChanged="PagesBox_TextChanged" />

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="Choose pages" Click="ChoosePages_Click"
                                        Visibility="{x:Bind ChoosePagesVisibility, Mode=OneWay}" />
                                <Button Content="Unlock" Click="Unlock_Click"
                                        Visibility="{x:Bind UnlockVisibility, Mode=OneWay}" />
                                <Button AutomationProperties.Name="Move up" Click="MoveUp_Click">
                                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                </Button>
                                <Button AutomationProperties.Name="Move down" Click="MoveDown_Click">
                                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                </Button>
                                <Button AutomationProperties.Name="Remove" Click="Remove_Click">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="380" TextWrapping="Wrap" TextAlignment="Center" IsHitTestVisible="False"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Add files, or drop PDFs and pictures here. They're merged in the order listed, and you can drag them into a different order." />
        </Grid>

        <!-- What the merged file gets besides its pages. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="24" Padding="16,10,16,10"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <CheckBox x:Name="BookmarkEachFile" Content="Add a bookmark for each file" IsChecked="True" />
            <CheckBox x:Name="KeepBookmarks" Content="Keep each file's bookmarks" IsChecked="True" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Picture pages" VerticalAlignment="Center" />
                <ComboBox x:Name="PicturePageSize" MinWidth="170" SelectedIndex="0"
                          AutomationProperties.Name="Picture pages">
                    <ComboBoxItem Content="Picture's own size" />
                    <ComboBoxItem Content="Fit to A4" />
                    <ComboBoxItem Content="Fit to Letter" />
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="4" Padding="16,12,16,12" ColumnSpacing="10"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SummaryText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="AttentionText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>

            <StackPanel x:Name="ProgressPanel" Grid.Column="1" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                <TextBlock x:Name="ProgressText" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="MergeProgress" Width="200" VerticalAlignment="Center" />
                <Button Content="Stop" Click="StopMerge_Click" />
            </StackPanel>

            <Button x:Name="CloseButton" Grid.Column="2" Content="Cancel" Click="Close_Click" />
            <Button x:Name="MergeButton" Grid.Column="3" Content="Merge and save..."
                    Style="{StaticResource AccentButtonStyle}" Click="Merge_Click" />
        </Grid>
    </Grid>
</Window>
